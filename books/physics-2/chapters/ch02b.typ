$ "水" cases(m_1 = 250 "克", c_1 = 1 "卡/克·度", t_1 = 15 "°C" dou) $

$ "量热器" cases(m_2 = 100 "克", c_2 = 0.09 "卡/克·度", t_2 = t_1 = 15 "°C" dou) $

$ "煤块" cases(m_3 = 50 "克", c_3 = 0.25 "卡/克·度" dou) $

