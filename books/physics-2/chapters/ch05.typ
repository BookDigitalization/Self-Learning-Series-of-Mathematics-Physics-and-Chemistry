  stroke: none,
  inset: (x: 0.6em, y: 0.4em),
  table.hline(stroke: 1.2pt),
  [温　度（°C）], [0], [20], [35], [60], [75], [90], [100],
  table.hline(stroke: 0.6pt),
  table.vline(x: 1, stroke: 0.6pt),
  [表面张力系数（达因/厘米）], [75.34], [72.6], [70.24], [67.10], [64.26], [61.31], [59.25],
  table.hline(stroke: 1.2pt),
