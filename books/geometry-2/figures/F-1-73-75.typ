// 图 1·73（原书 p.101）、图 1·74（p.102，四幅）、图 1·75（p.103）；页面 120 dpi 坐标。
// 1·74 的四幅是作内接正方形的几种位似中心取法；点位按位似关系计算（G、F 在 AB、AC 上，正方形边长由位似比定）。
#import "F-base.typ": *

// 图 1·73 三角形 ABC 的内接正方形 DEFG（实线）与辅助正方形 D'E'F'G'（虚线），位似中心 B
#let fig-F-1-73(width: 380 * k) = px-canvas(380, 260, origin: (520, 405), width: width, (p, u) => {
  import cetz.draw: *
  let (B, C, A) = ((537, 640), (883, 640), (787, 420))
  // 内接正方形：G 在 AB 上，F 在 AC 上，GF ∥ BC
  let (G, F, D, E) = ((686, 508), (825, 508), (686, 640), (825, 640))
  let (G1, D1) = ((610, 574), (610, 640))
  let F1 = (676, 574)
  let E1 = (676, 640)
  poly(p, (B, C, A), close: true)
  poly(p, (G, F, E, D), close: true)
  dseg(p, B, F)
  dseg(p, G1, F1)
  dseg(p, F1, E1)
  dseg(p, G1, D1)
  dseg(p, D1, E1)
  lbl(p, A, $A$, dir: "n", d: 10)
  lbl(p, B, $B$, dir: "sw", d: 10)
  lbl(p, C, $C$, dir: "se", d: 10)
  lbl(p, G, $G$, dir: "nw", d: 10)
  lbl(p, F, $F$, dir: "ne", d: 10)
  lbl(p, E, $E$, dir: "s", d: 11)
  lbl(p, D, $D$, dir: "se", d: 10)
  lbl(p, G1, $G'$, dir: "nw", d: 10)
  lbl(p, F1, $F'$, dir: "nw", d: 10)
  lbl(p, D1, $D'$, dir: "s", d: 11)
  lbl(p, E1, $E'$, dir: "sw", d: 10)
})

// 图 1·74 四种取法（按原书排列：左上、右上、左下、右下）
#let fig-F-1-74(width: 800 * k) = px-canvas(800, 810, origin: (100, 490), width: width, (p, u) => {
  import cetz.draw: *
  // (a) 左上：辅助正方形 D'E'F'G' 在三角形内，位似中心 A
  {
    let (B, C, A) = ((118, 719), (386, 719), (285, 512))
    let G = lerp(B, A, (719 - 603) / (719 - 512))
    let F = lerp(C, A, (719 - 603) / (719 - 512))
    let D = (G.at(0), 719)
    let E = (F.at(0), 719)
    let t = 0.5
    let G1 = hom(A, t, G)
    let F1 = hom(A, t, F)
    let D1 = hom(A, t, D)
    let E1 = hom(A, t, E)
    poly(p, (B, C, A), close: true)
    poly(p, (G, F, E, D), close: true)
    dseg(p, A, D)
    dseg(p, A, E)
    dseg(p, G1, F1)
    dseg(p, D1, E1)
    dseg(p, G1, D1)
    dseg(p, F1, E1)
    lbl(p, A, $A$, dir: "n", d: 9)
    lbl(p, B, $B$, dir: "sw", d: 9)
    lbl(p, C, $C$, dir: "se", d: 9)
    lbl(p, G, $G$, dir: "nw", d: 9)
    lbl(p, F, $F$, dir: "ne", d: 9)
    lbl(p, D, $D$, dir: "s", d: 10)
    lbl(p, E, $E$, dir: "s", d: 10)
    lbl(p, G1, $G'$, dir: "nw", d: 9)
    lbl(p, F1, $F'$, dir: "ne", d: 9)
    lbl(p, D1, $D'$, dir: "s", d: 10)
    lbl(p, E1, $E'$, dir: "s", d: 10)
  }
  // (b) 右上：G'F'E'D' 的顶点 G' 与 A 重合，D' 在 BC 上
  {
    let (B, C, A) = ((437, 720), (700, 720), (599, 512))
    let G = lerp(B, A, (720 - 602) / (720 - 512))
    let F = lerp(C, A, (720 - 602) / (720 - 512))
    let D = (G.at(0), 720)
    let E = (F.at(0), 720)
    let D1 = (599, 720)
    let E1 = (800, 720)
    let F1 = (800, 512)
    poly(p, (B, C, A), close: true)
    poly(p, (G, F, E, D), close: true)
    dseg(p, A, D1)
    dseg(p, A, F1)
    dseg(p, F1, E1)
    dseg(p, C, E1)
    dseg(p, B, F1)
    lbl(p, A, $A$, dir: "n", d: 9)
    lbl(p, B, $B$, dir: "s", d: 10)
    lbl(p, C, $C$, dir: "s", d: 10)
    lbl(p, G, $G$, dir: "nw", d: 9)
    lbl(p, F, $F$, dir: "ne", d: 9)
    lbl(p, D, $D$, dir: "s", d: 10)
    lbl(p, E, $E$, dir: "s", d: 10)
    lbl(p, D1, $D'$, dir: "s", d: 10)
    lbl(p, E1, $E'$, dir: "s", d: 10)
    lbl(p, F1, $F'$, dir: "ne", d: 9)
  }
  // (c) 左下：G' 与 B、F' 与 C 重合，D'E' 在 BC 的另一侧；位似中心 A
  {
    let (B, C, A) = ((137, 983), (405, 983), (305, 780))
    let G = lerp(B, A, (983 - 865) / (983 - 780))
    let F = lerp(C, A, (983 - 865) / (983 - 780))
    let D = (G.at(0), 983)
    let E = (F.at(0), 983)
    let D1 = (137, 1257)
    let E1 = (405, 1257)
    poly(p, (B, C, A), close: true)
    poly(p, (G, F, E, D), close: true)
    dseg(p, B, D1)
    dseg(p, C, E1)
    dseg(p, D1, E1)
    dseg(p, A, D1)
    dseg(p, A, E1)
    lbl(p, A, $A$, dir: "n", d: 9)
    lbl(p, B, $B$, dir: "nw", d: 10)
    lbl(p, C, $C$, dir: "ne", d: 10)
    lbl(p, G, $G$, dir: "nw", d: 9)
    lbl(p, F, $F$, dir: "ne", d: 9)
    lbl(p, D, $D$, dir: "s", d: 10)
    lbl(p, E, $E$, dir: "s", d: 10)
    lbl(p, D1, $D'$, dir: "s", d: 10)
    lbl(p, E1, $E'$, dir: "s", d: 10)
  }
  // (d) 右下：位似中心 D'（在 BC 上、A 的正下方），G'F' 在 BC 的另一侧
  {
    let (B, C, A) = ((517, 1208), (785, 1208), (685, 1008))
    let Dp = (685, 1208)
    let G1 = (517, 940)
    let F1 = (785, 940)
    // 正方形 GFED：G 在 D'G' 与 AB 的交点
    let G = isect(Dp, G1, B, A)
    let F = isect(Dp, F1, C, A)
    let D = (G.at(0), 1208)
    let E = (F.at(0), 1208)
    poly(p, (B, C, A), close: true)
    poly(p, (G, F, E, D), close: true)
    dseg(p, A, Dp)
    dseg(p, G1, F1)
    dseg(p, B, G1)
    dseg(p, C, F1)
    dseg(p, Dp, G1)
    dseg(p, Dp, F1)
    lbl(p, A, $A$, dir: "n", d: 9)
    lbl(p, B, $B$, dir: "sw", d: 10)
    lbl(p, C, $C$, dir: "se", d: 10)
    lbl(p, G, $G$, dir: "w", d: 10)
    lbl(p, F, $F$, dir: "e", d: 10)
    lbl(p, D, $D$, dir: "s", d: 10)
    lbl(p, E, $E$, dir: "s", d: 10)
    lbl(p, Dp, $D'$, dir: "s", d: 12)
    lbl(p, G1, $G'$, dir: "nw", d: 10)
    lbl(p, F1, $F'$, dir: "ne", d: 10)
  }
})

// 图 1·75 例 2：BC:CA:AB = 4:5:7，B'C' 边上的中线 AM' 按位似比放大成 BC 边上的中线 AM
#let fig-F-1-75(width: 400 * k) = px-canvas(400, 400, origin: (535, 705), width: width, (p, u) => {
  import cetz.draw: *
  let (B, C, A) = ((549, 1063), (812, 1063), (880, 730))
  let B1 = isect(B, A, (500, 967), (900, 967))
  let C1 = isect(C, A, (500, 967), (900, 967))
  let M = lerp(B, C, 0.5)
  let M1 = lerp(B1, C1, 0.5)
  poly(p, (B, C, A), close: true)
  dseg(p, B1, C1)
  dseg(p, A, M)
  lbl(p, A, $A$, dir: "n", d: 10)
  lbl(p, B, $B$, dir: "s", d: 11)
  lbl(p, C, $C$, dir: "se", d: 11)
  lbl(p, M, $M$, dir: "s", d: 11)
  lbl(p, B1, $B'$, dir: "nw", d: 11)
  lbl(p, C1, $C'$, dir: "e", d: 11)
  lbl(p, M1, $M'$, dir: "se", d: 12)
})
