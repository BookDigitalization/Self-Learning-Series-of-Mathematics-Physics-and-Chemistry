// 图 5·21（原书 p.296）、图 5·22、5·23（p.297）、图 5·24（p.298）。页面 120 dpi 坐标。
#import "P-base.typ": *

// 图 5·21：弓形 AmB 的三种情形：(1) 小于半圆；(2) 大于半圆；(3) 等于半圆
#let fig-P-5-21(width: 700 * k) = px-canvas(700, 280, origin: (130, 445), width: width, (p, u) => {
  import cetz.draw: *
  let r = 108
  // (1)
  let O1 = (249, 557)
  let A1 = P-pt(O1, r, 227)
  let B1 = P-pt(O1, r, 313)
  circ(p, O1, r, stroke: lt)
  P-arc(p, O1, r, 227, 313, stroke: lb)
  seg(p, A1, B1, stroke: lb)
  seg(p, O1, A1, stroke: dsh)
  seg(p, O1, B1, stroke: dsh)
  lbl(p, O1, $O$, dir: "n", d: 11)
  lbl(p, A1, $A$, dir: "w", d: 11)
  lbl(p, B1, $B$, dir: "e", d: 11)
  lbl(p, (250, 680), $m$, dir: "c", d: 0)
  lbl(p, (257, 708), $(1)$, dir: "c", d: 0)
  // (2)
  let O2 = (480, 558)
  let A2 = P-pt(O2, r, 137)
  let B2 = P-pt(O2, r, 42)
  circ(p, O2, r, stroke: lt)
  P-arc(p, O2, r, 137, 42 + 360, stroke: lb)
  seg(p, A2, B2, stroke: lb)
  seg(p, O2, A2, stroke: dsh)
  seg(p, O2, B2, stroke: dsh)
  lbl(p, O2, $O$, dir: "s", d: 11)
  lbl(p, A2, $A$, dir: "nw", d: 10)
  lbl(p, B2, $B$, dir: "ne", d: 10)
  lbl(p, (480, 672), $m$, dir: "c", d: 0)
  lbl(p, (481, 708), $(2)$, dir: "c", d: 0)
  // (3)
  let O3 = (728, 556)
  let A3 = (O3.at(0) - r, O3.at(1))
  let B3 = (O3.at(0) + r, O3.at(1))
  circ(p, O3, r, stroke: lt)
  P-arc(p, O3, r, 180, 360, stroke: lb)
  seg(p, A3, B3, stroke: lb)
  ring(p, O3, r: 2.5)
  lbl(p, O3, $O$, dir: "s", d: 11)
  lbl(p, A3, $A$, dir: "w", d: 11)
  lbl(p, B3, $B$, dir: "e", d: 11)
  lbl(p, (728, 676), $m$, dir: "c", d: 0)
  lbl(p, (725, 708), $(3)$, dir: "c", d: 0)
})

// 图 5·22：弧含 60° 的弓形 AmB，弦 AB = a
#let fig-P-5-22(width: 250 * k) = px-canvas(250, 280, origin: (205, 185), width: width, (p, u) => {
  import cetz.draw: *
  let O = (330, 300)
  let r = 108
  let A = P-pt(O, r, 240)
  let B = P-pt(O, r, 300)
  circ(p, O, r, stroke: lt)
  P-arc(p, O, r, 240, 300, stroke: lb)
  seg(p, A, B, stroke: lb)
  seg(p, O, A, stroke: dsh)
  seg(p, O, B, stroke: dsh)
  P-arc(p, O, 22, 240, 300, stroke: lt)
  P-lbw(p, (330, 340), $60°$)
  P-darc(p, O, r + 26, 240, 300, gap: 8, lab: $60°$)
  lbl(p, O, $O$, dir: "n", d: 12)
  lbl(p, A, $A$, dir: "w", d: 11)
  lbl(p, B, $B$, dir: "e", d: 11)
  lbl(p, (330, 380), $a$, dir: "c", d: 0)
  lbl(p, (310, 419), $m$, dir: "c", d: 0)
})

// 图 5·23：弧含 240° 的弓形 AmB，弦 AB = a，OC ⊥ AB
#let fig-P-5-23(width: 290 * k) = px-canvas(290, 270, origin: (565, 190), width: width, (p, u) => {
  import cetz.draw: *
  let O = (708, 300)
  let r = 110
  let A = P-pt(O, r, 150)
  let B = P-pt(O, r, 30)
  let C = (708, A.at(1))
  circ(p, O, r, stroke: lt)
  P-arc(p, O, r, 150, 30 + 360, stroke: lb)
  seg(p, A, B, stroke: lb)
  seg(p, O, A, stroke: dsh)
  seg(p, O, B, stroke: dsh)
  seg(p, O, C, stroke: (paint: black, thickness: 0.6pt, dash: "dash-dotted"))
  P-arc(p, O, 22, 30, 150, stroke: lt)
  P-darc(p, O, r + 16, 150, 30 + 360, gap: 9, mid: 270, lab: $240°$)
  lbl(p, (741, 293), $120°$, dir: "c", d: 0)
  lbl(p, O, $O$, dir: "s", d: 12)
  lbl(p, A, $A$, dir: "nw", d: 9)
  lbl(p, B, $B$, dir: "ne", d: 9)
  lbl(p, C, $C$, dir: "n", d: 11)
  lbl(p, (718, 262), $a$, dir: "c", d: 0)
  lbl(p, (708, 392), $m$, dir: "c", d: 0)
})

// 图 5·24：直径 AB ⊥ 直径 CD，以 C 为圆心、CA 为半径作 AEB；月牙形 ADBE（阴影）
#let fig-P-5-24(width: 300 * k) = px-canvas(300, 300, origin: (527, 400), width: width, (p, u) => {
  import cetz.draw: *
  let O = (677, 550)
  let r = 125
  let A = (O.at(0) - r, O.at(1))
  let B = (O.at(0) + r, O.at(1))
  let D = (O.at(0), O.at(1) - r)
  let C = (O.at(0), O.at(1) + r)
  let R2 = r * calc.sqrt(2)
  let E = (C.at(0), C.at(1) - R2)
  // 阴影：大圆上半 A→D→B，再沿以 C 为心的弧 B→E→A
  let loop = P-arcpts(O, r, 180, 0, n: 60) + P-arcpts(C, R2, 45, 135, n: 40)
  P-hatch(p, (loop,), ang: 90, gap: 5)
  circ(p, O, r, stroke: lt)
  P-arc(p, O, r, 0, 180, stroke: lb)
  P-arc(p, C, R2, 45, 135, stroke: lb)
  seg(p, A, B, stroke: lb)
  seg(p, A, D, stroke: lb)
  seg(p, D, B, stroke: lb)
  seg(p, D, C, stroke: lb)
  seg(p, C, A, stroke: dsh)
  seg(p, C, B, stroke: dsh)
  P-arc(p, C, 34, 45, 135, stroke: lt)
  lbl(p, (677, 643), $90°$, dir: "c", d: 0)
  lbl(p, D, $D$, dir: "n", d: 10)
  lbl(p, C, $C$, dir: "s", d: 11)
  lbl(p, A, $A$, dir: "w", d: 10)
  lbl(p, B, $B$, dir: "e", d: 10)
  lbl(p, O, $O$, dir: "se", d: 11)
  lbl(p, E, $E$, dir: "se", d: 11)
})

