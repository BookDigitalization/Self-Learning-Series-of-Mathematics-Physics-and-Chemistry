// 图 5·6（原书 p.273）、图 5·7（p.274）、图 5·8（p.276）；页面 120 dpi 坐标。
#import "O-base.typ": *

// 图 5·6 滑轮与绳子：∠BOD = 150°，绳 AB、DE 成 30° 角（按题设算出，左右对称）
#let fig-O-5-6(width: 230 * k) = px-canvas(230, 410, origin: (640, 840), width: width, (p, u) => {
  import cetz.draw: *
  let O = (755, 975)
  let r = 64
  let B = O-pt(O, r, 195)
  let D = O-pt(O, r, 345)
  let A = (B.at(0) - 0.259 * 125, B.at(1) - 0.966 * 125)
  let E = (D.at(0) + 0.259 * 125, D.at(1) - 0.966 * 125)
  let F = (755, 1222)
  O-circ(p, O, r)
  O-arc(p, O, r, 195, 345, st: lb)
  O-ln(p, A, B, st: lb)
  O-ln(p, D, E, st: lb)
  dseg(p, B, F)
  dseg(p, D, F)
  O-ln(p, O, B)
  O-ln(p, O, D)
  ring(p, O, r: 2.5)
  anglearc(p, F, B, D, 38)
  lbl(p, A, $A$, dir: "nw", d: 12)
  lbl(p, E, $E$, dir: "ne", d: 12)
  lbl(p, B, $B$, dir: "w", d: 12)
  lbl(p, D, $D$, dir: "e", d: 12)
  lbl(p, (755, 1038), $C$, dir: "s", d: 12)
  lbl(p, O, $O$, dir: "n", d: 11)
  lbl(p, (723, 975), $R$, dir: "c", d: 0)
  lbl(p, (788, 975), $R$, dir: "c", d: 0)
  lbl(p, (755, 990), $150°$, dir: "c", d: 0)
  lbl(p, (756, 1165), $30°$, dir: "c", d: 0)
  lbl(p, F, $F$, dir: "s", d: 12)
})

// 图 5·7 皮带：小轮 O（半径 1）、大轮 O'（半径 5），圆心距 8
#let fig-O-5-7(width: 630 * k) = px-canvas(630, 380, origin: (180, 865), width: width, (p, u) => {
  import cetz.draw: *
  let r = 37
  let R = 185
  let O = (278, 1055)
  let O2 = (574, 1055)
  let A = O-pt(O, r, 120)
  let A2 = O-pt(O, r, 240)
  let B = O-pt(O2, R, 120)
  let B2 = O-pt(O2, R, 240)
  let E = O-pt(O2, R - r, 120)
  let C = (O.at(0) - r, 1055)
  let D = (O2.at(0) + R, 1055)
  // 轮廓
  O-arc(p, O, r, 120, 240, st: lb)
  O-arc(p, O, r, -120, 120)
  O-arc(p, O2, R, -120, 120, st: lb)
  O-arc(p, O2, R, 120, 240)
  O-ln(p, A, B, st: lb)
  O-ln(p, A2, B2, st: lb)
  // 虚线
  dseg(p, (190, 1055), (800, 1055))
  dseg(p, O, A)
  dseg(p, O2, B)
  dseg(p, O, E)
  pdot(p, (800, 1055), r: 2.2)
  rtmark(p, A, O, B, s: 6)
  rtmark(p, B, O2, A, s: 6)
  rtmark(p, E, O, B, s: 6)
  rtmark(p, O, A, E, s: 6)
  anglearc(p, O, C, A, 16)
  anglearc(p, O2, E, O, 40)
  anglearc(p, O2, D, B, 28)
  ring(p, O2, r: 2.5)
  lbl(p, (259, 1046), $60°$, dir: "c", d: 0)
  lbl(p, (545, 1043), $60°$, dir: "c", d: 0)
  lbl(p, (590, 1040), $120°$, dir: "c", d: 0)
  lbl(p, A, $A$, dir: "nw", d: 11)
  lbl(p, A2, $A'$, dir: "sw", d: 12)
  lbl(p, B, $B$, dir: "nw", d: 11)
  lbl(p, B2, $B'$, dir: "sw", d: 14)
  lbl(p, E, $E$, dir: "e", d: 10)
  lbl(p, C, $C$, dir: "nw", d: 12)
  lbl(p, D, $D$, dir: "ne", d: 12)
  lbl(p, O, $O$, dir: "s", d: 13)
  lbl(p, O2, $O'$, dir: "s", d: 13)
})

// 图 5·8 两圆相交：半径都是 R，OO' = √3 R（按题设算出）
#let fig-O-5-8(width: 430 * k) = px-canvas(430, 225, origin: (275, 165), width: width, (p, u) => {
  import cetz.draw: *
  let R = 102
  let O = (406, 275)
  let O2 = (582.7, 275)
  let xm = (O.at(0) + O2.at(0)) / 2
  let B = (xm, 275 - R / 2)
  let A = (xm, 275 + R / 2)
  let C = (xm, 275)
  let dthick = (paint: black, thickness: 1.3pt, dash: "dashed")
  O-arc(p, O, R, 30, 330, st: lb)
  O-arc(p, O2, R, -150, 150, st: lb)
  O-arc(p, O, R, -30, 30, st: dthick)
  O-arc(p, O2, R, 150, 210, st: dthick)
  dseg(p, A, B)
  dseg(p, O, B)
  dseg(p, O, A)
  dseg(p, O2, B)
  dseg(p, O2, A)
  dseg(p, O, O2)
  O-arc(p, O, 28, 30, 330, st: lt)
  anglearc(p, O, O2, B, 36)
  O-ln(p, (434, 293), (449, 276), st: lt)
  lbl(p, B, $B$, dir: "n", d: 11)
  lbl(p, A, $A$, dir: "s", d: 12)
  lbl(p, (286, 272), $M$, dir: "c", d: 0)
  lbl(p, (691, 280), $N$, dir: "c", d: 0)
  lbl(p, O, $O$, dir: "sw", d: 12)
  lbl(p, O2, $O'$, dir: "se", d: 11)
  lbl(p, C, $C$, dir: "se", d: 10)
  lbl(p, (445, 242), $R$, dir: "c", d: 0)
  lbl(p, (458, 262), $30°$, dir: "c", d: 0)
  lbl(p, (366, 270), $300°$, dir: "c", d: 0)
  lbl(p, (422, 322), $display(sqrt(3) / 2) R$, dir: "c", d: 0)
})
