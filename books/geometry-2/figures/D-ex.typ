// 习题 1·7、1·8 里无编号的插图（原书 p.65 第 10、12 题；p.66 第 15、18、19 题；p.71 第 4 题；p.72 第 7、8 题；p.73 第 9 题；p.74 第 10 题）；页面 120 dpi 坐标。
// 树、人为写实插画，用扫描裁剪的二值化 PNG（D-tree7.png、D-man7.png：p.72 第 7 题；D-tree8.png：p.72 第 8 题）。
#import "D-base.typ": *

// 习题 1·7 第 10 题：A 引圆的切线 AB、AC，P 为圆上一点，PD ⊥ BC，PE ⊥ AB，PF ⊥ AC
#let fig-D-ex17-10(width: 350 * k) = px-canvas(350, 200, origin: (170, 465), width: width, (p, u) => {
  import cetz.draw: *
  let O = (420, 567)
  let r = 81
  let A = (193, 581)
  let th = calc.atan2(A.at(0) - O.at(0), -(A.at(1) - O.at(1)))
  let phi = calc.acos(r / calc.sqrt(calc.pow(A.at(0) - O.at(0), 2) + calc.pow(A.at(1) - O.at(1), 2)))
  let B = cpt(O, r, (th - phi).deg())
  let C = cpt(O, r, (th + phi).deg())
  let P = cpt(O, r, 173.3)
  let D = foot(P, B, C)
  let E = foot(P, A, B)
  let F = foot(P, A, C)
  circ(p, O, r)
  seg(p, A, B)
  seg(p, A, C)
  seg(p, B, C)
  seg(p, P, D)
  seg(p, P, E)
  seg(p, P, F)
  dseg(p, P, B)
  dseg(p, P, C)
  rtmark(p, D, P, B, s: 7)
  rtmark(p, E, P, A, s: 7)
  rtmark(p, F, P, A, s: 7)
  lbl(p, A, $A$, dir: "w", d: 11)
  lbl(p, B, $B$, dir: "ne", d: 10)
  lbl(p, C, $C$, dir: "se", d: 10)
  lbl(p, P, $P$, dir: "w", d: 10)
  lbl(p, D, $D$, dir: "e", d: 10)
  lbl(p, E, $E$, dir: "nw", d: 10)
  lbl(p, F, $F$, dir: "sw", d: 10)
})

