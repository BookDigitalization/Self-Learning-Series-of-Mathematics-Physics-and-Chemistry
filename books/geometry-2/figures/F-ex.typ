// 习题 1·14 第 3 题：已知两角 α、β 和外接圆半径 R，作三角形（左为已知，右为作图）
#let fig-F-ex114-3(width: 510 * k) = px-canvas(510, 285, origin: (290, 165), width: width, (p, u) => {
  import cetz.draw: *
  // 已知角 α、β 和线段 R
  line(p(385, 185), p(302, 270), p(427, 276), stroke: lw)
  line(p(342, 295), p(305, 390), p(424, 396), stroke: lw)
  anglearc(p, (302, 270), (385, 185), (427, 276), 28)
  anglearc(p, (305, 390), (342, 295), (424, 396), 28)
  lbl(p, (333, 262), $α$, dir: "c", d: 0)
  lbl(p, (326, 376), $β$, dir: "c", d: 0)
  pseg(p, (302, 432), (407, 435))
  lbl(p, (354, 420), $R$, dir: "n", d: 4)
  // 作图：圆 O（半径 R）内接三角形，及与它位似（中心 O）的大三角形
  let O = (635, 329)
  let rr = 112
  let P1 = cpt(O, rr, 70)
  let P2 = cpt(O, rr, 210)
  let P3 = cpt(O, rr, 330)
  let (Q1, Q2, Q3) = (P1, P2, P3).map(t => hom(O, 1.39, t))
  circ(p, O, rr)
  poly(p, (P1, P2, P3), close: true)
  poly(p, (Q1, Q2, Q3), close: true)
  dseg(p, O, P1)
  dseg(p, O, P2)
  dseg(p, O, P3)
  dray(p, Q2, Q1, -0.1, 0)
  dray(p, Q3, Q1, -0.1, 0)
  dray(p, Q2, Q3, -0.12, 0)
  dray(p, Q2, Q3, 1, 1.1)
  dray(p, Q1, Q2, 1, 1.12)
  dray(p, Q1, Q3, 1, 1.05)
  anglearc(p, P2, P3, O, 28)
  anglearc(p, P3, P2, O, 28)
  lbl(p, (575, 365), $α$, dir: "c", d: 0)
  lbl(p, (698, 360), $β$, dir: "c", d: 0)
  lbl(p, lerp(O, P1, 0.5), $R$, dir: "e", d: 8)
  circle(p(..O), radius: 2, fill: white, stroke: lt)
  lbl(p, O, $O$, dir: "s", d: 9)
})

