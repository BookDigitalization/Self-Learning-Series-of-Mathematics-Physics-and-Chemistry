// 复习题一第 14 题：在直角三角形 ABC 的二直角边上向外作正方形 ABDE、ACFG
#let fig-F-rv14(width: 540 * k) = px-canvas(540, 325, origin: (250, 330), width: width, (p, u) => {
  import cetz.draw: *
  let A = (552, 500)
  let B = (402, 620)
  let C = (640, 610)
  // 正方形 ABDE：E = A + AB 转 90°，D = B + (E − A)；ACFG 同理
  let ab = (B.at(0) - A.at(0), B.at(1) - A.at(1))
  let ac = (C.at(0) - A.at(0), C.at(1) - A.at(1))
  let E = (A.at(0) - ab.at(1), A.at(1) + ab.at(0))
  let D = (B.at(0) - ab.at(1), B.at(1) + ab.at(0))
  let G = (A.at(0) + ac.at(1), A.at(1) - ac.at(0))
  let F = (C.at(0) + ac.at(1), C.at(1) - ac.at(0))
  let K = isect(D, C, A, B)
  let L = isect(B, F, A, C)
  bpoly(p, (A, B, D, E), close: true)
  bpoly(p, (A, C, F, G), close: true)
  seg(p, D, C)
  seg(p, B, F)
  lbl(p, E, $E$, dir: "n", d: 10)
  lbl(p, D, $D$, dir: "w", d: 10)
  lbl(p, A, $A$, dir: "ne", d: 14)
  lbl(p, G, $G$, dir: "n", d: 10)
  lbl(p, F, $F$, dir: "e", d: 10)
  lbl(p, B, $B$, dir: "s", d: 11)
  lbl(p, C, $C$, dir: "s", d: 11)
  lbl(p, K, $K$, dir: "ne", d: 10)
  lbl(p, L, $L$, dir: "ne", d: 10)
})

