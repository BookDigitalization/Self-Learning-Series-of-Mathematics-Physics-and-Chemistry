// 图 1·29 例 2（边长 a、b、c 用尺寸线标出）
#let fig-C-1-29(width: 375 * k) = px-canvas(375, 265, origin: (515, 665), width: width, (p, u) => {
  import cetz.draw: *
  let A = (545, 893)
  let B = (845, 893)
  let C = (745, 695)
  let (a, b, c) = (C-dist(B, C), C-dist(C, A), C-dist(A, B))
  // 三条角平分线的垂足：AD 平分 ∠A、BE 平分 ∠B、CF 平分 ∠C；I 为内心
  let D = C-lerp(B, C, c / (b + c))
  let E = C-lerp(A, C, c / (a + c))
  let F = C-lerp(A, B, b / (a + b))
  let I = C-isect(A, D, B, E)
  seg(p, A, B)
  seg(p, A, C)
  seg(p, B, C)
  seg(p, A, D)
  seg(p, B, E)
  seg(p, C, F)
  anglearc(p, A, B, D, 30)
  C-dim(p, (525, 866), (734, 681), $b$)
  C-dim(p, (768, 688), (870, 877), $a$)
  C-dim(p, (540, 908), (850, 908), $c$)
  lbl(p, A, $A$, dir: "w", d: 11)
  lbl(p, B, $B$, dir: "e", d: 11)
  lbl(p, C, $C$, dir: "n", d: 11)
  lbl(p, D, $D$, dir: "nw", d: 12)
  lbl(p, E, $E$, dir: "ne", d: 11)
  lbl(p, F, $F$, dir: "ne", d: 12)
  lbl(p, I, $I$, dir: "nw", d: 10)
})

// 图 1·30 例 3（AF = AC 用等长记号标出）
#let fig-C-1-30(width: 510 * k) = px-canvas(510, 225, origin: (230, 515), width: width, (p, u) => {
  import cetz.draw: *
  let A = (395, 592)
  let B = (247, 710)
  let C = (411, 714)
  let D = (712, 715)
  let E = (A.at(0) + (A.at(0) - B.at(0)) * 0.5, A.at(1) + (A.at(1) - B.at(1)) * 0.5)
  let F = C-isect(A, B, C, (C.at(0) + A.at(0) - D.at(0), C.at(1) + A.at(1) - D.at(1)))
  seg(p, B, A)
  seg(p, A, C)
  seg(p, A, D)
  seg(p, B, C)
  dseg(p, C, D)
  dseg(p, A, E)
  dseg(p, F, C)
  ticks(p, A, F, 2)
  ticks(p, A, C, 2)
  anglearc(p, A, E, D, 24)
  anglearc(p, A, C, D, 34)
  anglearc(p, F, A, C, 22)
  anglearc(p, C, A, F, 22)
  lbl(p, A, $A$, dir: "nw", d: 11)
  lbl(p, B, $B$, dir: "sw", d: 10)
  lbl(p, C, $C$, dir: "s", d: 12)
  lbl(p, D, $D$, dir: "s", d: 12)
  lbl(p, E, $E$, dir: "ne", d: 9)
  lbl(p, F, $F$, dir: "nw", d: 10)
})
