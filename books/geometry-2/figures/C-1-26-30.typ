// 图 1·26（原书 p.38）、1·27（p.39）、1·28（p.40）、1·29（p.41）、1·30（p.42）；页面 120 dpi 坐标。
// 1·26、1·27、1·30 按已知条件（角平分线、平行）重算了辅助点位置，原图手绘略有歪斜。
#import "C-base.typ": *

// 图 1·26 内角平分线定理
#let fig-C-1-26(width: 350 * k) = px-canvas(350, 255, origin: (470, 550), width: width, (p, u) => {
  import cetz.draw: *
  let A = (677, 647)
  let B = (490, 776)
  let C = (730, 772)
  let D = C-lerp(B, C, C-dist(A, B) / (C-dist(A, B) + C-dist(A, C)))
  let E = C-isect(B, A, C, (C.at(0) + A.at(0) - D.at(0), C.at(1) + A.at(1) - D.at(1)))
  seg(p, B, A)
  seg(p, A, C)
  seg(p, B, C)
  seg(p, A, D)
  dseg(p, A, E)
  dseg(p, C, E)
  anglearc(p, A, B, D, 22)
  anglearc(p, A, D, C, 22)
  anglearc(p, E, A, C, 20)
  anglearc(p, C, A, E, 24)
  lbl(p, A, $A$, dir: "n", d: 12)
  lbl(p, B, $B$, dir: "sw", d: 9)
  lbl(p, C, $C$, dir: "s", d: 12)
  lbl(p, D, $D$, dir: "s", d: 12)
  lbl(p, E, $E$, dir: "n", d: 10)
  content(p(660, 674), tsm($1$))
  content(p(680, 681), tsm($2$))
  content(p(766, 593), tsm($1'$))
  content(p(730, 740), tsm($2'$))
})

// 图 1·27 外角平分线定理（图中 E 在 BA 延长线上，又一点 E 在 AB 上，原图两处都标 E）
#let fig-C-1-27(width: 520 * k) = px-canvas(520, 255, origin: (300, 645), width: width, (p, u) => {
  import cetz.draw: *
  let A = (460, 752)
  let B = (317, 874)
  let C = (480, 875)
  let D = (775, 875)
  let Eo = (578, 663)   // BA 延长线上的 E
  let Ei = C-isect(A, B, C, (C.at(0) + D.at(0) - A.at(0), C.at(1) + D.at(1) - A.at(1)))
  seg(p, B, A)
  seg(p, A, C)
  seg(p, A, D)
  seg(p, B, C)
  dseg(p, C, D)
  dseg(p, D, (802, 875))
  dseg(p, A, Eo)
  dseg(p, Ei, C)
  anglearc(p, A, Eo, D, 22)
  anglearc(p, A, D, C, 22)
  anglearc(p, Ei, A, C, 20)
  anglearc(p, C, A, Ei, 22)
  lbl(p, A, $A$, dir: "nw", d: 10)
  lbl(p, B, $B$, dir: "s", d: 12)
  lbl(p, C, $C$, dir: "s", d: 12)
  lbl(p, D, $D$, dir: "s", d: 12)
  lbl(p, Eo, $E$, dir: "ne", d: 8)
  lbl(p, Ei, $E$, dir: "nw", d: 11)
  content(p(496, 748), tsm($2$))
  content(p(484, 778), tsm($1$))
  content(p(400, 824), tsm($2'$))
  content(p(459, 847), tsm($1'$))
})

