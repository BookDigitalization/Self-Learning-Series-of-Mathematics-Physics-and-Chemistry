// 图 1·21（原书 p.32）、图 1·22、1·23（p.33）、图 1·24（p.34）、图 1·25（p.35）；页面 120 dpi 坐标。
#import "B-base.typ": *

// 文字底下垫白底（让线从文字后穿过时不压字）
#let B-white(p, c, w: 13, h: 13) = {
  import cetz.draw: *
  rect(p(c.at(0) - w / 2, c.at(1) - h / 2), p(c.at(0) + w / 2, c.at(1) + h / 2), fill: white, stroke: none)
}

// 图 1·21 作图题 1：求作 a : b = c : x
#let fig-B-1-21(width: 400 * k) = px-canvas(400, 320, origin: (285, 445), width: width, (p, u) => {
  import cetz.draw: *
  B-bar(p, 312, 529, 465, $a$)
  B-bar(p, 314, 434, 500, $b$)
  B-bar(p, 315, 490, 533, $c$)
  let O = (301, 737)
  let A = (652, 525)
  let C = B-lerp(O, A, 0.524)
  let E = B-lerp(O, A, 0.823)
  let D = (477, 737)
  let F = (579, 737)
  dseg(p, O, A)
  dseg(p, O, D)
  dseg(p, F, (668, 737))
  line(p(..D), p(..F), stroke: lb)
  dseg(p, C, D)
  dseg(p, E, F)
  lbl(p, O, $O$, dir: "w", d: 11)
  lbl(p, A, $A$, dir: "ne", d: 11)
  lbl(p, C, $C$, dir: "nw", d: 11)
  lbl(p, E, $E$, dir: "nw", d: 11)
  lbl(p, D, $D$, dir: "s", d: 12)
  lbl(p, F, $F$, dir: "s", d: 12)
  lbl(p, (674, 737), $B$, dir: "c", d: 0)
  lbl(p, (387, 677), tsm($a$), dir: "c", d: 0)
  lbl(p, (530, 589), tsm($b$), dir: "c", d: 0)
  lbl(p, (394, 749), tsm($c$), dir: "c", d: 0)
  lbl(p, (530, 748), tsm($x$), dir: "c", d: 0)
})

// 图 1·22 例 1：x = 3ab/(2c)，作 2c : 3a = b : x
#let fig-B-1-22(width: 560 * k) = px-canvas(560, 265, origin: (255, 205), width: width, (p, u) => {
  import cetz.draw: *
  B-bar(p, 262, 330, 231, $a$)
  B-bar(p, 264, 404, 264, $b$)
  B-bar(p, 265, 319, 297, $c$)
  let O = (302, 439)
  let A = (644, 221)
  let E = (446, 439)
  let F = (705, 439)
  let at(t) = B-lerp(O, A, t)
  let C = at(0.284)
  let D = at(0.769)
  dseg(p, O, A)
  dseg(p, O, E)
  seg(p, E, F)
  dseg(p, F, (795, 439))
  dseg(p, C, E)
  dseg(p, D, F)
  for t in (0.142, 0.284, 0.4457, 0.6073) {
    tickat(p, O, A, at(t), s: 4)
  }
  lbl(p, O, $O$, dir: "w", d: 11)
  lbl(p, C, $C$, dir: "nw", d: 11)
  lbl(p, D, $D$, dir: "nw", d: 11)
  lbl(p, (640, 212), $A$, dir: "c", d: 0)
  lbl(p, E, $E$, dir: "se", d: 11)
  lbl(p, F, $F$, dir: "s", d: 12)
  lbl(p, (801, 439), $B$, dir: "c", d: 0)
  lbl(p, (326, 417), tsm($c$), dir: "c", d: 0)
  lbl(p, (367, 389), tsm($c$), dir: "c", d: 0)
  lbl(p, (422, 352), tsm($a$), dir: "c", d: 0)
  lbl(p, (471, 321), tsm($a$), dir: "c", d: 0)
  lbl(p, (526, 283), tsm($a$), dir: "c", d: 0)
  lbl(p, (380, 450), tsm($b$), dir: "c", d: 0)
  lbl(p, (574, 450), tsm($x$), dir: "c", d: 0)
})

