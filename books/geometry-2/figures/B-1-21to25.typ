// 图 1·24 作图题 3：在 AB 的延长线上求 P，AP : PB = m : n
#let fig-B-1-24(width: 420 * k) = px-canvas(420, 335, origin: (430, 925), width: width, (p, u) => {
  import cetz.draw: *
  B-bar(p, 439, 785, 934, $m$)
  B-bar(p, 439, 585, 966, $n$)
  let A = (459, 1235)
  let B = (645, 1235)
  let P = (781, 1235)
  let C = (771, 983)
  let D = B-lerp(A, C, 0.865)
  let E = B-lerp(A, C, 0.49)
  seg(p, A, B)
  dseg(p, B, P)
  dseg(p, P, (825, 1235))
  line(p(820, 1235), p(827, 1235), stroke: lt, mark: arw)
  dseg(p, A, C)
  dseg(p, D, P)
  dseg(p, E, B)
  // 尺寸线 m、n（两端带短横）
  let m0 = (442, 1210)
  let m1 = (710, 994)
  line(p(..m0), p(..m1), stroke: lt, mark: arw2)
  tickat(p, m0, m1, m0, s: 5)
  tickat(p, m0, m1, m1, s: 5)
  let n0 = (607, 1097)
  let n1 = (717, 1009)
  line(p(..n0), p(..n1), stroke: lt, mark: arw2)
  B-white(p, (582, 1098), w: 12, h: 13)
  lbl(p, (582, 1098), tsm($m$), dir: "c", d: 0)
  B-white(p, (662, 1053), w: 12, h: 13)
  lbl(p, (662, 1053), tsm($n$), dir: "c", d: 0)
  lbl(p, A, $A$, dir: "s", d: 14)
  lbl(p, B, $B$, dir: "s", d: 14)
  lbl(p, P, $P$, dir: "s", d: 14)
  lbl(p, C, $C$, dir: "nw", d: 11)
  lbl(p, D, $D$, dir: "e", d: 12)
  lbl(p, E, $E$, dir: "se", d: 11)
})

// 图 1·25 例 2：周长为 l，三边比 3 : 5 : 7
#let fig-B-1-25(width: 540 * k) = px-canvas(540, 410, origin: (270, 670), width: width, (p, u) => {
  import cetz.draw: *
  B-bar(p, 285, 581, 691, $l$)
  B-bar(p, 285, 314, 721, $a$, d: 8)
  let L = (290, 1047)
  let M = (587, 1046)
  let R = (655, 795)
  let at(i) = B-lerp(L, R, i / 15)
  let P = at(3)
  let Q = at(8)
  let P1 = B-lerp(L, M, 3 / 15)
  let Q1 = B-lerp(L, M, 8 / 15)
  seg(p, L, M)
  dseg(p, L, (750, 729))
  dseg(p, P, P1)
  dseg(p, Q, Q1)
  dseg(p, R, M)
  for i in range(1, 16) {
    tickat(p, L, R, at(i), s: 4)
  }
  lbl(p, L, $L$, dir: "w", d: 11)
  lbl(p, P, $P$, dir: "nw", d: 11)
  lbl(p, Q, $Q$, dir: "nw", d: 11)
  lbl(p, R, $R$, dir: "nw", d: 11)
  lbl(p, (744, 719), $N$, dir: "c", d: 0)
  lbl(p, P1, $P'$, dir: "s", d: 14)
  lbl(p, Q1, $Q'$, dir: "s", d: 14)
  lbl(p, M, $M$, dir: "s", d: 14)
  // 右下角的三角形 ABC（三边 3 : 5 : 7 的示意）
  let A = (679, 1020)
  let B = (776, 1012)
  let C = (792, 952)
  poly(p, (A, B, C), close: true)
  lbl(p, A, $A$, dir: "w", d: 11)
  lbl(p, B, $B$, dir: "se", d: 10)
  lbl(p, C, $C$, dir: "ne", d: 10)
})
