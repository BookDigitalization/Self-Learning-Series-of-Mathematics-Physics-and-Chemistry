// 图 2·34（原书 p.152）、2·35（p.153）、2·36（p.154）；页面 120 dpi 坐标。
#import "I-base.typ": *

// 图 2·34 例 1：(1) c = 3a；(2) 直角三角形求 d = √(a²+b²)；(3) x = c·b/d
#let fig-I-2-34(width: 690 * k) = px-canvas(690, 365, origin: (130, 835), width: width, (p, u) => {
  import cetz.draw: *
  // (1)
  pseg(p, (197, 858), (295, 858))
  lbl(p, (246, 858), $a$, dir: "n", d: 8)
  pseg(p, (197, 888), (363, 888))
  lbl(p, (280, 888), $b$, dir: "n", d: 8)
  let c0 = (200, 938)
  let c3 = (500, 926)
  dseg(p, c0, c3)
  for i in range(4) { let q = lerp(c0, c3, i / 3); tickat(p, c0, c3, q, s: 5) }
  for i in range(3) { lbl(p, lerp(c0, c3, (i + 0.5) / 3), $a$, dir: "n", d: 9) }
  lbl(p, lerp(c0, c3, 0.5), $c = 3 a$, dir: "s", d: 10)
  lbl(p, (152, 880), tsm[(1)], dir: "c", d: 0)
  // (2)
  let (A, R, T) = ((548, 942), (708, 946), (713, 848))
  dseg(p, A, R)
  dseg(p, R, T)
  dseg(p, A, T)
  rtmark(p, R, A, T, s: 8)
  lbl(p, lerp(R, T, 0.5), $a$, dir: "e", d: 9)
  lbl(p, lerp(A, R, 0.5), $b$, dir: "s", d: 9)
  rlbl(p, (lerp(A, T, 0.5).at(0) - 10, lerp(A, T, 0.5).at(1) - 14), 29.7, $d = sqrt(a^2 + b^2)$)
  lbl(p, (540, 878), tsm[(2)], dir: "c", d: 0)
  // (3)
  let L = (180, 1135)
  let M = (485, 1150)
  let X = (745, 1160)
  let P1 = (370, 1074)
  let s = (X.at(0) - L.at(0)) / (M.at(0) - L.at(0))
  let P2 = lerp(L, P1, s)
  dseg(p, L, lerp(L, P1, s * 1.1))
  dseg(p, L, M)
  dseg(p, P1, M)
  tdseg(p, P2, X)
  tseg(p, M, X)
  tdseg(p, X, (800, 1162))
  lbl(p, lerp(L, P1, 0.5), $d$, dir: "n", d: 9)
  lbl(p, lerp(P1, P2, 0.5), $b$, dir: "n", d: 9)
  lbl(p, lerp(L, M, 0.5), $3 a$, dir: "s", d: 10)
  lbl(p, lerp(M, X, 0.5), $x$, dir: "s", d: 10)
  lbl(p, (150, 1090), tsm[(3)], dir: "c", d: 0)
})

// 图 2·35 例 2：(1) c = a + b；(2) d = √(a²−b²)；(3) x = √(c·d)
#let fig-I-2-35(width: 730 * k) = px-canvas(730, 290, origin: (165, 775), width: width, (p, u) => {
  import cetz.draw: *
  // (1)
  pseg(p, (185, 795), (315, 795))
  lbl(p, (250, 795), $a$, dir: "n", d: 8)
  pseg(p, (185, 830), (262, 830))
  lbl(p, (224, 830), $b$, dir: "n", d: 8)
  let (c0, cm, c1) = ((185, 880), (312, 880), (396, 877))
  dseg(p, c0, c1)
  tickat(p, c0, c1, c0)
  tickat(p, c0, c1, cm)
  tickat(p, c0, c1, c1)
  lbl(p, lerp(c0, cm, 0.5), $a$, dir: "n", d: 9)
  lbl(p, lerp(cm, c1, 0.5), $b$, dir: "n", d: 9)
  lbl(p, lerp(c0, c1, 0.5), $c = a + b$, dir: "s", d: 10)
  lbl(p, (265, 928), tsm[(1)], dir: "c", d: 0)
  // (2)：直角三角形，斜边 a，直角边 b（竖直），另一直角边 d
  let (R, T, B) = ((500, 975), (500, 905), (380, 975))
  dseg(p, (335, 975), R)
  dseg(p, R, (500, 845))
  dseg(p, B, T)
  lbl(p, lerp(B, T, 0.5), $a$, dir: "nw", d: 9)
  lbl(p, lerp(R, T, 0.5), $b$, dir: "e", d: 9)
  lbl(p, (440, 975), $d = sqrt(a^2 - b^2)$, dir: "s", d: 11)
  lbl(p, (420, 1015), tsm[(2)], dir: "c", d: 0)
  // (3)：半圆，直径上 c、d 相接，垂线 x
  let O = (714, 983)
  let r = 166
  darc(p, O, r, 0, 180)
  dseg(p, (548, 983), (880, 983))
  seg(p, (757, 983), (757, 823))   // x 在原图为实线
  tickat(p, (548, 983), (880, 983), (757, 983), s: 0)
  tseg(p, (880, 983), (880, 945))
  lbl(p, (660, 983), $c$, dir: "s", d: 10)
  lbl(p, (818, 983), $d$, dir: "s", d: 10)
  lbl(p, (750, 900), $x$, dir: "w", d: 9)
  lbl(p, (715, 1010), tsm[(3)], dir: "c", d: 0)
})

// 图 2·36 例 3：(1) 线段 AB 上 AP = x，PB = a − x；(2) 作 BC ⊥ AB，BC = a/2，在 AC 上取 CD = a/2，在 AB 上取 AP = AD
#let fig-I-2-36(width: 330 * k) = px-canvas(330, 310, origin: (540, 205), width: width, (p, u) => {
  import cetz.draw: *
  // (1)
  let (A1, B1, P1) = ((568, 243), (835, 243), (735, 243))
  dimh(p, 568, 835, 222, lab: $a$)
  tseg(p, A1, B1)
  tickat(p, A1, B1, A1, s: 5)
  tickat(p, A1, B1, B1, s: 5)
  dimh(p, 568, 735, 265, lab: $x$)
  dimh(p, 735, 835, 265, lab: $a - x$, gapw: 48)
  lbl(p, (739, 254), $P$, dir: "c", d: 0)
  lbl(p, (556, 243), $A$, dir: "w", d: 6)
  lbl(p, (846, 243), $B$, dir: "e", d: 6)
  lbl(p, (628, 296), tsm[(1)], dir: "c", d: 0)
  // (2)
  let A = (555, 432)
  let B = (836, 432)
  let C = (836, 293)
  let r = dist(A, C) - dist(B, C)
  let D = lerp(A, C, r / dist(A, C))
  let P = (A.at(0) + r, 432)
  tseg(p, A, B)
  dseg(p, B, C)
  dseg(p, A, D)
  tdseg(p, D, C)
  // 以 A 为圆心，从 D 到 P 的虚线弧
  let a0 = dirang(D.at(0) - A.at(0), D.at(1) - A.at(1))
  darc(p, A, r, 0, a0.deg())
  // 以 C 为圆心、CD = CB = a/2 为半径，从 D 到 B 的虚线弧（原图有）
  let a1 = dirang(D.at(0) - C.at(0), D.at(1) - C.at(1))
  darc(p, C, dist(B, C), a1.deg(), -90)
  lbl(p, A, $A$, dir: "w", d: 9)
  lbl(p, B, $B$, dir: "e", d: 9)
  lbl(p, C, $C$, dir: "ne", d: 9)
  lbl(p, D, $D$, dir: "nw", d: 9)
  lbl(p, P, $P$, dir: "s", d: 12)
  lbl(p, lerp(B, C, 0.5), $a / 2$, dir: "e", d: 12)
  lbl(p, (695, 494), tsm[(2)], dir: "c", d: 0)
})
