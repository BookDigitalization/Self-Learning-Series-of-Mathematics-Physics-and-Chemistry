  table.hline(stroke: 1.2pt),
  [圆 $O$ 的内接正多\ 边形的边数，$n$], [一边的长，$a_n$], [周长，$p_n = n a_n$], [周长与直径的比 $display(p_n / (2 R))$],
  table.hline(stroke: 0.6pt),
  [6], [$1.00000 R$], [$6.0000 R$], [3.0000],
