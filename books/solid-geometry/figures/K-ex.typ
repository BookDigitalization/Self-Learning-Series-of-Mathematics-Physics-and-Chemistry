// 正方体及以各面中心为顶点的正八面体（第 6 题）
#let fig-K-ex17-6(width: 230 * k) = px-canvas(230, 230, origin: (555, 408), width: width, (p, u) => {
  import cetz.draw: *
  let a = (562, 473)
  let b = (718, 473)
  let c = (718, 628)
  let d = (565, 630)
  let e = (617, 415)
  let f = (772, 414)
  let g = (775, 570)
  let h = (620, 572)
  tpoly(p, (a, d, c, g, f, e, a))
  tseg(p, e, h)
  tseg(p, h, g)
  tseg(p, h, d)
  dseg(p, a, b)
  dseg(p, b, c)
  dseg(p, b, f)
  let tp = kcen((a, b, f, e))
  let bt = kcen((d, c, g, h))
  let lf = kcen((a, d, h, e))
  let rg = kcen((b, c, g, f))
  let f1 = kcen((a, b, c, d))
  let f2 = kcen((e, f, g, h))
  khatch(p, (lf, f2, rg, f1), gap: 6, deg: 15)
  for q in (lf, rg, f1, f2) {
    dseg(p, tp, q)
    dseg(p, bt, q)
  }
  dseg(p, lf, f2)
  dseg(p, f2, rg)
  dseg(p, rg, f1)
  dseg(p, f1, lf)
})

// 习题 2·17 第 8 题：内接于正八面体的立方体（立方体的顶点在八面体的棱上，t = 2/(2+√2)）
#let fig-K-ex17-8(width: 240 * k) = px-canvas(240, 230, origin: (200, 1027), width: width, (p, u) => {
  import cetz.draw: *
  let T = (322, 1035)
  let Bt = (318, 1247)
  let L0 = (212, 1165)
  let R = (423, 1120)
  let F = (352, 1165)
  let K = (288, 1117)
  let t = 2 / (2 + calc.sqrt(2))
  let (a, b, c, d) = (L0, F, R, K).map(q => lerp(T, q, t))
  let (a2, b2, c2, d2) = (L0, F, R, K).map(q => lerp(Bt, q, t))
  // 八面体
  tpoly(p, (T, L0, Bt, R, T))
  tseg(p, T, F)
  tseg(p, Bt, F)
  tseg(p, L0, F)
  tseg(p, F, R)
  for q in (T, Bt, L0, R) { dseg(p, K, q) }
  // 立方体（虚实照原图）
  tseg(p, a, b)
  tseg(p, b, c)
  dseg(p, c, d)
  dseg(p, d, a)
  tseg(p, a2, b2)
  tseg(p, b2, c2)
  dseg(p, c2, d2)
  dseg(p, d2, a2)
  dseg(p, a, a2)
  tseg(p, b, b2)
  dseg(p, c, c2)
  dseg(p, d, d2)
})

