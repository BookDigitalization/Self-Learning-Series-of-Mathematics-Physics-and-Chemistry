#import "J-base.typ": *

#let fig-J-2-68(width: 445 * k) = px-canvas(445, 285, origin: (475, 595), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 M（后边被两个棱锥挡住的部分画虚线）、平面 N
  let my(x) = 775 + 4 * (x - 554) / 357
  JS(p, (554, my(554)), (574, my(574)))
  JD(p, (574, my(574)), (694, my(694)))
  JS(p, (694, my(694)), (734, my(734)))
  JD(p, (734, my(734)), (847, my(847)))
  JS(p, (847, my(847)), (911, 779), (840, 855), (479, 852), (554, 775))
  poly(p, ((602, 678), (900, 679), (840, 741), (543, 740)), close: true)
  // 棱锥 P—ABC
  let P = (639, 622)
  let (A, B, C) = ((565, 798), (620, 845), (702, 798))
  let s = 0.506
  let (a, b, c) = (Jlerp(P, A, s), Jlerp(P, B, s), Jlerp(P, C, s))
  for (X, t) in ((A, 0.67), (C, 0.673)) {
    JS(p, P, Jlerp(P, X, s))
    JD(p, Jlerp(P, X, s), Jlerp(P, X, t))
    JS(p, Jlerp(P, X, t), X)
  }
  JS(p, P, B)
  JS(p, A, B, C)
  JD(p, A, C)
  JS(p, a, b, c)
  JD(p, a, c)
  // 棱锥 P1—A1B1C1D1
  let P1 = (783, 623)
  let (A1, B1, C1, D1) = ((727, 798), (756, 835), (818, 834), (852, 790))
  let s1 = 0.5
  let (a1, b1, c1, d1) = (A1, B1, C1, D1).map(x => Jlerp(P1, x, s1))
  for (X, t) in ((A1, 0.674), (D1, 0.707)) {
    JS(p, P1, Jlerp(P1, X, s1))
    JD(p, Jlerp(P1, X, s1), Jlerp(P1, X, t))
    JS(p, Jlerp(P1, X, t), X)
  }
  JS(p, P1, B1)
  JS(p, P1, C1)
  JS(p, A1, B1, C1, D1)
  JD(p, A1, D1)
  JS(p, a1, b1, c1, d1)
  JD(p, a1, d1)
  // 高
  JT(p, P, P1)
  JD(p, P, (639, 810), (718, 812))
  JD(p, P1, (781, 814), (718, 814))
  line(p(718, 812), p(718, 623), stroke: lt, mark: (end: "stealth", fill: black, scale: 0.45))
  L(p, 640, 605, $P$)
  L(p, 793, 606, $P_1$)
  L(p, 868, 691, $N$)
  L(p, 522, 840, $M$)
  L(p, 555, 800, $A$)
  L(p, 620, 863, $B$)
  L(p, 712, 804, $C$)
  L(p, 728, 714, $h$)
  L(p, 744, 789, $A_1$)
  L(p, 869, 797, $D_1$)
  L(p, 750, 856, $B_1$)
  L(p, 830, 851, $C_1$)
  L(p, 621, 712, $S$)
  L(p, 778, 710, $S_1$)
})

