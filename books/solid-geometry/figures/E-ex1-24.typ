#let fig-E-ex1-24-2(width: 330 * k) = px-canvas(330, 270, origin: (160, 945), width: width, (p, u) => {
  import cetz.draw: *
  // 水平平面与竖直平面
  let L = (177, 1190)
  let I1 = (255, 1107)
  let R1 = (474, 1101)
  let R2 = (399, 1184)
  seg(p, L, I1)
  seg(p, I1, R1)
  seg(p, R1, R2)
  seg(p, R2, L)
  poly(p, ((250, 950), (171, 1035), L, I1, (250, 950)))
  let A = (234, 1130)
  let B = (204, 1162)
  let C = (230, 1027)
  let D = (348, 1160)
  E-bold(p, (C, A))
  E-bold(p, (B, D))
  E-bold(p, (C, D))
  lbl(p, C, $C$, dir: "nw", d: 11)
  lbl(p, A, $A$, dir: "se", d: 10)
  lbl(p, B, $B$, dir: "w", d: 11)
  lbl(p, D, $D$, dir: "e", d: 11)
})

