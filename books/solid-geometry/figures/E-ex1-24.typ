#let fig-E-ex1-24-11(width: 310 * k) = px-canvas(310, 260, origin: (550, 1032), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 M
  let L = (555, 1202)
  let TL = (620, 1128)
  let R = (818, 1118)
  let BR = (753, 1193)
  seg(p, L, TL)
  seg(p, TL, (648, 1127))
  dseg(p, (648, 1127), (720, 1124))
  seg(p, (720, 1124), R)
  seg(p, L, BR)
  seg(p, BR, R)
  // 平面 N：左上角 (648,1108)，上边斜升到 (712,1040)，右边经 D 向下（M 下方一段虚线）
  let D = (718, 1121)
  seg(p, (648, 1108), (659, 1282))
  seg(p, (659, 1282), (724, 1205))
  seg(p, (648, 1108), (712, 1040))
  seg(p, (712, 1040), D)
  dseg(p, D, (723, 1195))
  seg(p, (723, 1195), (724, 1205))
  let A = (666, 1116)
  let B = (698, 1082)
  let A1 = (673, 1228)
  let C = (651, 1196)
  // P 是 A1B 与 CD 的交点
  let P = (685, 1157)
  seg(p, C, D)
  E-bold(p, (A, A1))
  E-bold(p, (A1, (681, 1193)))
  dseg(p, (681, 1193), P)
  E-bold(p, (P, B))
  // 原图从 B 另有一条粗线到 CD 上
  E-bold(p, (B, (703, 1137)))
  lbl(p, A, $A$, dir: "nw", d: 11)
  lbl(p, B, $B$, dir: "n", d: 10)
  lbl(p, D, $D$, dir: "ne", d: 10)
  lbl(p, (697, 1163), $P$, dir: "c", d: 0)
  lbl(p, C, $C$, dir: "w", d: 11)
  lbl(p, A1, $A_1$, dir: "s", d: 11)
  lbl(p, (710, 1202), $N$, dir: "c", d: 0)
  lbl(p, (790, 1130), $M$, dir: "c", d: 0)
})
