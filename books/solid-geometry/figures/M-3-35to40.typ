// 图 3·38 例 2
#let fig-M-3-38(width: 200 * k) = px-canvas(225, 200, origin: (640, 355), width: width, (p, u) => {
  import cetz.draw: *
  let A0 = (695, 375)
  let A = (812, 375)
  let B0 = (650, 525)
  let B = (838, 525)
  let O1 = (764, 375)
  let O = (764, 525)
  let M = M-lerp(A, B, 0.5)
  let N = (764, M.at(1))
  // KM ⊥ AB，K 在轴上
  let dx = O.at(0) - M.at(0)
  let K = (764, M.at(1) + dx * (B.at(0) - A.at(0)) / (B.at(1) - A.at(1)) * -1)
  let B1 = (764 + B.at(0) - A.at(0), 525)
  poly(p, (A0, A, B, B0), close: true)
  dseg(p, O1, O)
  dseg(p, O1, B1)
  dseg(p, N, M)
  seg(p, K, M)
  rtmark(p, N, M, O1, s: 6)
  rtmark(p, M, K, B, s: 6)
  rtmark(p, O, O1, B, s: 6)
  M-L(p, 765, 362, $O_1$)
  M-L(p, 820, 362, $A$)
  M-L(p, 749, 441, $N$)
  M-L(p, 846, 444, $M$)
  M-L(p, 749, 466, $K$)
  M-L(p, 762, 543, $O$)
  M-L(p, 797, 543, $B_1$)
  M-L(p, 853, 530, $B$)
})

// 图 3·39 例 3：截成圆台的原来圆锥
#let fig-M-3-39(width: 215 * k) = px-canvas(230, 255, origin: (650, 370), width: width, (p, u) => {
  import cetz.draw: *
  let V = (787, 388)
  let O = (787, 600)
  let A = (707, 600)
  let R0 = (867, 600)
  let t = (532 - 388) / (600 - 388)
  let A1 = M-lerp(V, A, t)
  let O1 = (787, 532)
  seg(p, V, A)
  seg(p, V, R0)
  M-base-ell(p, O, 80, 25)
  M-base-ell(p, O1, 80 * t, 17)
  dseg(p, V, O)
  dseg(p, A1, O1)
  dseg(p, A, O)
  // 母线 l 的尺寸线：与 VA 平行，向左上方平移
  let (nx, ny) = nrm(V, A)
  let d = 30
  let V2 = (V.at(0) + nx * d, V.at(1) + ny * d)
  let A2 = (A.at(0) + nx * d, A.at(1) + ny * d)
  line(p(..V2), p(..A2), stroke: lt, mark: arw2)
  M-thin(p, (V.at(0) + nx * 4, V.at(1) + ny * 4), (V.at(0) + nx * (d + 6), V.at(1) + ny * (d + 6)))
  M-thin(p, (A.at(0) + nx * 4, A.at(1) + ny * 4), (A.at(0) + nx * (d + 6), A.at(1) + ny * (d + 6)))
  M-L(p, 791, 374, $V$)
  M-L(p, 707, 482, $l$)
  M-L(p, 761, 522, $r$)
  M-L(p, 806, 534, $O_1$)
  M-L(p, 722, 549, $A_1$)
  M-L(p, 754, 591, $R$)
  M-L(p, 803, 606, $O$)
  M-L(p, 700, 616, $A$)
})

