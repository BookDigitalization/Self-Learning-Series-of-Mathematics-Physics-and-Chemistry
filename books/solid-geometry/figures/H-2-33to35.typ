// 图 2·33、2·34、2·35（原书 p.151）；页面 200 dpi 坐标。
#import "H-base.typ": *

// 图 2·33 (1) 正方体的直观图
#let fig-H-2-33a(width: 180 * k) = px-canvas(180, 180, origin: (238, 343), width: width, (p, u) => {
  import cetz.draw: *
  let (x0, y0, s, dx, dy) = (245, 515, 118, 48, -48)
  let F = ((x0, y0), (x0 + s, y0), (x0 + s, y0 - s), (x0, y0 - s))
  let Bk = F.map(q => (q.at(0) + dx, q.at(1) + dy))
  Hbp(p, F, close: true)
  Hbp(p, (F.at(3), Bk.at(3), Bk.at(2), F.at(2)))
  Hbp(p, (Bk.at(2), Bk.at(1), F.at(1)))
  dseg(p, Bk.at(0), F.at(0))
  dseg(p, Bk.at(0), Bk.at(1))
  dseg(p, Bk.at(0), Bk.at(3))
})

// 图 2·33 (2) 桌子的直观图
#let fig-H-2-33b(width: 262 * k) = px-canvas(262, 210, origin: (568, 312), width: width, (p, u) => {
  import cetz.draw: *
  // 桌面
  Hbp(p, ((575, 391), (745, 393), (822, 320), (652, 317)), close: true)
  // 前面
  Hbp(p, ((575, 391), (575, 515), (588, 515), (588, 410), (730, 410), (730, 516), (745, 516), (745, 393)))
  Hbp(p, ((588, 515), (595, 509), (595, 410)))
  Hbp(p, ((745, 516), (752, 509), (752, 400)))
  // 右侧面下缘与右后腿
  Hbp(p, ((752, 400), (797, 360), (797, 450), (808, 450), (808, 350)))
  Hbp(p, ((808, 450), (822, 443), (822, 320)))
  Hb(p, (797, 360), (808, 350))
  // 左后腿
  Hbp(p, ((636, 410), (636, 448), (648, 449), (648, 410)))
  Hbp(p, ((648, 449), (654, 443), (654, 410)))
})

// 图 2·34 桌子的图画
#let fig-H-2-34(width: 370 * k) = px-canvas(370, 300, origin: (122, 632), width: width, (p, u) => {
  import cetz.draw: *
  // 桌面上表面
  Hbp(p, ((128, 756), (367, 756), (487, 637), (250, 640)), close: true)
  // 桌面厚度
  Hbp(p, ((128, 756), (128, 776), (367, 776), (367, 756)))
  Hbp(p, ((367, 776), (487, 656), (487, 637)))
  // 左前腿
  Hbp(p, ((135, 776), (135, 930), (152, 930), (152, 807), (347, 807), (347, 930), (366, 930), (366, 776)))
  Hbp(p, ((152, 930), (166, 922), (166, 807)))
  Hbp(p, ((366, 930), (381, 918), (381, 800)))
  // 右侧面下缘与右后腿
  Hbp(p, ((381, 800), (460, 722), (460, 822), (472, 822), (472, 708)))
  Hbp(p, ((472, 822), (487, 812), (487, 656)))
  Hb(p, (460, 722), (472, 708))
  // 左后腿
  Hbp(p, ((236, 807), (236, 828), (252, 826), (252, 807)))
  Hbp(p, ((252, 826), (267, 812), (267, 807)))
})

