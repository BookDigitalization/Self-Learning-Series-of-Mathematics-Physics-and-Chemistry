// 图 1·10（p.9）：平面 M 与平面 H 相交于点 O；H 扩大后相交于直线 OP
#let fig-A-1-10(width: 345 * k) = px-canvas(345, 215, origin: (550, 1000), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 M
  A-seg(p, (561, 1134), (827, 1136))
  A-seg(p, (827, 1136), (884, 1079))
  A-seg(p, (767, 1077), (884, 1079))
  A-seg(p, (616, 1078), (670, 1078))
  A-seg(p, (561, 1134), (616, 1078))
  // 平面 H（阴影）
  for i in range(0, 9) {
    let yl = 1105 - 12 * i
    let yr = yl - 38.8
    if yr >= 1007 {
      A-seg(p, (670, yl), (771, yr), s: lt)
    } else {
      A-seg(p, (670, yl), (670 + (yl - 1007) / 0.384, 1007), s: lt)
    }
  }
  A-poly(p, ((670, 1006), (771, 1007), (769, 1071), (670, 1109)), s: lb)
  A-seg(p, (670, 1111), (770, 1112), s: lb)
  // 扩大的平面 H（点划线）
  A-seg(p, (670, 1111), (670, 1194), s: A-dd)
  A-seg(p, (670, 1194), (768, 1196), s: A-dd)
  A-seg(p, (768, 1196), (768, 1075), s: A-dd)
  A-t(p, (690, 1027), $H$)
  A-t(p, (605, 1115), $M$)
  A-t(p, (657, 1115), $O$)
  A-t(p, (782, 1115), $P$)
})

