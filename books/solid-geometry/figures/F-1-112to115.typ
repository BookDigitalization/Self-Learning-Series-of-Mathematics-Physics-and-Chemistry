#let fig-F-1-114a(width: 220 * k) = px-canvas(220, 275, origin: (90, 780), width: width, (p, u) => {
  import cetz.draw: *
  let S = (209, 795)
  let A = (135, 935)
  let B = (212, 976)
  let C = (274, 962)
  let D = (187, 905)
  // 阴影：沿 AB 到 DC 的一族线
  for i in range(1, 12) {
    let t = i / 12
    line(p(..lerp(A, B, t)), p(..lerp(D, C, t)), stroke: 0.4pt)
  }
  seg(p, S, (100, 998))
  seg(p, S, (216, 1044))
  seg(p, S, (290, 1002))
  dseg(p, S, (170, 988))
  seg(p, A, D)
  seg(p, D, C)
  tseg(p, A, B)
  tseg(p, B, C)
  L(p, 210, 781, $S$)
  L(p, 117, 932, $A$)
  L(p, 199, 991, $B$)
  L(p, 284, 961, $C$)
  L(p, 198, 889, $D$)
})

