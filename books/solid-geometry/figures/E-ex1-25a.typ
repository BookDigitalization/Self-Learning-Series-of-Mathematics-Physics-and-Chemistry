// 习题 1·25(1) 第 5 题（p.93）、第 6、7 题（p.94）、第 10 题（p.94）插图；页面 200 dpi 坐标。
#import "E-base.typ": *

#let fig-E-ex1-25a-5(width: 320 * k) = px-canvas(320, 250, origin: (595, 925), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 M
  seg(p, (597, 1106), (672, 1031))
  seg(p, (597, 1106), (822, 1112))
  seg(p, (822, 1112), (895, 1036))
  seg(p, (672, 1031), (680, 1031))
  dseg(p, (680, 1031), (810, 1033))
  seg(p, (810, 1033), (895, 1036))
  // 两个竖直平面（过 AB、过 CD），交线是过 O、O1 的竖线；按原图重描（crop-view 200 dpi 放大核对）
  let X = (745, 960)    // 两平面上边的交点（交线上端）
  let O = (745, 983)
  let O1 = (745, 1068)
  // 过 AB 的平面：左上 (680,947)，右上 (808,980)，右下 (808,1090)，左下 A1
  let A1 = (680, 1052)
  let B1 = (808, 1090)
  seg(p, (680, 947), X)
  dseg(p, X, (808, 980))          // 上边右段在过 CD 的平面后面
  seg(p, (680, 947), A1)
  seg(p, (808, 980), B1)
  // 过 CD 的平面：右上 (795,937)，左上 (700,985)，左下 C1，右下 D1
  let C1 = (700, 1095)
  let D1 = (795, 1050)
  seg(p, (795, 937), X)
  seg(p, X, (700, 985))
  seg(p, (700, 985), C1)
  seg(p, (795, 937), (795, 977))
  dseg(p, (795, 977), D1)        // 右边下段在过 AB 的平面后面
  // 交线 OO1
  seg(p, X, O1)
  // AB、CD 及其射影 A1B1、C1D1（被平面遮住的一段虚线，照原图）
  E-bold(p, ((682, 955), (808, 1012)))
  E-bold(p, ((702, 1012), (790, 957)))
  E-bold(p, (A1, (700, 1057)))
  dseg(p, (700, 1057), O1)
  E-bold(p, (O1, B1))
  E-bold(p, (C1, O1))
  dseg(p, O1, D1)
  lbl(p, (691, 972), $A$, dir: "c", d: 0)
  lbl(p, (800, 1022), $B$, dir: "c", d: 0)
  lbl(p, (711, 1022), $C$, dir: "c", d: 0)
  lbl(p, (781, 966), $D$, dir: "c", d: 0)
  lbl(p, (756, 1000), $O$, dir: "c", d: 0)
  lbl(p, (667, 1064), $A_1$, dir: "c", d: 0)
  lbl(p, (684, 1104), $C_1$, dir: "c", d: 0)
  lbl(p, (806, 1104), $B_1$, dir: "c", d: 0)
  lbl(p, (790, 1066), $D_1$, dir: "c", d: 0)
  lbl(p, (750, 1085), $O_1$, dir: "c", d: 0)
  lbl(p, (860, 1050), $M$, dir: "c", d: 0)
})

