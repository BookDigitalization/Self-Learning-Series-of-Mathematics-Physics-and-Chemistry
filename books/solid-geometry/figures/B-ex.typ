// 习题 1·10 第 8 题：四幅
#let fig-B-ex10-8(width: 790 * k) = bc(100, 160, 2, 790, 250, width: width, P => {
  import cetz.draw: *
  let one(dx, kind) = {
    // N 在左，M 在右，交线 PQ
    poly(P, ((90 + dx, 122), (245 + dx, 70), (245 + dx, 325), (90 + dx, 378)), close: true)
    poly(P, ((245 + dx, 70), (400 + dx, 122), (400 + dx, 378), (245 + dx, 325)), close: true)
    lbl(P, (245 + dx, 40), $P$, dir: "c", d: 0)
    lbl(P, (245 + dx, 355), $Q$, dir: "c", d: 0)
    lbl(P, (115 + dx, 148), $N$, dir: "c", d: 0)
    lbl(P, (378 + dx, 150), $M$, dir: "c", d: 0)
    ring(P, (245 + dx, 215), r: 3.2)
    lbl(P, (270 + dx, 217), $C$, dir: "c", d: 0)
    // b 在 N 内：(1)(2) 与 PQ 相交的斜线，(3)(4) 与 PQ 平行
    if kind.at(0) == "x" {
      tseg(P, (135 + dx, 300), (245 + dx, 265))
      lbl(P, (178 + dx, 252), $b$, dir: "c", d: 0)
    } else {
      tseg(P, (145 + dx, 160), (145 + dx, 290))
      lbl(P, (165 + dx, 218), $b$, dir: "c", d: 0)
    }
    // a 在 M 内
    if kind.at(1) == "x" {
      tseg(P, (250 + dx, 142), (355 + dx, 180))
      lbl(P, (315 + dx, 135), $a$, dir: "c", d: 0)
    } else {
      tseg(P, (343 + dx, 168), (343 + dx, 282))
      lbl(P, (366 + dx, 215), $a$, dir: "c", d: 0)
    }
  }
  one(0, ("x", "x"))
  one(395, ("x", "p"))
  one(762, ("p", "x"))
  one(1155, ("p", "p"))
  ctext(P, (250, 432), [(1)])
  ctext(P, (645, 432), [(2)])
  ctext(P, (1005, 432), [(3)])
  ctext(P, (1405, 432), [(4)])
})

