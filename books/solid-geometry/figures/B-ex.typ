// 习题 1·9 第 6 题
#let fig-B-ex9-6(width: 300 * k) = bc(600, 960, 2, 300, 250, width: width, P => {
  import cetz.draw: *
  let A = (292, 48)
  let B = (78, 395)
  let C = (495, 392)
  let D = (272, 300)
  let mid(a, b) = ((a.at(0) + b.at(0)) / 2, (a.at(1) + b.at(1)) / 2)
  let E = mid(A, B)
  let F = mid(B, C)
  let G = mid(C, D)
  let H = mid(D, A)
  hatch(P, (E, F, G, H), (1, -1.7), 14)
  tseg(P, A, B)
  tseg(P, A, C)
  tseg(P, B, C)
  tseg(P, A, D)
  tseg(P, B, D)
  tseg(P, C, D)
  tpoly(P, (E, F, G, H), close: true)
  lbl(P, (292, 12), $A$, dir: "c", d: 0)
  lbl(P, (45, 398), $B$, dir: "c", d: 0)
  lbl(P, (525, 400), $C$, dir: "c", d: 0)
  lbl(P, (150, 222), $E$, dir: "c", d: 0)
  lbl(P, (318, 160), $H$, dir: "c", d: 0)
  lbl(P, (276, 272), $D$, dir: "c", d: 0)
  lbl(P, (400, 325), $G$, dir: "c", d: 0)
  lbl(P, (283, 425), $F$, dir: "c", d: 0)
})

