// 图 1·18（p.17）：两个相交平面的交线，哪一个画得不妥当
#let fig-A-1-18(width: 610 * k) = px-canvas(610, 205, origin: (250, 315), width: width, (p, u) => {
  import cetz.draw: *
  // ---- 左
  // 平面 N（下）
  A-seg(p, (324, 464), (509, 461))
  A-seg(p, (509, 461), (570, 396))
  A-seg(p, (474, 397), (570, 396))
  A-seg(p, (324, 464), (349, 434))
  dseg(p, (349, 434), (390, 397))
  dseg(p, (390, 397), (474, 397))
  // 平面 M（上）
  A-seg(p, (254, 439), (437, 436))
  A-seg(p, (437, 436), (499, 369))
  A-seg(p, (499, 369), (318, 372))
  A-seg(p, (318, 372), (254, 439))
  A-t(p, (385, 384), $O$)
  A-t(p, (470, 380), $M$)
  A-t(p, (336, 424), $A$)
  A-t(p, (481, 410), $B$)
  A-t(p, (539, 407), $N$)
  // ---- 右
  let T = (699, 319)
  let L = (635, 381)
  let R = (828, 441)
  let Bm = (762, 506)
  let tt0 = 0.62
  let va = (R.at(0) - T.at(0), R.at(1) - T.at(1))
  let vs = (L.at(0) - T.at(0), L.at(1) - T.at(1))
  let pt(s, t) = (T.at(0) + s * vs.at(0) + t * va.at(0), T.at(1) + s * vs.at(1) + t * va.at(1))
  let pA = pt(1, tt0)
  let pB = pt(0, tt0)
  // 平面 N 的下半（只露出平面 M 外面的部分）
  for i in range(0, 12) {
    let s = (i + 0.5) / 12
    A-seg(p, pt(s, tt0), pt(s, 1), s: lt)
  }
  A-seg(p, pA, Bm)
  A-seg(p, Bm, R)
  // 平面 M（白底盖住 N 下半在 M 内的部分）
  let Mpts = ((601, 462), (790, 457), (846, 394), (660, 396))
  line(..Mpts.map(q => p(..q)), close: true, fill: white, stroke: none)
  A-seg(p, (601, 462), (790, 457))
  A-seg(p, (790, 457), (846, 394))
  // 平面 N 的上半（在 M 前面）
  line(..(T, L, pA, pB).map(q => p(..q)), close: true, fill: white, stroke: none)
  for i in range(0, 12) {
    let s = (i + 0.5) / 12
    A-seg(p, pt(s, 0), pt(s, tt0), s: lt)
  }
  A-seg(p, T, L, s: lb)
  A-seg(p, L, pA, s: lb)
  A-seg(p, T, pB, s: lb)
  // 被 N 遮住的 M 的边（虚线）及 B 到 R 的 N 的边
  dseg(p, (660, 396), pB)
  A-seg(p, pB, (846, 394))
  dseg(p, pB, (813, 430))
  A-seg(p, (813, 430), R)
  A-seg(p, (601, 462), (660, 396))
  A-seg(p, pA, pB, s: lb)
  ring(p, (743, 429), r: 2.5)
  A-t(p, (691, 339), $N$)
  A-t(p, (785, 380), $B$)
  A-t(p, (764, 432), $O$)
  A-t(p, (631, 450), $M$)
  A-t(p, (702, 476), $A$)
})

