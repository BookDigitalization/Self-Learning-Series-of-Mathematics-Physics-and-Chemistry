// 图 1·20（p.18）：求直线 a 与平面 P 的公共点 C
#let fig-A-1-20(width: 380 * k) = px-canvas(380, 330, origin: (480, 290), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 P 上的横线（只画在左右两块可见区域）
  let yy = 428
  while yy < 519 {
    // 左块
    let xl = 489 + (516 - yy) * 99 / 95
    let xr = 571 + 0.537 * (yy - 391)
    if xl < xr { A-seg(p, (xl, yy), (xr, yy), s: lt) }
    // 右块
    let xa = 641 + 1.021 * (520 - yy)
    let xb = 846 - 1.01 * (yy - 426)
    if xa < xb { A-seg(p, (xa, yy), (xb, yy), s: lt) }
    yy += 6.4
  }
  // 平面 Q
  // 右边从 B 到穿出平面 P 右边之间被 P 遮住，原图不画
  A-seg(p, (571, 391), (662, 297))
  A-seg(p, (662, 297), (738, 425))
  A-seg(p, (775, 497), (785, 515))
  A-seg(p, (785, 515), (687, 607))
  A-seg(p, (687, 607), (571, 391))
  // 平面 P
  A-seg(p, (489, 516), (588, 421))
  A-seg(p, (489, 516), (748, 523))
  A-seg(p, (748, 523), (846, 426))
  dseg(p, (588, 421), (738, 425))
  A-seg(p, (738, 425), (846, 426))
  // 交线 AB
  A-seg(p, (641, 520), (738, 425), s: lb)
  // 直线 a
  A-seg(p, (659, 356), (690, 470), s: lb)
  A-seg(p, (706, 522), (716, 556), s: lb)
  ring(p, (666, 493), r: 2.5)
  ring(p, (692, 469), r: 2.5)
  A-t(p, (665, 322), $Q$)
  A-t(p, (680, 381), $a$)
  A-t(p, (748, 409), $B$)
  A-t(p, (671, 462), $C$)
  A-t(p, (648, 485), $A$)
  A-t(p, (816, 439), $P$)
})

