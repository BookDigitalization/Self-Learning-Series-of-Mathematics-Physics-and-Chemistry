// 习题 2·3 的插图：第 6 题（原书 p.132）、第 7、9、10 题（p.133）、第 11 题（p.134）；页面 200 dpi 坐标。
// p.133 扫描右侧有一块圆形印章污渍（压在第 10 题图上方），不属于插图，未画。
#import "G-base.typ": *

// 平行六面体：底面 a b c d（a 前左、b 前右、c 后右、d 后左），顶面 a1 b1 c1 d1；d 角的三条棱为虚线
#let G2xbox(p, a, b, c, d, a1, b1, c1, d1) = {
  tseg(p, a, b)
  tseg(p, b, c)
  tseg(p, a, a1)
  tseg(p, b, b1)
  tseg(p, c, c1)
  tseg(p, a1, b1)
  tseg(p, b1, c1)
  tseg(p, c1, d1)
  tseg(p, d1, a1)
  dseg(p, d, a)
  dseg(p, d, c)
  dseg(p, d, d1)
}
// 第 6 题：平行六面体，A1H ⊥ 底面，H 在 AC 上
#let fig-G-ex2-3-6(width: 260 * k) = px-canvas(260, 200, origin: (345, 1185), width: width, (p, u) => {
  import cetz.draw: *
  let A = (365, 1352)
  let B = (492, 1351)
  let C = (550, 1307)
  let D = (422, 1306)
  let A1 = (400, 1257)
  let B1 = (527, 1255)
  let C1 = (583, 1209)
  let D1 = (461, 1207)
  G2xbox(p, A, B, C, D, A1, B1, C1, D1)
  seg(p, A1, C1)
  seg(p, B1, D1)
  let O1 = isect(A1, C1, B1, D1)
  let O = isect(A, C, B, D)
  dseg(p, A, C)
  dseg(p, B, D)
  dseg(p, O1, O)
  let H = (404, A.at(1) + (C.at(1) - A.at(1)) * (404 - A.at(0)) / (C.at(0) - A.at(0)))
  dseg(p, A1, H)
  L(p, 437, 1196, $D_1$)
  L(p, 601, 1211, $C_1$)
  L(p, 382, 1262, $A_1$)
  L(p, 542, 1274, $B_1$)
  L(p, 411, 1301, $D$)
  L(p, 562, 1308, $C$)
  L(p, 418, 1334, $H$)
  L(p, 355, 1370, $A$)
  L(p, 494, 1368, $B$)
})

// 第 7 题：直三面角 O—xyz 内一点 P 向三个面作垂线所成的长方体
#let fig-G-ex2-3-7(width: 260 * k) = px-canvas(260, 240, origin: (635, 335), width: width, (p, u) => {
  import cetz.draw: *
  let O = (721, 486)
  let X = (840, 486)   // x 轴上的顶点
  let Y = (721, 383)   // y 轴上的顶点
  let Z = (678, 531)   // z 轴上的顶点
  let A = (840, 383)
  let B = (678, 427)
  let C = (797, 531)
  let P = (797, 427)
  // 坐标轴：长方体内的部分虚线，外面实线
  dseg(p, O, X)
  dseg(p, O, Y)
  dseg(p, O, Z)
  seg(p, X, (875, 486))
  seg(p, Y, (721, 360))
  seg(p, Z, (648, 555))
  // 长方体可见的棱
  tseg(p, B, Y)
  tseg(p, Y, A)
  tseg(p, A, P)
  tseg(p, B, P)
  tseg(p, B, Z)
  tseg(p, Z, C)
  tseg(p, C, P)
  tseg(p, A, X)
  tseg(p, X, C)
  circle(p(..P), radius: 3.2, fill: white, stroke: 0.6pt)
  L(p, 721, 346, $y$)
  L(p, 852, 383, $A$)
  L(p, 662, 430, $B$)
  L(p, 807, 437, $P$)
  L(p, 724, 504, $O$)
  L(p, 884, 487, $x$)
  L(p, 799, 544, $C$)
  L(p, 643, 567, $z$)
})

