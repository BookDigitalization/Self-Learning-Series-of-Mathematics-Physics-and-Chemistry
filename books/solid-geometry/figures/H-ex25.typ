// 第 10 题 正三棱台的截面 A1BC（斜线部分）
#let fig-H-ex25-10(width: 240 * k) = px-canvas(240, 215, origin: (660, 1120), width: width, (p, u) => {
  import cetz.draw: *
  let B = (680, 1236)
  let A = (870, 1232)
  let C = (806, 1310)
  let B1 = (738, 1144)
  let A1 = (812, 1143)
  let C1 = (787, 1173)
  let D = Hlerp(B, C, 0.5)
  let D1 = Hlerp(B1, C1, 0.5)
  let O = ((A.at(0) + B.at(0) + C.at(0)) / 3, (A.at(1) + B.at(1) + C.at(1)) / 3)
  let O1 = ((A1.at(0) + B1.at(0) + C1.at(0)) / 3, (A1.at(1) + B1.at(1) + C1.at(1)) / 3)
  let H = (812, 1251)
  // 截面 △A1BC 的斜线：水平线与三角形的交段
  let tri = (A1, B, C)
  for i in range(0, 20) {
    let y = 1150 + i * 8
    let xs = ()
    for j in range(3) {
      let (P, Q) = (tri.at(j), tri.at(calc.rem(j + 1, 3)))
      let (y1, y2) = (P.at(1), Q.at(1))
      if (y1 - y) * (y2 - y) < 0 {
        xs.push(P.at(0) + (Q.at(0) - P.at(0)) * (y - y1) / (y2 - y1))
      }
    }
    if xs.len() == 2 {
      line(p(calc.min(..xs), y), p(calc.max(..xs), y), stroke: 0.35pt)
    }
  }
  Hbp(p, (B1, A1, C1), close: true)
  Hb(p, B, B1)
  Hb(p, A, A1)
  Hb(p, B, C)
  Hb(p, C, A)
  Hb(p, A1, C)
  Ht(p, C1, C)
  Ht(p, B, A1)
  Ht(p, D, D1)
  dseg(p, B, A)
  dseg(p, A, D)
  dseg(p, A1, D)
  dseg(p, A1, D1)
  dseg(p, A1, H)
  dseg(p, O1, O)
  HL(p, 732, 1130, $B_1$)
  HL(p, 773, 1135, $O_1$)
  HL(p, 832, 1132, $A_1$)
  HL(p, 727, 1172, $D_1$)
  HL(p, 800, 1188, $C_1$)
  HL(p, 667, 1240, $B$)
  HL(p, 888, 1240, $A$)
  // TODO p.149 字母看不清（像 E，或 F），题文未提，待定或删
  HL(p, 777, 1240, box(fill: rgb("#ffe58f"), $E$))
  HL(p, 830, 1262, $H$)
  HL(p, 784, 1281, $O$)
  HL(p, 737, 1290, $D$)
  HL(p, 805, 1330, $C$)
})

// 第 11 题 把棱台的高三等分
#let fig-H-ex25-11(width: 270 * k) = px-canvas(270, 345, origin: (607, 450), width: width, (p, u) => {
  import cetz.draw: *
  let V = (713, 475)
  let A = (617, 738)
  let B = (750, 785)
  let C = (870, 733)
  let D = (693, 718)
  let O = (713, 745)
  for t in (0.35, 0.52, 0.75, 1.0) {
    let (a, b, c, d) = (A, B, C, D).map(q => Hlerp(V, q, t))
    if t == 1.0 { Hbp(p, (a, b, c)) } else { poly(p, (a, b, c)) }
    dseg(p, c, d)
    dseg(p, d, a)
  }
  for q in (A, B, C) { Hb(p, V, q) }
  dseg(p, V, D)
  dseg(p, V, O)
  HL(p, 711, 460, $V$)
  HL(p, 733, 569, $q$)
  HL(p, 740, 624, $M$)
  HL(p, 745, 690, $N$)
  HL(p, 757, 750, $Q$)
})
