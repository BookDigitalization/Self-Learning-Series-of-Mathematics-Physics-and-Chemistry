// 图 1·99、1·100（p.88），1·101、1·102、1·103（p.89）；页面 200 dpi 坐标。
#import "E-base.typ": *

#let fig-E-1-99(width: 320 * k) = px-canvas(320, 170, origin: (555, 662), width: width, (p, u) => {
  import cetz.draw: *
  poly(p, ((560, 818), (640, 737), (862, 737), (785, 819)), close: true)
  E-bold(p, ((708, 672), (708, 779)))
  lbl(p, (722, 670), $A$, dir: "c", d: 0)
  lbl(p, (716, 777), $a$, dir: "c", d: 0)
  lbl(p, (827, 748), $M$, dir: "c", d: 0)
})

#let fig-E-1-100(width: 340 * k) = px-canvas(340, 150, origin: (532, 1075), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 M
  seg(p, (537, 1216), (622, 1135))
  seg(p, (537, 1216), (765, 1223))
  seg(p, (765, 1223), (849, 1140))
  seg(p, (757, 1136), (849, 1140))
  seg(p, (622, 1135), (626, 1135))
  // 柱面（曲线）：上、下两条曲线和竖直母线
  let top = ((626, 1094), (640, 1105), (665, 1110), (690, 1107), (717, 1097), (740, 1100), (755, 1117))
  let bot = ((625, 1167), (642, 1179), (665, 1184), (690, 1180), (717, 1174), (740, 1178), (754, 1188), (752, 1200), (744, 1203))
  catmull(..top.map(t => p(..t)), stroke: lb, tension: 0.5)   // 平滑曲线（原图是光滑的波形）
  catmull(..bot.map(t => p(..t)), stroke: lb, tension: 0.5)
  seg(p, (625, 1095), (625, 1167))
  seg(p, (661, 1110), (661, 1182))
  seg(p, (719, 1101), (719, 1173))
  seg(p, (744, 1125), (744, 1202))
  seg(p, (755, 1117), (755, 1188))
  lbl(p, (622, 1082), $B$, dir: "c", d: 0)
  lbl(p, (614, 1167), $b$, dir: "c", d: 0)
  lbl(p, (732, 1125), $C$, dir: "c", d: 0)
  lbl(p, (732, 1200), $c$, dir: "c", d: 0)
  lbl(p, (809, 1151), $M$, dir: "c", d: 0)
})

