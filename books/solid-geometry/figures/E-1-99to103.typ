#let fig-E-1-102(width: 340 * k) = px-canvas(340, 150, origin: (570, 695), width: width, (p, u) => {
  import cetz.draw: *
  seg(p, (574, 825), (655, 740))
  seg(p, (655, 740), (745, 740))
  dseg(p, (745, 740), (810, 741))
  seg(p, (810, 741), (899, 741))
  seg(p, (574, 825), (815, 825))
  seg(p, (815, 825), (899, 741))
  let A = (672, 773)
  let B = (810, 710)
  let b = (812, 773)
  E-bold(p, (A, B))
  E-bold(p, (A, b))
  E-bold(p, (B, b))
  anglearc(p, A, b, B, 26)
  lbl(p, (715, 764), $α$, dir: "c", d: 0)
  lbl(p, (752, 712), $l$, dir: "c", d: 0)
  lbl(p, (659, 774), $A$, dir: "c", d: 0)
  lbl(p, (821, 773), $b$, dir: "c", d: 0)
  lbl(p, (814, 697), $B$, dir: "c", d: 0)
  lbl(p, (606, 814), $N$, dir: "c", d: 0)
})

#let fig-E-1-103(width: 780 * k) = px-canvas(780, 140, origin: (140, 1000), width: width, (p, u) => {
  import cetz.draw: *
  // (1) 直线与平面垂直
  poly(p, ((145, 1115), (200, 1058), (345, 1056), (291, 1111)), close: true)
  E-bold(p, ((251, 1012), (251, 1082)))
  lbl(p, (262, 1035), $l$, dir: "c", d: 0)
  lbl(p, (302, 1071), $M$, dir: "c", d: 0)
  // (2) 直线与平面平行
  poly(p, ((327, 1110), (377, 1054), (530, 1051), (477, 1106)), close: true)
  E-bold(p, ((416, 1025), (502, 1024)))
  lbl(p, (459, 1008), $l$, dir: "c", d: 0)
  lbl(p, (492, 1065), $M$, dir: "c", d: 0)
  // (3) 直线斜交于平面
  poly(p, ((510, 1105), (565, 1049), (714, 1046), (659, 1102)), close: true)
  // 平面上方一段（含平面之上、穿点以前）实线，穿过平面后到前边被遮住的一段虚线（原图如此）
  E-bold(p, ((568, 1014), (610, 1078)))
  dseg(p, (610, 1078), (626, 1104))
  E-bold(p, ((626, 1104), (652, 1141)))
  lbl(p, (597, 1031), $l$, dir: "c", d: 0)
  lbl(p, (675, 1061), $M$, dir: "c", d: 0)
  // (4) 直线在平面外与平面平行（斜放）
  poly(p, ((690, 1102), (747, 1045), (894, 1044), (840, 1100)), close: true)
  E-bold(p, ((781, 1029), (865, 1008)))
  lbl(p, (819, 1006), $l$, dir: "c", d: 0)
  lbl(p, (855, 1058), $M$, dir: "c", d: 0)
})
