// 图 1·69（原书 p.61）、1·70（p.62）；页面 200 dpi 坐标。
#import "D-base.typ": *

#let fig-D-1-69(width: 360 * k) = px-canvas(360, 355, origin: (540, 838), width: width, (p, u) => {
  import cetz.draw: *
  // 按原图重描（V2 核对时重画）：P、Q 是两块斜立的平行四边形平面，交线过点 A，
  // 上下两端都成 X 形；P 的左半、Q 的右半在前。被 N、M 盖住或被另一块平面挡住的部分画虚线。
  // P：(692,882) (816,854) (726,1116) (600,1150)；Q：(732,846) (824,894) (726,1166) (640,1116)。
  // 平面 N（上）
  pl(p, (548, 1001), (628, 912), (683.8, 909.1)); dd(p, (683.8, 909.1), (820, 902.2))
  pl(p, (820, 902.2), (882, 899), (806, 987), (548, 1001))
  // 平面 M（下）
  pl(p, (544, 1114), (622, 1026), (644.7, 1024.9)); dd(p, (644.7, 1024.9), (780.4, 1018.3))
  pl(p, (780.4, 1018.3), (888, 1013), (806, 1101), (544, 1114))
  // 上端 X
  tk(p, (692, 882), (816, 854))
  tk(p, (732, 846), (824, 894))
  // P 的左边（前）
  tk(p, (692, 882), (668.8, 951.6)); dd(p, (668.8, 951.6), (653.1, 995.3))
  tk(p, (653.1, 995.3), (630.1, 1062.6)); dd(p, (630.1, 1062.6), (615.3, 1110.6)); tk(p, (615.3, 1110.6), (600, 1150))
  // Q 的右边（前）
  tk(p, (824, 894), (798.6, 964.6)); dd(p, (798.6, 964.6), (790.2, 987.9))
  tk(p, (790.2, 987.9), (757.9, 1077.6)); dd(p, (757.9, 1077.6), (748.9, 1102.7)); tk(p, (748.9, 1102.7), (726, 1166))
  // 交线（过 A）
  tk(p, (768.2, 865), (741.7, 935)); dd(p, (741.7, 935), (720.3, 991.6))
  tk(p, (720.3, 991.6), (699.4, 1047)); dd(p, (699.4, 1047), (677.5, 1106.6)); tk(p, (677.5, 1106.6), (667.3, 1131.8))
  // Q 的左边、P 的右边（在后，被挡住）
  tk(p, (732, 846), (722, 875.2)); dd(p, (722, 875.2), (640, 1116))
  tk(p, (816, 854), (805.6, 884.3)); dd(p, (805.6, 884.3), (726, 1116))
  // 下端 X
  tk(p, (600, 1150), (667.3, 1131.8)); dd(p, (667.3, 1131.8), (726, 1116))
  dd(p, (640, 1116), (667.3, 1131.8)); tk(p, (667.3, 1131.8), (726, 1166))
  // 平面 N 内的 a、b，平面 M 内的 a′、b′
  tk(p, (668.8, 951.6), (741.7, 935)); dd(p, (741.7, 935), (791.9, 923.6))
  tk(p, (741.7, 935), (798.6, 964.6)); dd(p, (741.7, 935), (707.6, 917.3))
  tk(p, (630.1, 1062.6), (699.4, 1047)); dd(p, (699.4, 1047), (753.6, 1034.5))
  tk(p, (699.4, 1047), (757.9, 1077.6)); dd(p, (699.4, 1047), (665, 1031.1))
  t(p, (754, 918), $A$); t(p, (716, 950), $a$); t(p, (762, 958), $b$)
  t(p, (580, 985), $N$); t(p, (574, 1104), $M$)
  t(p, (672, 1071), $a'$); t(p, (716, 1074), $b'$)
  t(p, (620, 1135), $P$); t(p, (726, 1150), $Q$)
})

#let fig-D-1-70(width: 360 * k) = px-canvas(360, 360, origin: (520, 405), width: width, (p, u) => {
  import cetz.draw: *
  // 按原图重描（V2 核对时重画）：P、Q 是两块竖直的长方形平面，交于直线 a；
  // P 的左右边 x=634、765，Q 的左右边 x=660、748；它们与 M 交于 c、b，与 N 交于 e、d。
  // 虚实按原图：被 M、N 盖住的部分、被另一块平面挡住的部分画虚线。
  // 平面 M
  pl(p, (532, 580), (625, 487), (634, 486.7)); dd(p, (634, 486.7), (765, 482.8))
  pl(p, (765, 482.8), (860, 480), (767, 575), (532, 580))
  // 平面 N
  pl(p, (542, 690), (625, 603), (634, 602.9)); dd(p, (634, 602.9), (765, 601.2))
  pl(p, (765, 601.2), (860, 600), (767, 687), (542, 690))
  // P 的上边、Q 的上边
  tk(p, (634, 422), (765, 458))
  tk(p, (660, 460), (748, 422))
  // P 的左边 x=634
  tk(p, (634, 422), (634, 512)); dd(p, (634, 512), (634, 577.8))
  tk(p, (634, 577.8), (634, 617)); dd(p, (634, 617), (634, 688.8)); tk(p, (634, 688.8), (634, 706))
  // Q 的左边 x=660
  tk(p, (660, 460), (660, 550)); dd(p, (660, 550), (660, 577.3))
  tk(p, (660, 577.3), (660, 656)); dd(p, (660, 656), (660, 688.4)); tk(p, (660, 688.4), (660, 745))
  // 交线 a（x=705）
  tk(p, (705, 441), (705, 531)); dd(p, (705, 531), (705, 576.3))
  tk(p, (705, 576.3), (705, 637)); dd(p, (705, 637), (705, 687.8)); tk(p, (705, 687.8), (705, 724.5))
  // P 的右边 x=765
  tk(p, (765, 458), (765, 548)); dd(p, (765, 548), (765, 575))
  tk(p, (765, 575), (765, 655)); dd(p, (765, 655), (765, 687)); tk(p, (765, 687), (765, 740))
  // Q 的右边 x=748（在 P 后面）
  tk(p, (748, 422), (748, 453.3)); dd(p, (748, 453.3), (748, 705))
  // P∩M（c）、Q∩M（b）
  tk(p, (634, 512), (660, 519.1)); dd(p, (660, 519.1), (705, 531)); tk(p, (705, 531), (765, 548))
  tk(p, (660, 550), (705, 531)); dd(p, (705, 531), (748, 512))
  // P∩N（e）、Q∩N（d）
  tk(p, (634, 617), (660, 624.5)); dd(p, (660, 624.5), (705, 637)); tk(p, (705, 637), (765, 655))
  tk(p, (660, 656), (705, 637)); dd(p, (705, 637), (748, 618))
  // P、Q 的下边
  tk(p, (634, 706), (660, 712.7)); dd(p, (660, 712.7), (705, 724.5)); tk(p, (705, 724.5), (765, 740))
  tk(p, (660, 745), (705, 724.5)); dd(p, (705, 724.5), (748, 705))
  t(p, (643, 440), $P$); t(p, (738, 437), $Q$); t(p, (716, 468), $a$)
  t(p, (684, 513), $c$); t(p, (723, 511), $b$); t(p, (684, 625), $e$); t(p, (725, 622), $d$)
  t(p, (567, 567), $M$); t(p, (570, 676), $N$)
})
