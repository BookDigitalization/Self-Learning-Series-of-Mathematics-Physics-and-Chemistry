  line(p(..P3), p(..Q1), p(..Q2), p(..Q3), p(..P4), stroke: lw)
  G3-tab(p, P3, Q1)
  G3-tab(p, Q1, Q2)
  G3-tab(p, Q2, Q3)
  G3-tab(p, Q3, P4)
})
