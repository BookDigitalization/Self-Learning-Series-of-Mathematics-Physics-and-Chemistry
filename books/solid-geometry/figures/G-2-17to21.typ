  L(p, 662, 951, $V$)
  L(p, 784, 952, $V_1$)
  L(p, 711, 1003, $h_1$)
  L(p, 733, 1058, $h$)
  L(p, 848, 1024, $N$)
  L(p, 862, 1110, $M$)
})

// 正五棱锥的制作图：五个侧面（虚线为折痕）、底面正五边形、粘边
#let G3-tab(p, a, b, w: 9, ins: 9) = {
  // 在线段 ab 的右侧（页面坐标 y 向下，沿 a→b 前进方向的左手边取外侧）画梯形粘边
  import cetz.draw: *
  let dx = b.at(0) - a.at(0)
  let dy = b.at(1) - a.at(1)
  let l = calc.sqrt(dx * dx + dy * dy)
  let (ux, uy) = (dx / l, dy / l)
  let (nx, ny) = (uy, -ux)
  let a2 = (a.at(0) + nx * w + ux * ins, a.at(1) + ny * w + uy * ins)
  let b2 = (b.at(0) + nx * w - ux * ins, b.at(1) + ny * w - uy * ins)
  line(p(..a), p(..a2), p(..b2), p(..b), stroke: lw)
}
#let fig-G-2-21(width: 310 * k) = px-canvas(310, 290, origin: (190, 605), width: width, (p, u) => {
