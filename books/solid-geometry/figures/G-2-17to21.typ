  import cetz.draw: *
  // 平面 M
  let M1 = (592, 1101)
  let M2 = (897, 1097)
  let M3 = (830, 1180)
  let M4 = (530, 1183)
  gpoly(p, M1, M2, M3, M4)
  // 平面 N
  gpoly(p, (617, 1013), (882, 1010), (832, 1066), (565, 1071))
  let t = 0.47
  // 左：五棱锥
  let V = (663, 965)
  let A = (586, 1133)
  let B = (622, 1169)
  let C = (690, 1153)
  let D = (712, 1121)
  let E = (645, 1110)
  let O = (664, 1128)
  for q in (A, B, C, D) { tseg(p, V, q) }
  dseg(p, V, E)
  dseg(p, V, O)
  tseg(p, A, B)
  tseg(p, B, C)
  tseg(p, C, D)
  dseg(p, D, E)
  dseg(p, E, A)
  let s = (A, B, C, D, E).map(q => lerp(V, q, t))
  tseg(p, s.at(0), s.at(1))
  tseg(p, s.at(1), s.at(2))
  tseg(p, s.at(2), s.at(3))
  dseg(p, s.at(3), s.at(4))
  dseg(p, s.at(4), s.at(0))
  // 右：四棱锥
  let V1 = (778, 972)
  let P1 = (730, 1162)
  let P2 = (828, 1153)
  let P3 = (803, 1125)
  let P4 = (745, 1126)
  let O1 = (778, 1140)
  tseg(p, V1, P1)
  tseg(p, V1, P2)
  dseg(p, V1, P3)
  dseg(p, V1, P4)
  dseg(p, V1, O1)
  tseg(p, P1, P2)
  dseg(p, P2, P3)
  dseg(p, P3, P4)
  dseg(p, P4, P1)
  let r = (P1, P2, P3, P4).map(q => lerp(V1, q, t))
  tseg(p, r.at(0), r.at(1))
