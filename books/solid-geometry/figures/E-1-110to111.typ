// 图 1·110（p.95）、1·111（p.96）；页面 200 dpi 坐标。
#import "E-base.typ": *

#let fig-E-1-110(width: 360 * k) = px-canvas(360, 190, origin: (545, 462), width: width, (p, u) => {
  import cetz.draw: *
  // 平面 M
  seg(p, (555, 648), (642, 559))
  seg(p, (555, 648), (801, 648))
  seg(p, (801, 648), (888, 561))
  seg(p, (642, 559), (650, 559))
  dseg(p, (650, 559), (785, 559))
  seg(p, (785, 559), (888, 561))
  // 平面 N
  poly(p, ((654, 501), (682, 497), (747, 482), (785, 478), (785, 598), (654, 618)), close: true)
  E-bold(p, ((682, 497), (747, 482)))
  seg(p, (682, 497), (682, 613))
  E-bold(p, ((747, 485), (702, 612)))
  seg(p, (747, 485), (747, 600))
  E-bold(p, ((654, 618), (785, 598)))
  // 直线 b：A 以左穿到平面 N 后面的一段被遮住（原图断开），画虚线
  E-bold(p, ((635, 584), (655, 595)))
  dseg(p, (655, 595), (682, 611))
  E-bold(p, ((682, 611), (733, 640)))
  lbl(p, (675, 485), $A'$, dir: "c", d: 0)
  lbl(p, (717, 476), $a$, dir: "c", d: 0)
  lbl(p, (745, 470), $E$, dir: "c", d: 0)
  lbl(p, (770, 497), $N$, dir: "c", d: 0)
  lbl(p, (692, 542), $d$, dir: "c", d: 0)
  lbl(p, (724, 596), $c$, dir: "c", d: 0)
  lbl(p, (724, 623), $b$, dir: "c", d: 0)
  lbl(p, (749, 617), $G$, dir: "c", d: 0)
  lbl(p, (677, 628), $A$, dir: "c", d: 0)
  lbl(p, (692, 638), $F$, dir: "c", d: 0)
  lbl(p, (852, 574), $M$, dir: "c", d: 0)
})

#let fig-E-1-111(width: 400 * k) = px-canvas(400, 200, origin: (470, 895), width: width, (p, u) => {
