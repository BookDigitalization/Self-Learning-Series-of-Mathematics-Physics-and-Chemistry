// 习题 1·16 第 5 题（三棱锥 O-ABC，截面 PQRS）
#let fig-C-ex1-16-5(width: 320 * k) = px-canvas(320, 215, origin: (495, 1105), width: width, (p, u) => {
  import cetz.draw: *
  let O = (646, 1126)
  let A = (573, 1251)
  let B = (679, 1282)
  let C = (740, 1240)
  let P = (661, 1197)
  let S = (692, 1181)
  let R = (660, 1245)
  let Q = (629, 1267)
  seg(p, (502, 1297), (575, 1219))
  seg(p, (502, 1297), (720, 1298))
  seg(p, (720, 1298), (792, 1222))
  seg(p, (575, 1219), (595, 1219))
  dseg(p, (595, 1219), (722, 1219))
  seg(p, (722, 1219), (792, 1222))
  C-th(p, O, A)
  C-th(p, O, B)
  C-th(p, O, C)
  C-th(p, A, B)
  C-th(p, B, C)
  dseg(p, A, C)
  // 截面 PQRS 的阴影线
  for i in range(0, 9) {
    let t = i / 8
    line(p(..C-lerp(P, Q, t)), p(..C-lerp(S, R, t)), stroke: lt)
  }
  line(p(..P), p(..S), p(..R), p(..Q), close: true, stroke: lt)
  lbl(p, (645, 1111), $O$, dir: "c", d: 0)
  lbl(p, (702, 1169), $S$, dir: "c", d: 0)
  lbl(p, (646, 1198), $P$, dir: "c", d: 0)
  lbl(p, (561, 1253), $A$, dir: "c", d: 0)
  lbl(p, (752, 1240), $C$, dir: "c", d: 0)
  lbl(p, (664, 1257), $R$, dir: "c", d: 0)
  lbl(p, (619, 1281), $Q$, dir: "c", d: 0)
  lbl(p, (681, 1297), $B$, dir: "c", d: 0)
  lbl(p, (534, 1284), $M$, dir: "c", d: 0)
})

