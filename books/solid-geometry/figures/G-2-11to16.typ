// 图 2·11、2·12（原书 p.129）、2·13、2·14（p.130）、2·15、2·16（p.131）；页面 200 dpi 坐标。
#import "G-base.typ": *

// 展开图的粘边：沿边 a→b 向外（沿 a→b 方向的右手侧，按页面看即顺时针绕行时的外侧）画一条窄梯形
#let G2tab(p, a, b, w: 8, ins: 6) = {
  import cetz.draw: *
  let dx = b.at(0) - a.at(0)
  let dy = b.at(1) - a.at(1)
  let l = calc.sqrt(dx * dx + dy * dy)
  let (ux, uy) = (dx / l, dy / l)
  let (nx, ny) = (uy, -ux)
  let a2 = (a.at(0) + nx * w + ux * ins, a.at(1) + ny * w + uy * ins)
  let b2 = (b.at(0) + nx * w - ux * ins, b.at(1) + ny * w - uy * ins)
  line(p(..a), p(..a2), p(..b2), p(..b), stroke: lw)
}

// 平行六面体：底面 a b c d（a 前左、b 前右、c 后右、d 后左），顶面 a1 b1 c1 d1；d 角的三条棱为虚线
#let G2box(p, a, b, c, d, a1, b1, c1, d1, thick: true) = {
  let s = if thick { tseg } else { (p, x, y) => seg(p, x, y) }
  s(p, a, b)
  s(p, b, c)
  s(p, a, a1)
  s(p, b, b1)
  s(p, c, c1)
  s(p, a1, b1)
  s(p, b1, c1)
  s(p, c1, d1)
  s(p, d1, a1)
  dseg(p, d, a)
  dseg(p, d, c)
  dseg(p, d, d1)
}

