// 图 1·82（原书 p.72）、1·83（p.73）、1·84（p.73）、1·85（p.74）；页面 200 dpi 坐标。
#import "D-base.typ": *

// 图 1·82：二面角（半平面 Q 在原图里用竖条纹表示）
#let fig-D-1-82(width: 240 * k) = px-canvas(240, 330, origin: (660, 850), width: width, (p, u) => {
  import cetz.draw: *
  // 半平面 P（后）
  pl(p, (700, 884), (865, 858), (862, 1058), (830, 1066))
  // 半平面 Q（前，竖条纹）
  let top(x) = 884 + (x - 700) * (935 - 884) / 130
  let bot(x) = 1100 + (x - 700) * (1135 - 1100) / 130
  for i in range(0, 66) {
    let x = 700 + i * 2
    line(p(x, top(x)), p(x, bot(x)), stroke: 0.5pt)
  }
  pg(p, (700, 884), (830, 935), (830, 1135), (700, 1100))
  tk(p, (700, 884), (700, 1100))
  t(p, (684, 882), $A$); t(p, (682, 1098), $B$); t(p, (682, 997), $a$)
  t(p, (852, 868), $P$); t(p, (818, 938), $Q$)
})

