  L(p, 672, 1043, $A$)
  L(p, 828, 1043, $B$)
  L(p, 656, 1072, $C$)
  L(p, 841, 1072, $D$)
  L(p, 750, 1083, $N$)
})

// 复习题三第 2 题：圆柱内的线段 BC 与轴 O1O
#let fig-P-rev3-2(width: 190 * k) = px-canvas(190, 400, origin: (720, 215), width: width, (p, u) => {
  import cetz.draw: *
  let (cx, rx, ry) = (816, 77, 45)
  let T = (cx, 268)
  let Bt = (cx, 545)
  P-ell(p, T, rx, ry, front: P-thick, back: P-thick)
  P-ell(p, Bt, rx, ry, front: P-thick, back: dsh)
  line(p(cx - rx, 268), p(cx - rx, 545), stroke: P-thick)
  line(p(cx + rx, 268), p(cx + rx, 545), stroke: P-thick)
  let A = (777, 268 + ry * calc.sqrt(1 - calc.pow(39 / rx, 2)))
  let B = (873, 268 + ry * calc.sqrt(1 - calc.pow(57 / rx, 2)))
  let C = (777, A.at(1) + 277)
  let D = (873, B.at(1) + 277)
  let E = P-lerp(A, B, 0.5)
  let F = P-lerp(C, D, 0.5)
  let N = P-lerp(B, C, 0.5)
  let M = (N.at(0) - (E.at(0) - cx), N.at(1) - (E.at(1) - 268))
  seg(p, A, B)
  seg(p, A, C)
  seg(p, B, D)
  seg(p, C, D)
  dseg(p, B, C)
  dseg(p, T, Bt)
  seg(p, T, E)
  seg(p, Bt, F)
  dseg(p, E, F)
  dseg(p, M, N)
  pdot(p, T, r: 2.2)
  L(p, 828, 252, $O_1$)
  L(p, 771, 296, $A$)
  L(p, 834, 290, $E$)
  L(p, 879, 282, $B$)
  L(p, M.at(0) - 14, M.at(1) - 4, $M$)
  L(p, N.at(0) + 14, N.at(1) + 10, $N$)
  L(p, 806, 558, $O$)
  L(p, F.at(0) + 12, F.at(1) - 10, $F$)
  L(p, 772, 604, $C$)
  L(p, 886, 588, $D$)
})

