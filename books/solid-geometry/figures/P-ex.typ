// 习题 3·18 第 5 题：圆锥与以它的高为直径的球
#let fig-P-ex18-5(width: 200 * k) = px-canvas(200, 215, origin: (648, 870), width: width, (p, u) => {
  import cetz.draw: *
  let O = (748, 979)
  let r = 85
  let P = (748, 894)
  let N = (748, 1064)
  let C = (668, 1064)
  let D = (828, 1064)
