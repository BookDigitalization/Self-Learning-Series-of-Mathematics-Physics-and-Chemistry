// 复习题三第 13 题：倒圆锥容器内的球（轴截面是等边三角形）
#let fig-P-rev3-13(width: 260 * k) = px-canvas(270, 230, origin: (500, 1045), width: width, (p, u) => {
  import cetz.draw: *
  let r = 66
  let s = r * 2 * calc.sqrt(3)
  let M = (636, 1064)
  let A = (636 - s / 2, 1064)
  let B = (636 + s / 2, 1064)
  let V = (636, 1064 + 3 * r)
  let O = (636, 1064 + r)
  line(p(..A), p(..B), p(..V), close: true, stroke: P-thick)
  circle(p(..O), radius: r, stroke: P-thick)
  let yc = V.at(1) - 2.463 * r
  let t = (yc - 1064) / (3 * r)
  let C = P-lerp(A, V, t)
  let D = P-lerp(B, V, t)
  dseg(p, C, D)
  dseg(p, A, O)
  let N = P-lerp(A, V, 0.5)
  dseg(p, N, O)
  dseg(p, M, V)
  L(p, A.at(0) - 11, 1064, $A$)
  L(p, 587, 1054, $R$)
  L(p, 636, 1052, $M$)
  L(p, B.at(0) + 12, 1066, $B$)
  L(p, C.at(0) - 12, yc + 5, $C$)
  L(p, D.at(0) + 13, yc + 5, $D$)
  L(p, 651, 1130, $O$)
  L(p, 611, 1153, $r$)
  L(p, N.at(0) - 12, N.at(1) + 9, $N$)
  L(p, 636, V.at(1) + 12, $V$)
})

