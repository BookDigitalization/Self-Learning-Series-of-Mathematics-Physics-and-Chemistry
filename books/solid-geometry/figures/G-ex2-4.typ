// 正四棱锥 V—ABCD 内接正方体 A1B1C1D1—A2B2C2D2：上底四顶点按定比落在侧棱上
#let fig-G-ex2-4-18(width: 300 * k) = px-canvas(300, 260, origin: (570, 538), width: width, (p, u) => {
  import cetz.draw: *
  let V = (720, 562)
  let A = (591, 773)
  let B = (768, 775)
  let C = (846, 698)
  let D = (673, 697)
  let O = isect(A, C, B, D)
  let t = 0.49
  let (A1, B1, C1, D1) = (A, B, C, D).map(q => lerp(V, q, t))
  // 下底：上底各点竖直下移 dh
  let dh = 82
  let (A2, B2, C2, D2) = (A1, B1, C1, D1).map(q => (q.at(0), q.at(1) + dh))
  let O1 = (O.at(0), (A1.at(1) + C1.at(1)) / 2)
  // 棱锥
  for q in (A, B, C) { tseg(p, V, q) }
  dseg(p, V, D)
  tseg(p, A, B)
  tseg(p, B, C)
  dseg(p, C, D)
  dseg(p, D, A)
  dseg(p, V, O)
  // 正方体
  tseg(p, A1, B1)
  dseg(p, B1, C1)
  dseg(p, C1, D1)
  dseg(p, D1, A1)
  for (a, b) in ((A1, A2), (B1, B2), (C1, C2), (D1, D2), (A2, B2), (B2, C2), (C2, D2), (D2, A2)) { dseg(p, a, b) }
  L(p, 718, 548, $V$)
  L(p, 699, 610, $D_1$)
  L(p, 798, 633, $C_1$)
  L(p, 728, 647, $O_1$)
  L(p, 634, 661, $A_1$)
  L(p, 766, 677, $B_1$)
  L(p, 684, 687, $D$)
  L(p, 859, 702, $C$)
  L(p, 677, 717, $D_2$)
  L(p, 796, 719, $C_2$)
  L(p, 724, 731, $O$)
  L(p, 652, 758, $A_2$)
  L(p, 747, 771, $B_2$)
  L(p, 582, 786, $A$)
  L(p, 768, 790, $B$)
})
