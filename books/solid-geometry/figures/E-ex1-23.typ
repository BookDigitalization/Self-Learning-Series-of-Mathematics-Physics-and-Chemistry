#import "E-base.typ": *

#let fig-E-ex1-23-5(width: 240 * k) = px-canvas(240, 240, origin: (260, 270), width: width, (p, u) => {
  import cetz.draw: *
  let Mt = (344, 279)
  let Mr = (399, 347)
  let F = (325, 476)
  let E = (273, 408)
  let P2 = (422, 400)
  let Nr = (475, 467)
  let A = (392, 401)
  let C = (392, 446)
  let B = (352, 332)
  let D = (336, 374)
  let G = (297, 437)   // BD 的延长线与 EF 的交点
  poly(p, (Mt, Mr, F, E), close: true)
  seg(p, Mr, F)
  dseg(p, E, A)
  seg(p, A, P2)
  seg(p, P2, Nr)
  seg(p, Nr, F)
  E-bold(p, (A, C))
  E-bold(p, (B, G))
  seg(p, D, C)
  dseg(p, B, A)
  lbl(p, Mt, $M$, dir: "s", d: 14)
  lbl(p, B, $B$, dir: "n", d: 10)
  lbl(p, D, $D$, dir: "nw", d: 11)
  lbl(p, A, $A$, dir: "ne", d: 11)
  lbl(p, C, $C$, dir: "sw", d: 11)
  lbl(p, E, $E$, dir: "w", d: 11)
  lbl(p, F, $F$, dir: "s", d: 11)
  lbl(p, (448, 457), $N$, dir: "c", d: 0)
})

