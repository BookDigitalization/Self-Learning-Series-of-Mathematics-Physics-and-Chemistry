// 图 6·11 两个共点力的大小不变，它们之间的夹角越大，合力越小（原书 p.178）
// 矢量示意图，按原图用 CeTZ 重绘；坐标取自 200 dpi 页面显示图（宽 1568），内部乘 1.0657 换成真实像素。
// 原图中力的箭头长短、夹角为示意，按原图位置大致描出。
#import "/common/series.typ": *

#let fig-6-11(width: 15cm) = px-canvas(1250, 270, width: width, origin: (190 * 1.0657, 95 * 1.0657), (p, u) => {
  import cetz.draw: *
  let q(x, y) = p(x * 1.0657, y * 1.0657)
  let arr(a, b, w: 1pt) = line(q(..a), q(..b), stroke: w, mark: (end: "stealth", fill: black, scale: 0.5))
  let dash(a, b) = line(q(..a), q(..b), stroke: (thickness: 0.5pt, dash: "dashed"))
  let lab(x, y, body) = content(q(x, y), anchor: "center", text(size: 8pt, body))
  let zh(x, y, body) = content(q(x, y), anchor: "center", text(font: fonts.kai, size: 8pt, body))
  // （a）θ = 0°
  lab(315, 113, $(a)$)
  arr((215, 212), (300, 212), w: 1.4pt)
  arr((300, 206), (345, 206))
  arr((345, 208), (430, 208), w: 1.4pt)
  lab(322, 177, $F_2$); lab(415, 180, $R$); lab(282, 240, $F_1$)
  zh(330, 295, [夹角 $theta = 0°$])
  // 90° > θ > 0°
  arr((475, 205), (560, 187))
  arr((475, 205), (570, 222))
  arr((475, 205), (685, 183), w: 1.4pt)
  dash((560, 187), (685, 183)); dash((570, 222), (685, 183))
  lab(543, 162, $F_1$); lab(593, 232, $F_2$); lab(642, 158, $R$)
  zh(580, 292, [$90° > theta > 0°$])
  // θ = 90°
  dash((700, 125), (828, 125)); dash((828, 125), (828, 200))
  arr((700, 200), (700, 127)); arr((700, 200), (828, 200)); arr((700, 200), (828, 127), w: 1.4pt)
  lab(672, 135, $F_1$); lab(815, 228, $F_2$); lab(805, 165, $R$)
  zh(740, 292, [$theta = 90°$])
  // 180° > θ > 90°
  arr((930, 203), (853, 162)); arr((930, 203), (1060, 203)); arr((930, 203), (985, 165), w: 1.4pt)
  dash((853, 162), (985, 165)); dash((985, 165), (1060, 203))
  lab(868, 198, $F_1$); lab(1045, 226, $F_2$); lab(985, 183, $R$)
  zh(950, 290, [$180° > theta > 90°$])
  // （b）θ = 180°
  lab(1213, 113, $(b)$)
  arr((1190, 200), (1112, 200)); arr((1190, 200), (1340, 200)); arr((1190, 200), (1262, 200), w: 1.4pt)
  arc(p(1190 * 1.0657 + 22, 200 * 1.0657), start: 0deg, stop: 180deg, radius: 22, stroke: 0.7pt)
  lab(1128, 226, $F_1$); lab(1220, 178, $R$); lab(1312, 226, $F_2$)
  zh(1255, 290, [$theta = 180°$])
})
