// 图 10·5 杠杆类简单机械的类比（原书 p.303）
// CeTZ 重绘。坐标是 render-pages.py --dpi 200 显示图（宽 1568）上的像素坐标。
// 原图 (a)(b)(c) 为杠杆，(d)(e) 为定、动滑轮，(f) 轮轴，(g) 为动滑轮的另一种画法（图中分图标号原为 a) b) 等，统一写作（a）（b）…）。
#import "/common/series.typ": *

#let fig-10-5(width: 12cm) = px-canvas(810, 860, origin: (500, 120), width: width, (p, u) => {
  import cetz.draw: *
  let lab(x, y, body) = content(p(x, y), anchor: "center", text(size: 8.5pt, body))
  let cap(x, y, c) = content(p(x, y), anchor: "center", text(size: 8.5pt)[（$#c$）])
  let arr = (end: "stealth", fill: black, scale: 0.45)
  let tri(x, y) = line(p(x - 7, y + 12), p(x, y), p(x + 7, y + 12), close: true, stroke: 0.8pt, fill: white)
  let hatch(x0, x1, y) = {
    line(p(x0, y), p(x1, y), stroke: 0.8pt)
    for x in range(x0, x1, step: 8) { line(p(x, y), p(x + 6, y - 7), stroke: 0.5pt) }
  }
  let dash = (thickness: 0.6pt, dash: "dashed")

  // (a)
  line(p(535, 232), p(745, 232), stroke: 1.4pt)
  tri(603, 235)
  lab(538, 213, $B$); lab(603, 212, $O$); lab(740, 207, $A$)
  line(p(535, 232), p(535, 385), stroke: 1pt, mark: arr); lab(558, 372, $G$)
  line(p(745, 232), p(745, 305), stroke: 1pt, mark: arr); lab(726, 293, $F$)
  cap(635, 383, $a$)
  // (b)
  line(p(535, 513), p(745, 513), stroke: 1.4pt)
  tri(535, 516)
  lab(543, 492, $O$); lab(606, 492, $B$); lab(743, 530, $A$)
  line(p(745, 513), p(745, 463), stroke: 1pt, mark: arr); lab(763, 465, $F$)
  line(p(603, 513), p(603, 665), stroke: 1pt, mark: arr); lab(621, 652, $G$)
  cap(683, 652, $b$)
  // (c)
  line(p(535, 818), p(750, 818), stroke: 1.4pt)
  tri(540, 806)
  lab(517, 826, $O$); lab(663, 841, $A$); lab(768, 812, $B$)
  line(p(663, 818), p(663, 690), stroke: 1pt, mark: arr); lab(686, 697, $F$)
  line(p(750, 818), p(750, 892), stroke: 1pt, mark: arr); lab(773, 878, $G$)
  cap(655, 902, $c$)
  // (d) 定滑轮
  hatch(880, 908, 160)
  line(p(893, 160), p(893, 248), stroke: 1pt)
  circle(p(893, 248), radius: 42 * u, stroke: 1pt)
  line(p(851, 248), p(935, 248), stroke: dash)
  lab(840, 218, $B$); lab(893, 252, $O$); lab(957, 220, $A$)
  line(p(851, 248), p(851, 350), stroke: 1pt, mark: arr); lab(832, 333, $G$)
  line(p(935, 248), p(935, 340), stroke: 1pt, mark: arr); lab(957, 332, $F$)
  cap(897, 378, $d$)
  // (e) 动滑轮
  hatch(843, 871, 428)
  line(p(857, 428), p(857, 520), stroke: 1pt)
  circle(p(900, 520), radius: 43 * u, stroke: 1pt)
  line(p(857, 520), p(943, 520), stroke: dash)
  line(p(943, 520), p(943, 462), stroke: 1pt, mark: arr); lab(963, 456, $F$)
  lab(838, 524, $O$); lab(900, 500, $B$); lab(961, 517, $A$)
  line(p(900, 520), p(900, 665), stroke: 1pt, mark: arr); lab(921, 655, $G$)
  cap(962, 667, $e$)
  // (f) 轮轴
  hatch(1124, 1156, 117)
  line(p(1140, 117), p(1140, 230), stroke: 1pt)
  circle(p(1140, 230), radius: 93 * u, stroke: 1pt)
  circle(p(1140, 230), radius: 47 * u, stroke: 1pt)
  line(p(1093, 230), p(1233, 230), stroke: dash)
  line(p(1140, 230), p(1178, 205), stroke: 0.8pt, mark: arr)
  line(p(1140, 230), p(1220, 283), stroke: 0.8pt, mark: arr)
  lab(1160, 188, $r_1$); lab(1188, 275, $r_2$)
  lab(1080, 218, $B$); lab(1133, 252, $O$); lab(1251, 216, $A$)
  line(p(1093, 230), p(1093, 385), stroke: 1pt, mark: arr); lab(1076, 362, $G$)
  line(p(1233, 230), p(1233, 305), stroke: 1pt, mark: arr); lab(1251, 297, $F$)
  cap(1148, 382, $f$)
  // (g)
  circle(p(1147, 815), radius: 45 * u, stroke: 1pt)
  line(p(1102, 815), p(1192, 815), stroke: dash)
  line(p(1102, 815), p(1102, 890), stroke: 1pt)
  hatch(1086, 1118, 892)
  line(p(1147, 770), p(1147, 668), stroke: 1pt, mark: arr); lab(1170, 677, $F$)
  lab(1088, 810, $O$); lab(1208, 806, $B$); lab(1146, 826, $A$)
  line(p(1192, 830), p(1192, 858), stroke: 0.8pt, mark: arr); lab(1208, 868, $G$)
  cap(1155, 915, $g$)
})
