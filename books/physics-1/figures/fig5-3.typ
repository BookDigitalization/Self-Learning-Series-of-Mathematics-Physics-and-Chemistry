// 图 5·3 匀加速直线运动 / 匀减速直线运动示意图（原书 p.133）
// 线条图，按原图重绘（比例为示意）。坐标取自裁剪图（原页显示图 (380,770) 起，×2.1314）的像素坐标，画布 2175×853。
#import "/common/series.typ": *

#let fig-5-3(width: 14cm) = px-canvas(2175, 853, width: width, (p, u) => {
  import cetz.draw: *
  let kai(x, y, body) = content(p(x, y), anchor: "center", text(font: fonts.kai, size: 8.5pt, body))
  let var(x, y, body) = content(p(x, y), anchor: "center", text(size: 9pt, body))
  let mk = (end: "stealth", fill: black, scale: 0.4)
  let arr(a, b, w: 0.8pt, dash: none) = line(p(..a), p(..b), stroke: (thickness: w, dash: dash), mark: mk)
  let dbl(a, b, w: 0.7pt) = line(p(..a), p(..b), stroke: (thickness: w, dash: "dashed"), mark: (start: mk, end: mk))
  let tick(x, y0, y1, w: 0.7pt, dash: none) = line(p(x, y0), p(x, y1), stroke: (thickness: w, dash: dash))

  // ── （a）每 1 秒速度增加 1 个 a ──
  line(p(60, 97), p(2110, 97), stroke: 0.7pt)
  arr((2000, 97), (2125, 97), w: 1.6pt)
  arr((60, 97), (135, 97), w: 1.6pt)
  arr((345, 97), (520, 97), w: 1.6pt)
  arr((855, 97), (1090, 97), w: 1.6pt)
  arr((1565, 97), (1895, 97), w: 1.6pt)
  var(60, 48, $A$); var(185, 58, $v_0$)
  var(330, 45, $B$); var(435, 48, $v_1$)
  var(830, 55, $C$); var(985, 55, $v_2$)
  var(1555, 55, $D$); var(1735, 58, $v_3$)
  // 分量：v0 与 a、2a、3a
  tick(345, 100, 160, w: 1.4pt)
  arr((345, 140), (455, 140))
  arr((455, 140), (530, 140), dash: "dashed")
  var(405, 185, $v_0$); var(490, 185, $a$)
  tick(855, 100, 160, dash: "dotted")
  arr((855, 140), (965, 140))
  arr((965, 140), (1110, 140), dash: "dashed")
  var(915, 190, $v_0$); var(1040, 185, $2 a$)
  tick(1680, 100, 160, dash: "dashed"); tick(1905, 100, 160, dash: "dashed")
  arr((1565, 143), (1680, 143))
  arr((1680, 143), (1905, 143), dash: "dashed")
  var(1630, 190, $v_0$); var(1790, 185, $3 a$)
  arr((1265, 245), (1360, 245), w: 1.6pt)
  var(1300, 212, $a$)
  kai(2030, 160, [运动方向])
  kai(1130, 330, [（$a$）每 1 秒速度增加 1 个“$a$”])

  // ── （b）每 1 秒速度减少 1 个 a ──
  line(p(30, 595), p(2110, 603), stroke: 0.7pt)
  arr((2000, 603), (2125, 603), w: 1.6pt)
  arr((260, 595), (370, 595), w: 1.6pt)
  arr((850, 598), (1075, 598), w: 1.6pt)
  arr((1400, 603), (1560, 603), w: 1.6pt)
  var(30, 540, $A$); var(310, 540, $v_0$)
  var(830, 548, $B$); var(1005, 552, $v_1$)
  var(1385, 555, $C$); var(1510, 555, $v_2$)
  var(1715, 570, $D$)
  // B：v0 = v1 + a
  tick(828, 620, 655); tick(1160, 620, 655)
  arr((828, 637), (1160, 637))
  var(990, 640, $v_0$)
  tick(1085, 665, 700); tick(1160, 665, 700)
  dbl((1085, 685), (1160, 685))
  var(1130, 722, $a$)
  // C：v0 = v2 + 2a
  tick(1385, 625, 660); tick(1730, 625, 660)
  arr((1385, 645), (1730, 645))
  var(1515, 648, $v_0$)
  tick(1570, 655, 700); tick(1730, 655, 700)
  dbl((1570, 688), (1730, 688))
  var(1650, 735, $2 a$)
  // D：v0 = v3 + 3a
  tick(1745, 540, 625, dash: "dashed")
  arr((1750, 570), (1840, 570))
  arr((1845, 572), (2085, 572))
  var(1915, 572, $v_0$)
  tick(2085, 510, 620, w: 1.6pt)
  tick(1840, 510, 545, dash: "dashed"); tick(2070, 510, 545, dash: "dashed")
  dbl((1840, 525), (2070, 525))
  var(1980, 490, $3 a$)
  var(1840, 662, $v_3$)
  arr((630, 710), (490, 710), w: 1.6pt)
  var(580, 675, $a$)
  kai(2010, 675, [运动方向])
  kai(1130, 780, [（$b$）每 1 秒速度减少 1 个“$a$”])
})
