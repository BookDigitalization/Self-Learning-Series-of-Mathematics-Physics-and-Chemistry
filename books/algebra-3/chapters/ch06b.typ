#let rtab(ncol, inset: (x: 5pt, y: 6pt), ..cells) = {
  let cs = cells.pos()
  let m = calc.ceil(cs.len() / ncol)
  align(center, table(
    columns: ncol,
    align: center + horizon,
    inset: inset,
    fill: none,
