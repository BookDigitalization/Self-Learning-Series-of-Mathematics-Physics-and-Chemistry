#import "/common/series.typ": *
#import "/books/algebra-3/figures/fig4B-parab.typ": fig-4-10, fig-4-11, fig-4-12, fig-4-13, fig-4-14
#import "/books/algebra-3/figures/fig4B-geom.typ": fig-4-15, fig-4-16, fig-4-17, fig-ex45-1, fig-ex45-2

// 局部：值表。模板把表格第一行设成白字配深色表头，这里不用表头底色，首行显式改回黑字；
// 上下粗线、行间细线、列间细线，仿原书表格。
#let rtab(ncol, inset: (x: 6pt, y: 6pt), ..cells) = {
  let cs = cells.pos()
  let m = calc.ceil(cs.len() / ncol)
  align(center, table(
    columns: ncol,
    align: center + horizon,
    inset: inset,
    fill: none,
    stroke: (x, y) => (
      left: if x >= 1 { 0.5pt } else { none },
      top: if y == 0 { 1.2pt } else { 0.5pt },
      bottom: if y == m - 1 { 1.2pt } else { none },
    ),
    ..cs.enumerate().map(((i, c)) => if i < ncol { text(fill: black, c) } else { c }),
  ))
}


// 局部：方程组，大括号 + 各行 + 右侧标注。tsys：标注（如 (1)）靠右排；psys：标注是紧跟在各行后面的文字说明。
#let brace(n) = math.equation(block: false, $lr(\{ #v(1.25em * n))$)
#let tsys(..rows) = {
  let rs = rows.pos()
  let n = rs.len()
  block(width: 100%, above: 1em, below: 1em, breakable: false, {
    set par(first-line-indent: 0em)
    grid(
      columns: (1fr, auto, auto, 1fr),
      column-gutter: 0.4em, row-gutter: 0.7em,
      align: (left, left + horizon, left + horizon, right + horizon),
      grid.cell(x: 1, y: 0, rowspan: n, brace(n)),
      ..rs.enumerate().map(((i, r)) => (
        grid.cell(x: 2, y: i, math.equation(block: false, r.at(0))),
        grid.cell(x: 3, y: i, r.at(1)))).flatten()
    )
  })
}
#let psys(..rows) = {
  let rs = rows.pos()
  let n = rs.len()
  block(width: 100%, above: 1em, below: 1em, breakable: false, {
    set par(first-line-indent: 0em)
    align(center, grid(
      columns: (auto, auto, auto),
      column-gutter: 0.5em, row-gutter: 0.7em,
      align: left + horizon,
      grid.cell(x: 0, y: 0, rowspan: n, brace(n)),
      ..rs.enumerate().map(((i, r)) => (
        grid.cell(x: 1, y: i, math.equation(block: false, r.at(0))),
        grid.cell(x: 2, y: i, r.at(1)))).flatten()
    ))
  })
}
// p.153
== 二次函数图像的作法

在 §4·2 里，为了要说明二次函数 $y = a x^2 + b x + c$ $(a != 0)$ 的图像是一条抛物线，所以先作出二次函数 $y = x^2$ 的图像，在这基础上一步一步地推出一般的二次函数 $y = a x^2 + b x + c$ 的图像。但是，在实际作图的时候，却可以不必套用这种方法。我们只需找出抛物线的对称轴和顶点，然后再找出抛物线上的几个点，就可以相当精确地把抛物线画出。下面我们/* p.154 */举几个例子来说明这种作法。

#ex("例 1")[作函数 $y = x^2 - x + 2$ 的图像。]

// 原书作“根据 §4·3 里的结论”（该结论在 §4·2，p.152），照录
#sol[$y = x^2 - x + 2 = (x - 1/2)^2 + mx(1, 3, 4) ju$

根据 §4·3 里的结论，我们知道这条抛物线的对称轴是直线 $x = 1/2$，顶点是 $A(1/2, mx(1, 3, 4))$。

列表：

#rtab(8,
  $x$, $1/2$, $1$, $mx(1, 1, 2)$, $2$, $mx(2, 1, 2)$, $3$, $dots.c$,
  $x - 1/2$, $0$, $1/2$, $1$, $mx(1, 1, 2)$, $2$, $mx(2, 1, 2)$, $dots.c$,
  $(x - 1/2)^2$, $0$, $1/4$, $1$, $9/4$, $4$, $25/4$, $dots.c$,
  $y$, $mx(1, 3, 4)$, $2$, $mx(2, 3, 4)$, $4$, $mx(5, 3, 4)$, $8$, $dots.c$,
)

把表里的每一对实数 $(x, y)$ 作为点的坐标，作出这些点，并且用平滑的线连接起来，就得到抛物线 $y = x^2 - x + 2$ 在对称轴右边的一个部分。

因为抛物线 $y = x^2 - x + 2$ 是对称于对称轴的，利用这个性质就可以画出抛物线在对称轴左边的部分（图 4·10）。]

#fig("4·10", fig-4-10())[]

// 原书注里写作 y=(x−1/2)²+3/4（上文是 1 3/4，即 7/4），照扫描录入
#note-small[作图时也可以不先把二次函数 $y = x^2 - x + 2$ 用配方法改写成 $y = (x - 1/2)^2 + 3/4$ 的形式，而直接应用第 152 页里的结论。这里/* p.155 */

$ a = 1 dou quad b = -1 dou quad c = 2 ju $

$ therefore quad -b/(2a) = 1/2 dou quad (4 a c - b^2)/(4 a) = mx(1, 3, 4) ju $

因此抛物线的对称轴是直线 $x = 1/2$，顶点是 $A(1/2, mx(1, 3, 4))$。

从 $x = 1/2$ 起，取 $x$ 的一些适当值，算出函数的对应值，列成下表：

#rtab(7,
  $x$, $1/2$, $1$, $3/2$, $2$, $5/2$, $3$,
  $y$, $mx(1, 3, 4)$, $2$, $mx(2, 3, 4)$, $4$, $mx(5, 3, 4)$, $8$,
)

以下就按照上面解法中的步骤来做。]

#ex("例 2")[作函数 $y = 3 - 4x - 2x^2$ 的图像。]

#sol[(1) 这里 $a = -2, b = -4, c = 3$。

$ -b/(2a) = -(-4)/(2(-2)) = -1 dou $

$ (4 a c - b^2)/(4 a) = (4(-2) dot 3 - (-4)^2)/(4(-2)) = 5 ju $

所以抛物线的对称轴是直线 $x = -1$，顶点是 $(-1, 5)$。

(2) 列表：

#rtab(2,
  $x$, $y$,
  $-1$, $5$,
  $0$, $3$,
  $1/2$, $1/2$,
  $1$, $-3$,
  $mx(1, 1, 2)$, $-mx(6, 1, 2)$,
  $dots.c$, $dots.c$,
)

(3) 作图：]

#fig("4·11", fig-4-11())[]

