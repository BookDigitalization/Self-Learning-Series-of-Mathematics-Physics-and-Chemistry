      top: if y == 0 { 1.2pt } else { 0.5pt },
      bottom: if y == m - 1 { 1.2pt } else { none },
    ),
    ..cs.enumerate().map(((i, c)) => if i < ncol { text(fill: black, c) } else { c }),
  )))
}

