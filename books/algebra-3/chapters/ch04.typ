// 上下粗线、行间细线、列间细线，仿原书表格。ncol 为列数。
#let rtab(ncol, inset: (x: 5pt, y: 6pt), ..cells) = {
  let cs = cells.pos()
  let m = calc.ceil(cs.len() / ncol)
  align(center, block(breakable: false, above: 1em, below: 1em, table(
