// 第 3 章 整式（原书 p.95–136 为本文件：§3·1–§3·7；§3·8 起（p.136–）见 ch03b.typ）
#import "/common/series.typ": *

// 同类项下面的横线记号（p.103 例 4）：x⁴ 项一横，x³ 项虚线，x² 项两横
#let ul1(b) = underline(offset: 2.5pt, b)
#let ul2(b) = underline(offset: 4.5pt, underline(offset: 2.5pt, b))
#let ul3(b) = underline(offset: 2.5pt, stroke: (paint: black, thickness: 0.6pt, dash: "dashed"), b)

// 直式（竖式）：每行 n 列项，cells 为各列内容（空列写 []）；op 为横线右侧的运算符号如 [(＋]；
// lab 为行末标号；lines 为“在第 i 行之前画横线”的行号（0 起计）。
#let vgrid(n, rows, lines: ()) = {
  let ch = ()
  for (i, r) in rows.enumerate() {
    if i in lines { ch.push(grid.hline(y: i, end: n, stroke: 0.5pt)) }
    for c in r.cells { ch.push(c) }
    for _ in range(n - r.cells.len()) { ch.push([]) }
    ch.push(align(left, r.at("op", default: [])))
    ch.push(align(left, r.at("lab", default: [])))
  }
  align(center, block(above: 0.8em, below: 0.8em, breakable: false, grid(
    columns: (auto,) * (n + 2),
    align: center + horizon,
    column-gutter: 0.4em,
    row-gutter: 0.55em,
    ..ch,
  )))
}
// 简单直式（加减法）：vert(op, ..rows)，每行是一个数组，最后一行为结果，横线在结果之前。
#let vert(op, ..rows) = {
  let rs = rows.pos()
  let n = rs.fold(0, (m, r) => calc.max(m, r.len()))
  let items = rs.enumerate().map(((i, r)) => (
    cells: r + ([],) * (n - r.len()),
    op: if i == rs.len() - 1 { op } else { [] },
  ))
  vgrid(n, items, lines: (rs.len() - 1,))
}

= 整式

// p.95
在上一章里，我们已经学习了代数式。现在我们要进一步学习有关代数式的运算。在这一章里，我们先研究整式。

== 整式

我们已经碰到过许多代数式了。例如 $3a, x+y, a^2+b^2, ((a+b)h)/2, 1/a, (x-y)/(x+y), 2(a b+a c+b c)$ 等等，都是代数式。在这些代数式里，包含的运算总不外乎加、减、乘、除和乘方等五种。这样的代数式叫作*有理代数式*，简称*有理式*。

有理式 $3a, x+y, a^2+b^2, ((a+b)h)/2, 2(a b+a c+b c)$ 等，#edot[或者没有除法，或者虽然有除法但除数里不含有字母]，这样的#edot[有理式]叫作*有理整式*，简称*整式*。

有理式 $1/a, (x-y)/(x+y)$ 等，#edot[不但有除法，而且除数里还含有字母]，这样的#edot[有理式]叫作*有理分式*，简称*分式*。

== 单项式

*1. 单项式的概念* 看下面的一些整式：$3, -1/2, a, -3a^2, +1/3 a^3 b^2 c, -1/5 x^2 y^3$。这些整式，有一个共同的特点，/* p.96 */就是没有加减运算。这里虽然有一些“+”“-”号，但都是性质符号，不是加减法的运算符号。这些整式，叫作单项式；那就是说：

#edot[没有加减运算的整式]叫作*单项式*。

像整式 $3x+5y$ 就不是单项式，因为这里有加法运算，像代数式 $b/a$ 也不是单项式，因为 $b/a$ 不是整式。

*2. 系数* 在代数式 $3a$ 里，$3a$ 是数字因数 $3$ 与字母因数 $a$ 的积；在代数式 $-5x$ 里，$-5x$ 是数字因数 $-5$ 与字母因数 $x$ 的积；在代数式 $2/3 a^2 x$ 里，$2/3 a^2 x$ 是数字因数 $2/3$ 与字母部分的因数 $a^2 x$ 的积。我们把数字部分的因数叫作字母部分因数的*数字系数*，简称*系数*。

例如：在 $3a$ 里，$3$ 是 $a$ 的系数；

#h(2em)在 $-5x$ 里，$-5$ 是 $x$ 的系数；

#h(2em)在 $2/3 a^2 x$ 里，$2/3$ 是 $a^2 x$ 的系数。

#note-small[1. 代数式 $a$ 就是 $1$ 与 $a$ 的积，所以 $a$ 的系数是 $1$，同样的在 $a^2 x^3$ 里，$a^2 x^3$ 的系数也是 $1$；在 $-a b c$ 里，$a b c$ 的系数是 $-1$，不要把 $a$ 的系数说成是零，也不要把 $-a b c$ 的系数说成是负号。

2. 在将来，我们还可以把一个或几个字母作为主要字母，而把其他字母因数也作为系数或系数的一部分，例如我们可以把 $x$ 作为主要字母，在 $a x$ 里，将 $a$ 看作 $x$ 的系数，在 $-3a^2 x^3$ 里，将 $-3a^2$ 看作 $x^3$ 的系数；又如我们可以把 $x$ 与 $y$ 作为主要字母，在 $3a x^2 y$ 里，将 $3a$ 看作 $x^2 y$ 的系数等。所以系数是对特定的字母来说的。在现在，我们还只讲数字的系数。]

*3. 幂* 在 §1·18 里讨论有理数的乘方运算时，我们已讲过底数、指数这些名词了。对于含有字母的式子来说，这些名词仍具有同样的意义。例如 $a^3$ 就叫作 $a$ 的三次方，底数是/* p.97 */$a$，指数是 $3$，而 $a^3$ 就是 $a dot a dot a$ 的简写。$a^3$ 也叫作 $a$ 的三次*幂*。同样，$x^5$ 叫作 $x$ 的五次方或五次幂，这里底数是 $x$，指数是 $5$，而 $x^5$ 就是 $x dot x dot x dot x dot x$ 的简写。一般说来，

$ a^n = underbrace(a dot a dot a dots.c a, "一共有" n "个") class("normal", "，") $

这里底数是 $a$，指数是 $n$，#edot[$n$ 是任意自然数]，$a^n$ #edot[读作 $a$ 的 $n$ 次方或 $a$ 的 $n$ 次幂]。

#note-small[$a$ 也是一个幂，叫作 $a$ 的一次幂或一次方，这里指数是 $1$。指数是 $1$ 时，不必写出来。反过来说，不写出来的指数就是 $1$，不要说 $a$ 没有指数，或者说它的指数是 $0$。]

*4. 单项式的次数* 看单项式 $-3x^4, 2x^3, a^2 b c, 1/2 x^3 y, -5, a x^2, +1/2, a$。这些单项式里，有的只有一个字母，有的有两个字母，有的有三个字母，有的只有数字没有字母；各个字母的指数也有是 $1$ 的，也有是 $2$ 的，也有是 $3$ 的或者是 $4$ 的。我们把一个单项式里各个字母的指数的和叫作这个*单项式关于这些字母的次数*。例如 $-3x^4$ 是关于 $x$ 的四次单项式，或者简称四次式；$2x^3$ 是关于 $x$ 的三次单项式；$a^2 b c$ 是关于字母 $a, b, c$ 的四次单项式(因为这里 $a$ 的指数是 $2$，$b$ 和 $c$ 的指数各是 $1$，而它们的指数的和是 $2+1+1=4$)；$1/2 x^3 y$ 是关于 $x$ 与 $y$ 的四次单项式；$a x^2$ 是关于 $a$ 与 $x$ 的三次单项式；$a$ 是关于 $a$ 的一次单项式。单项式 $-5$ 与 $+1/2$，都只有数字没有字母，叫作零次单项式。

#note-small[有时我们只把一个或几个字母作为主要字母，根据这几个字母的指数来计算单项式的次数。例如 $a x^2$ 可以看作是关于 $x$ 的二次单项式，而把 $a$ 作为主要字母 $x^2$ 的系数，又如 $3a x^2 y$ 可以看作是关于 $x$ 与 $y$ 的三次单项式，$3a$ 可以当作 $x^2 y$ 的系数。]

// p.98
*5. 单项式的整理* 单项式的整理，一般包括两个内容：

(i) 排列各因数的前后次序：一个单项式可以包含几个因数，有数字的，也有字母的。因为字母表示的也是数，所以可根据乘法交换律，把这些因数的前后次序，互相调换。在习惯上，我们总把数字因数连同性质符号写在最前面，各个字母的前后次序，一般按照拉丁字母的前后次序(也就是拼音字母的次序)排列。

#example("例 1.")[整理单项式：(1) $a 3$；(2) $b^3 5a$；(3) $-x 1/3 a^2$。]

#sol[整理后得：(1) $3a$；(2) $5a b^3$；(3) $-1/3 a^2 x$。]

(ii) #edot[相同的字母因数，应该用指数表示成一个幂]。

#example("例 2.")[整理单项式：(1) $3a a a$；(2) $-3a b a b a b a$。]

#analysis[根据相同因数可以写成幂的形式，$a a a$ 可以写作 $a^3$。根据乘法交换律，$-3a b a b a b a$ 可以写成 $-3a a a a b b b$，再根据相同因数可以写成幂的形式，$a a a a$ 可以写作 $a^4$，$b b b$ 可以写作 $b^3$。]

#sol[整理后得：(1) $3a^3$；(2) $-3a^4 b^3$。]

#exercise("3·2")[
  1. 在下列代数式中，说明哪些是整式，哪些是分式，哪些是单项式：

  (1) $3$；(2) $-5x y$；(3) $+1/3 a x^5$；(4) $a+b$；(5) $3/x$；(6) $2x^2+5$；(7) $1/3 x^2-7$；(8) $(a-b)/(a+b)$；(9) $-x^3+2x-5$；(10) $(3b^2)/a$。

  2. 说出下列各代数式里的系数：

  (1) $3a$；(2) $-5a b^3$；(3) $x$；(4) $-a^2$；(5) $1/2 a^2 b^4$；(6) $-2/3 x^2 y$；(7) $0.3x$；(8) $-1.5a^4$。

  ［解法举例：在 $3a$ 里，$a$ 的系数是 $3$。］

  3. 说出下列代数式里各个字母的指数：/* p.99 */

  (1) $5a^2 b^4 x$；(2) $-7a x^4$；(3) $1/3 x^2 y^5$；(4) $6a b c y^3$。

  ［解法举例：在 $5a^2 b^4 x$ 里，$a$ 的指数是 $2$，$b$ 的指数是 $4$，$x$ 的指数是 $1$。］

  4. 说出下列各单项式的次数：

  (1) $-5a$；(2) $a^2 b^3$；(3) $4x^2$；(4) $-1/2 x^3 y^2 z$。

  ［解法举例：$-5a$ 是一次单项式。］

  5. 整理下列各单项式：

  (1) $a 4$；(2) $a b a$；(3) $5a x x a a$；(4) $a 1/2 x b a b x$。
]

== 多项式

*1. 多项式的概念* 让我们来观察下面这些代数式：

$ a+3, quad x-y, quad -x^2+x y+3y^2, quad 1/3 x^3-2x^2+1/2 x-5 class("normal", "。") $

这些代数式里，因为都没有用字母作除数，所以它们都是整式，但是它们都含有加减运算符号，所以它们都不是单项式。

我们可以把这些代数式看作是几个单项式的代数和，例如：

$a+3$ 是 $a$ 和 $+3$ 的代数和；

$x-y$ 是 $x$ 和 $-y$ 的代数和；

$-x^2+x y+3y^2$ 是 $-x^2$，$+x y$ 和 $+3y^2$ 的代数和；

$1/3 x^3-2x^2+1/2 x-5$ 是 $1/3 x^3$，$-2x^2$，$+1/2 x$ 和 $-5$ 的代数和。

我们把#edot[几个单项式的代数和]叫作*多项式*。

*2. 多项式的项* 在多项式里的每一个单项式，叫作这个多项式的*项*。根据多项式里所含有的项的个数，就叫这个多项式是几项式。例如，在上面这些多项式里，/* p.100 */$a+3$ 和 $x-y$ 都是二项式；

$-x^2+x y+3y^2$ 是三项式；

$1/3 x^3-2x^2+1/2 x-5$ 是四项式。

#attention[多项式中的项，是包括它前面的正负号的。例如 $x-y$ 的两项是 $x$ 和 $-y$，不能说是 $x$ 和 $y$。]

*3. 多项式的次数* 在二项式 $a+3$ 里，第一项 $a$ 的次数是 $1$，我们把它叫作一次项，$+3$ 没有字母，我们把它叫作*常数项*(或者叫作零次项)，这里次数最高的项是一次项。

在三项式 $3x^2-5x-1$ 里，第一项 $3x^2$ 的次数是 $2$，我们把它叫作二次项，$-5x$ 是一次项，$-1$ 是常数项，这里次数最高的项是二次项。

在四项式 $-3x^3+2x^2-1/2 x+5$ 里，次数最高的项是三次项 $-3x^3$。

我们把一个多项式里次数最高的项的次数，叫作这个*多项式的次数*。多项式的次数是几的，就叫作几次多项式。

例如：$a+3$ 是一次式；

#h(2em)$3x^2-5x-1$ 是二次式；

#h(2em)$-3x^3+2x^2-1/2 x+5$ 是三次式。

又如：$x^3-x^2 y+x y^2-y^3$，它的四项的次数都是 $3$，它是关于 $x$ 与 $y$ 的三次式。

*4. 多项式的整理* 为了便于运算，通常我们总要把一个多项式，按照一定的次序，整理成整齐而简洁的形式。多项式的整理，一般包括两个内容。

(i) #edot[排幂]：我们来看多项式

$ x^2-2-5x+3x^3 class("normal", "，") $

它是四个单项式 $x^2, -2, -5x, +3x^3$ 的代数和。这里第一项/* p.101 */的次数是 $2$，第二项是常数项(或者说它的次数是 $0$)，第三项的次数是 $1$，第四项的次数是 $3$。为了把它整理成整齐形式，通常我们应该按照各项次数从大到小或者从小到大的顺序，把它们重行排列起来。这种整理方法叫作*排幂*。例如：

多项式 $x^2-2-5x+3x^3$ 可以重行排列成

#eqn("1", $3x^3+x^2-5x-2$)

或者

#eqn("2", $-2-5x+x^2+3x^3$)

两种形式。

#note-small[在有理数这一章里，我们已经知道，在加法运算中，可以交换加数的前后次序(加法交换律)。代数式里的字母都表示数，每个单项式表示的也就是数，所以我们可以像有理数加法一样，交换多项式里各项的先后次序。]

我们看到，在 (1) 中，各项是按照字母 $x$ 的幂的指数从大到小的顺序来排列的，这种排列方法，叫作按这个字母的*降幂排列*；在 (2) 中，各项是按照字母 $x$ 的幂的指数从小到大的顺序来排列的，这种排列方法，叫作按这个字母的*升幂排列*。

#example("例 1.")[依照 $x$ 的降幂排列，整理下列两个多项式：

(1) $x^2-2-5x^4+3x^3$；

(2) $3-4x+5x^6-4x^5+x^2-x^3$。]

#sol[整理后，得

(1) $-5x^4+3x^3+x^2-2$；

(2) $5x^6-4x^5-x^3+x^2-4x+3$。]

#attention[多项式中的项，是包括它前面的性质符号的。在排幂时，每一项的性质符号仍须看作是这一项的一个部分而一起移动。如果原来的第一项省略掉性质符号“+”，搬到后面时就要补上这个“+”号；如果原来的中间项搬到第一项而性质符号是正的，也可以省略掉这一“+”号，但性质符号“-”不能省略。]

// p.102
#example("例 2.")[按 $a$ 的降幂排列整理下列多项式：

(1) $a^3-3a b^2+5b^3-6a^2 b$；(2) $-3a b+b^2-3a^2$。]

#sol[整理后，得

(1) $a^3-6a^2 b-3a b^2+5b^3$；(2) $-3a^2-3a b+b^2$。]

#example("例 3.")[按 $x$ 的升幂排列整理下列多项式：

(1) $x^2-3x^3+5x-7$；#h(3em)\(2) $y^3-3x^2 y+2x y^2+x^3$。]

#sol[整理后，得

(1) $-7+5x+x^2-3x^3$；#h(3em)\(2) $y^3+2x y^2-3x^2 y+x^3$。]

(ii) #edot[合并同类项]：我们来看多项式

$ 3a^2 b-5a b^2+3a^2 b+a b^2+a^2 b^2 class("normal", "。") $

它是五个单项式 $3a^2 b, -5a b^2, +3a^2 b, +a b^2, +a^2 b^2$ 的代数和。这些单项式都只含有两个字母，就是 $a$ 和 $b$，并且：

第一项 $3a^2 b$ 和第三项 $3a^2 b$，$a$ 的幂的指数都是 $2$，$b$ 的幂的指数都是 $1$，系数也相同，这两个项是完全一样的。

第二项 $-5a b^2$ 和第四项 $a b^2$，$a$ 的幂的指数都是 $1$，$b$ 的幂的指数都是 $2$，这二项里只有系数不相同。

多项式里具有这种性质的两个或几个项，叫作*同类项*。例如第一项 $3a^2 b$ 和第三项 $3a^2 b$ 是同类项，第二项 $-5a b^2$ 和第四项 $a b^2$ 也是同类项。一般地说，

#edot[多项式里的某些项，如果彼此完全没有差别，或者彼此只有系数不同，那么这些项就叫作]*同类项*。

常数项和常数项也是同类项。

#attention[多项式里的两个项虽然所含字母相同，但是相同字母的幂的指数不同，就不是同类项。例如 $3a^2 b$ 和 $3a b^2$ 就不是同类项，$3a^2 b$ 和 $3a^2 b^2$ 也不是同类项。]

在一个多项式里，同类项可以根据乘法对于加法的分配律，把它们合并成一项，
/* p.103 */例如：

$ 3a^2 b + 3a^2 b &= 3 times a^2 b + 3 times a^2 b \
  &= (3+3) times a^2 b = 6a^2 b； \
  -5a b^2 + a b^2 &= -5 times a b^2 + 1 times a b^2 \
  &= (-5+1) times a b^2 = -4a b^2； $

因此，根据加法的交换律和结合律，上面所提出的这个多项式可以写成

$ (3a^2 b + 3a^2 b) + (-5a b^2 + a b^2) + a^2 b^2 class("normal", "。") $

再合并同类项，把它化简成

$ 6a^2 b - 4a b^2 + a^2 b^2 class("normal", "。") $

把多项式里的同类项合并成一项，叫作*合并同类项*，从上面的例子得到*合并同类项法则*：#edot[合并同类项]，#edot[只要把系数相加]，#edot[所得的和作为系数]\(#edot[字母部分连同它们原来的指数仍旧不变]\)。

#example("例 4.")[整理下列多项式：

$ 5x^4 - 3x^2 + 6 - 7x^3 + 12x^4 + 10x^3 + 2x^2 - 3x^3 + 7 + 10x class("normal", "。") $]

#sol[先按 $x$ 的降幂排列，再合并同类项：

$ & #ul1[$5x^4$] - #ul2[$3x^2$] + 6 - #ul3[$7x^3$] + #ul1[$12x^4$] + #ul3[$10x^3$] + #ul2[$2x^2$] - #ul3[$3x^3$] + 7 + 10x \
  &= #ul1[$5x^4$] + #ul1[$12x^4$] - #ul3[$7x^3$] + #ul3[$10x^3$] - #ul3[$3x^3$] - #ul2[$3x^2$] + #ul2[$2x^2$] + 10x + 6 + 7 \
  &= 17x^4 + 0 dot x^3 - x^2 + 10x + 13 \
  &= 17x^4 - x^2 + 10x + 13 class("normal", "。") $
]

#attention[1. 为了便于整理，我们可以在同类项下面用横线记号标明，这样就不至于重复或遗漏。

2. $-7x^3 + 10x^3 - 3x^3 = (-7+10-3)x^3 = 0 dot x^3 = 0$，这一项没有了，因为 $0$ 乘任何数等于 $0$。]

#example("例 5.")[整理下列多项式：

$ 2a^4 - 8a^2 b^2 - a b^3 + 5a^3 b + 3a^4 + 6a b^3 + 5b^4 + 8a^2 b^2 class("normal", "。") $]

#sol[按 $a$ 的降幂排列，再合并同类项：

/* p.104 */$ "原式" &= 2a^4 + 3a^4 + 5a^3 b - 8a^2 b^2 + 8a^2 b^2 - a b^3 + 6a b^3 + 5b^4 \
  &= 5a^4 + 5a^3 b + 5a b^3 + 5b^4 class("normal", "。") $
]

#remark([说明])[$-8a^2 b^2 + 8a^2 b^2 = 0$，这一项没有了。]

