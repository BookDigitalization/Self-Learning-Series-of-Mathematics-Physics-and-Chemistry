// 第 3 章 整式（续：§3·8 起，原书 p.136–173）。接在 ch03.typ 之后，不另起章标题。
#import "/common/series.typ": *
#import "../figures/cross-mult.typ": cross-mult

// 独立公式末尾的句号（原书“．”）。
#let jh = math.class("normal", "。")

// 带小题号的独立公式：左边小题号，右边居中的公式。
#let lab(l, eq) = grid(columns: (auto, 1fr), column-gutter: 0.5em, align: horizon, l, eq)

// 多个并排的小项（如例题里的 (1) (2) (3)）。
#let cols(n, ..items) = pad(left: 1.5em, grid(columns: (1fr,) * n, row-gutter: 0.8em, ..items.pos()))

// 多项式长除法竖式。
//   divisor：除式（数学式字符串）；quo、dvd：商、被除式，各项用 | 隔开，按列对齐（空项留空）；
//   其后每个字符串是竖式里的一行，同样用 | 分列；行末可加 ;s（下面画一横）或 ;d（下面画双横）。
#let cellsof(s, n: none) = {
  let cs = s.split("|").map(c => {
    let c = c.trim()
    if c == "" { none } else { eval(c, mode: "math") }
  })
  if n != none { while cs.len() < n { cs.push(none) } }
  cs
}
#let longdiv(divisor, quo, dvd, ..rows) = {
  let dv = cellsof(dvd)
  let n = dv.len()
  let cell(c) = if c == none { [] } else { c }
  let items = ()
  items.push([])
  for c in cellsof(quo, n: n) { items.push(cell(c)) }
  items.push(eval(divisor, mode: "math"))
  for c in dv { items.push(cell(c)) }
  items.push(grid.hline(y: 1, start: 1))
  items.push(grid.vline(x: 1, start: 1, end: 2))
  let r = 2
  for spec in rows.pos() {
    let parts = spec.split(";")
    let cs = cellsof(parts.at(0), n: n)
    assert(cs.len() == n, message: "竖式列数不符：" + spec)
    let rule = if parts.len() > 1 { parts.at(1).trim() } else { "" }
    items.push([])
    for c in cs { items.push(cell(c)) }
    let first = cs.position(c => c != none)
    if rule == "s" {
      items.push(grid.hline(y: r + 1, start: first + 1))
    } else if rule == "d" {
      items.push(grid.hline(y: r + 1, start: first + 1))
      items.push(grid.cell(colspan: n + 1, inset: 0pt)[#v(1.6pt)])
      items.push(grid.hline(y: r + 2, start: first + 1))
      r += 1
    }
    r += 1
  }
  align(center, grid(columns: (auto,) * (n + 1), align: right + horizon,
    inset: (x: 0.35em, y: 0.3em), stroke: none, ..items))
}

// p.136
== 整式的除法

*1. 同底数的幂的除法* 让我们计算：

$ a^5 div a^2 quad (a != 0)#jh $

在代数除法里，表示被除数的代数式叫作*被除式*，表示除数的代数式叫作*除式*，所得的结果叫作*商*。

这里，被除式 $a^5$ 与除式 $a^2$ 都是以 $a$ 作底数的幂，所以这个除法叫作同底数的幂的除法。在除法里，因为除数不能是零，所以这里要规定 $a != 0$。（以后遇到除法时，我们都假定除式的值不是零。）

#note-small[记号“$!=$”读作“不等于”。]

根据除法是乘法的逆运算的规定，我们只要研究 $a^5$ 是 $a^2$ 与怎样的代数式的积。我们知道，

$ a^2 a^3 = a^5, quad therefore quad a^5 div a^2 = a^3#jh $

在这个式子里，可以看到商仍旧是以 $a$ 为底的幂，它的指数 $3$，就是被除式的指数 $5$ 与除式的指数 $2$ 的差，即

$ a^5 div a^2 = a^3 = a^(5-2)#jh $

同样地，我们可以求出

$ a^5 div a^3 = a^(5-3) quad (a != 0), $

// p.137
$ a^5 div a^4 = a^(5-4) quad (a != 0)#jh $

一般地说，

#eqn("1", $ because & a^n dot a^(m-n) = a^m quad (m > n), \ therefore & a^m div a^n = a^(m-n) quad (a != 0)#jh $)

现在，我们再来计算

$ a^5 div a^5 quad (a != 0), $

很明显，所得的商是 $1$。

一般地说，

#eqn("2", $ because & a^m dot 1 = a^m, \ therefore & a^m div a^m = 1 quad (a != 0)#jh $)

从上面的(1)和(2)，我们得到*同底数的幂的除法法则*：

(i) #edot[同底数的两个幂相除]，如果#edot[被除式的指数大于除式的指数]，那么#edot[底数不变]，#edot[指数相减]。即

$ bold(a^m div a^n = a^(m-n)) quad (m > n), quad m, n "都是自然数，" a != 0#jh $

(ii) #edot[同底数的两个幂相除]，如果#edot[被除式的指数与除式的指数相等]，那么#edot[商等于 1]。即

$ bold(a^m div a^m = 1), quad m "是任意自然数，" a != 0#jh $

#remark([附注], [同底数的两个幂相除，如果被除式的指数小于除式的指数，这情况要在下面第五章里再讲。])

#example("例 1")[计算（这里所有字母都不等于 $0$；$m, n$ 是自然数）：]

#cols(3,
  [(1) $x^4 div x^2$；], [(2) $x^8 div x^2$；], [(3) $x^15 div x^5$；],
  [(4) $x^6 div x^5$；], [(5) $x^6 div x^6$；], [(6) $a^(m+n) div a^m$；],
  [(7) $a^(2m) div a^m$；], [(8) $a^(3m+2n) div a^(m+n)$。],
)

#sol[]

#cols(2,
  [(1) $x^4 div x^2 = x^(4-2) = x^2$；], [(2) $x^8 div x^2 = x^(8-2) = x^6$；],
  [(3) $x^15 div x^5 = x^(15-5) = x^10$；], [(4) $x^6 div x^5 = x^(6-5) = x^1 = x$；],
  [(5) $x^6 div x^6 = 1$；], [(6) $a^(m+n) div a^m = a^(m+n-m) = a^n$；],
  grid.cell(colspan: 2)[(7) $a^(2m) div a^m = a^(2m-m) = a^m$；],
  grid.cell(colspan: 2)[(8) $a^(3m+2n) div a^(m+n) = a^((3m+2n)-(m+n)) = a^(2m+n)$。],
)

// p.138
#attention[同底数的幂相除时，指数相减，不是指数相除，$therefore x^4 div x^2 = x^(4-2) = x^2$，不是 $x^4 div x^2 = x^(4 div 2) = x^2$；同样，$x^8 div x^2 = x^(8-2) = x^6$，不是 $x^8 div x^2 = x^(8 div 2) = x^4$；$x^15 div x^5 = x^(15-5)$ 不等于 $x^(15 div 5)$。]

#example("例 2")[计算：]

#cols(2,
  [(1) $(x^3)^2 div x^2$；], [(2) $(x^5)^3 div (x^2)^3$；],
  [(3) $(x^5)^3 div (x^3)^5$；], [(4) $(x^4 div x)^3$。],
)

#sol[]

(1) $(x^3)^2 div x^2 = x^6 div x^2 = x^(6-2) = x^4$；

(2) $(x^5)^3 div (x^2)^3 = x^15 div x^6 = x^(15-6) = x^9$；

(3) $(x^5)^3 div (x^3)^5 = x^15 div x^15 = 1$；

(4) $(x^4 div x)^3 = (x^(4-1))^3 = (x^3)^3 = x^9$。

#example("例 3")[计算：]

#cols(2,
  [(1) $(x^3 dot x^5) div x^2$；], [(2) $[(x^3)^2 dot x^5] div x^10$；],
  [(3) $(x^2 dot x^3)^3 div (x^2)^4$；], [(4) $[(a^2)^3 dot (a^3)^4] div (a^5)^2$。],
)

#sol[]

(1) $(x^3 dot x^5) div x^2 = x^8 div x^2 = x^6$；

(2) $[(x^3)^2 dot x^5] div x^10 = [x^6 dot x^5] div x^10 = x^11 div x^10 = x$；

(3) $(x^2 dot x^3)^3 div (x^2)^4 = (x^5)^3 div x^8 = x^15 div x^8 = x^7$；

(4) $[(a^2)^3 dot (a^3)^4] div (a^5)^2 = [a^6 dot a^12] div a^10 = a^18 div a^10 = a^8$。

