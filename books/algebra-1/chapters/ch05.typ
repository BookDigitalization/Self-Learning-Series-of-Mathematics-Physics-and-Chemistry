  // p.232
  5. $(5x-7)/(x^2+3x) - (2x+5)/(x^2+3x) - (2x-15)/(x^2+3x)$。
  6. $(x^3-4x)/(x^2-3x+2) - (3x^2-6x)/(x^2-3x+2)$。
  7. $(3a^2+3a-1)/(a^2-5a-3) - (a^2+2a+7)/(a^2-5a-3) - (a^2+6a-5)/(a^2-5a-3)$。
  8. $(3x^2-5a x+a^2)/(x^2+3a x+2a^2) - (x^2+a x+3a^2)/(x^2+3a x+2a^2) - (2x^2-6a x-2a^2)/(x^2+3a x+2a^2)$。
  9. $(x^2+3x-5)/(x^2-3x-18) - (2x^2-4x+7)/(x^2-3x-18) - (7x-12-x^2)/(x^2-3x-18)$。
  10. $(x^2-a^2)/(x^2-9a^2) - (x-2a)^2/(x^2-9a^2) + (5a^2-4a x)/(x^2-9a^2)$。
