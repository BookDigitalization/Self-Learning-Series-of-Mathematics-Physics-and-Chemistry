  8. $16x^2 y^3 div (-(20x^5 y^4)/(3a^2 b)) div (a b)/(x+y)$。
  9. $(a^2+5a+4)/(a^2+a-2) div 5(a+1)^2 div 1/(a^2-2a+1)$。
  10. $(a^2-x^2)^3/(a^2+x^2) div (a^2+2a x+x^2)^2/(a^4-x^4) times 1/(a^2-2a x+x^2)^2$。
]

#example("例 4")[计算：

(1) $(x + 1/x) div (x - 1/x)$；

(2) $(1/a + 1/b) div (1/a^2 - 1/b^2)$。]

#sol[
(1) $ (x + 1/x) div (x - 1/x) &= (x^2+1)/x div (x^2-1)/x \
  &= (x^2+1)/x times x/(x^2-1) = (x^2+1)/(x^2-1) #fen $

// p.247
(2) $ (1/a + 1/b) div (1/a^2 - 1/b^2) &= (b+a)/(a b) div (b^2-a^2)/(a^2 b^2) \
  &= (b+a)/(a b) times (a^2 b^2)/(b^2-a^2) = (a^2 b^2(b+a))/(a b(b+a)(b-a)) \
  &= (a b)/(b-a) #ju $
]

#example("例 5")[计算：

(1) $(a-b)/(a+b) div (a^2+b^2)/(a^2-b^2) - (a+b)/(a b) div (a^2+b^2)/(a^2 b+a b^2)$；

(2) $x/(x-1) div x/(x+1) - (x+1)/(x^3-1) div 1/(x^2+x+1)$。]

#sol[
(1) $ & (a-b)/(a+b) div (a^2+b^2)/(a^2-b^2) - (a+b)/(a b) div (a^2+b^2)/(a^2 b+a b^2) \
  &= (a-b)/(a+b) times ((a+b)(a-b))/(a^2+b^2) - (a+b)/(a b) times (a b(a+b))/(a^2+b^2) \
  &= (a-b)^2/(a^2+b^2) - (a+b)^2/(a^2+b^2) \
  &= (a^2-2a b+b^2-(a^2+2a b+b^2))/(a^2+b^2) = (-4a b)/(a^2+b^2) #fen $

(2) $ & x/(x-1) div x/(x+1) - (x+1)/(x^3-1) div 1/(x^2+x+1) \
  &= x/(x-1) times (x+1)/x - (x+1)/((x-1)(x^2+x+1)) times (x^2+x+1)/1 \
  &= (x+1)/(x-1) - (x+1)/(x-1) = 0 #ju $
]

#example("例 6")[计算：

$ ((2a)/(2a+b) - (4a^2)/(4a^2+4a b+b^2)) div ((2a)/(4a^2-b^2) + 1/(b-2a)) #ju $]

// p.248
#sol[
$ & ((2a)/(2a+b) - (4a^2)/(4a^2+4a b+b^2)) div ((2a)/(4a^2-b^2) + 1/(b-2a)) \
  &= [(2a)/(2a+b) - (4a^2)/(2a+b)^2] div [(2a)/((2a+b)(2a-b)) - 1/(2a-b)] \
  &= (2a(2a+b)-4a^2)/(2a+b)^2 div (2a-(2a+b))/((2a+b)(2a-b)) \
  &= (4a^2+2a b-4a^2)/(2a+b)^2 div (2a-2a-b)/((2a+b)(2a-b)) \
  &= (2a b)/(2a+b)^2 div (-b)/((2a+b)(2a-b)) \
  &= (2a b)/(2a+b)^2 times ((2a+b)(2a-b))/(-b) \
  &= (2a b(2a+b)(2a-b))/(-b(2a+b)^2) = -(2a(2a-b))/(2a+b) #ju $
]

