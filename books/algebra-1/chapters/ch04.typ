    [13\. $a^2 - 16 a + 60$。], [14\. $a^2 - 7 a - 60$。],
    [15\. $a^2 + 32 a + 60$。], [16\. $a^2 + 11 a - 60$。],
    [17\. $x^2 - 20 x y + 96 y^2$。], [18\. $x^2 - 4 x y - 96 y^2$。],
