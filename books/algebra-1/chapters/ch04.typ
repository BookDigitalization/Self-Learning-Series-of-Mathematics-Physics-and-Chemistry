    [13\. $x^3 - a x^2 - b^2 x + a b^2$。], [14\. $a^2 - 9 b^2 + 12 b c - 4 c^2$。],
    [15\. $x^9 - y^9$。], [16\. $a^2 + a + b - b^2$。],
