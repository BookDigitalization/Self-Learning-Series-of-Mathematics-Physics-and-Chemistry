// 图 2·5、2·6（原书 p.82），图 2·8、2·9（p.83），图 2·10（p.84），习题 2·2 第 4 题附图（p.85）
// 电路图，CeTZ 重绘。坐标是原页放大渲染图的像素坐标（各图用各自的放大倍数，见各图 px-canvas 的 origin）。
#import "/common/series.typ": *
#import "fig2-sym.typ": jdot, lamp, cell, battery, meter, lw

// 折线导线
#let wire(p, ..pts) = {
  import cetz.draw: *
  line(..pts.pos().map(q => p(q.at(0), q.at(1))), stroke: lw)
}
#let lab(p, x, y, body, size: 8pt) = {
  import cetz.draw: *
  content(p(x, y), anchor: "center", text(size: size, body))
}
// 闸刀：从 (x, y1) 向右下斜到 (x + dx, y2)，刀尖处一小段横档
#let sw(p, x, y1, dx, dy) = {
  import cetz.draw: *
  line(p(x, y1), p(x + dx, y1 + dy), stroke: lw)
  line(p(x + dx - 8, y1 + dy + 2), p(x + dx + 8, y1 + dy - 4), stroke: 2pt)
}
// 放大约 2.3 倍时用的电池组
#let bat(p, x, y, n: 3) = battery(p, x - 20, y, n: n, h: 32, pitch: 30, gap: 14)

#let fig-2-5(width: 8cm) = px-canvas(780, 520, origin: (30, 80), width: width, (p, u) => {
  wire(p, (65, 120), (350, 120))
  bat(p, 385, 120, n: 1)
  wire(p, (410, 120), (690, 120), (690, 290))
  sw(p, 690, 290, 55, 85)
  wire(p, (690, 385), (690, 570), (537, 570))
  lamp(p, 495, 570, r: 42)
  wire(p, (452, 570), (310, 570))
  lamp(p, 268, 570, r: 42)
  wire(p, (225, 570), (65, 570), (65, 120))
})

