// 原书 p.268、p.268、p.270、p.270。坐标取自原书页面 150 dpi 像素；线圈、电阻按符号重绘。
#import "/common/series.typ": *
#import "fig5-circ.typ": *

// 图 5·9：画布取原书页面 (150, 180) 起，宽 860、高 400（约 p.268 上部）
#let fig-5-9(width: 10cm) = px-canvas(860, 400, origin: (150, 180), width: width, (p, u) => {
  import cetz.draw: *
  // 线圈 AX 与电阻 ad
  wire(p, (345, 210), (790, 210))
  wire(p, (345, 350), (790, 350))
  coil(p, (345, 210), (345, 350), loops: 4, r: 17)
  resistor(p, (790, 210), (790, 350), peaks: 7)
  dot(p, (345, 210)); dot(p, (345, 350)); dot(p, (790, 210)); dot(p, (790, 350))
  // 线圈 CZ 与电阻 cd（Z、d 在上，C、c 在下）
  wire(p, (345, 378), (785, 378))
  coil(p, (345, 378), (205, 470), loops: 4, r: 17)
  resistor(p, (785, 378), (680, 485), peaks: 5)
  wire(p, (680, 485), (680, 555), (205, 555), (205, 470))
  dot(p, (345, 378)); dot(p, (785, 378)); dot(p, (205, 470)); dot(p, (680, 485))
  // 线圈 BY 与电阻 bd... 原图为 Y→B，b
  wire(p, (375, 400), (830, 400))
  coil(p, (375, 400), (478, 485), loops: 4, r: 17)
  resistor(p, (830, 400), (960, 468), peaks: 4)
  wire(p, (478, 485), (478, 503), (962, 503), (962, 468))
  dot(p, (375, 400)); dot(p, (478, 485)); dot(p, (960, 468))
  lab(p, 330, 208, $A$); lab(p, 802, 203, $a$); lab(p, 330, 345, $X$)
  lab(p, 325, 372, $Z$); lab(p, 802, 376, $d$); lab(p, 352, 402, $Y$)
  lab(p, 188, 478, $C$); lab(p, 492, 483, $B$); lab(p, 668, 484, $c$); lab(p, 978, 466, $b$)
})

