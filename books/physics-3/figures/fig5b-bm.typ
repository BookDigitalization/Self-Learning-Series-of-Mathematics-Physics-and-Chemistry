// 来源页（原书页码）：图 5·19 p.280；图 5·22 p.283；图 5·25 p.289（涂去了图书馆印章）；习题 5·5 第 5 题 p.282；复习题五第 2 题 p.301。
// 标注坐标 = 原书页面 200 dpi 网格坐标（render-pages.py --dpi 200 --grid 100）；位图裁剪时放大 2 倍。
#import "/common/series.typ": *

#let bitfig(png, box, labels, width: 8cm, size: 9pt) = {
  let (x0, y0, x1, y1) = box
  let w = (x1 - x0) * 2
  let h = (y1 - y0) * 2
  px-canvas(w, h, width: width, (p, u) => {
    import cetz.draw: *
    content(p(0, 0), anchor: "north-west", image(png, width: w * u))
    for (x, y, body) in labels {
      content(p((x - x0) * 2, (y - y0) * 2), anchor: "center", text(size: size, body))
    }
  })
}

