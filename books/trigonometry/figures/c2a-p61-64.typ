// 图 2·22（原书 p.61）、图 2·23（p.63）、图 2·24（p.64）；页面 200 dpi 坐标。
#import "c2a-base.typ": *

// 图 2·22 180° − α 与 α：OP1 与 OP 对称于 y 轴
#let fig-c2a-2-22(width: 640 * k) = px-canvas(640, 345, origin: (335, 890), width: width, (p, u) => {
  import cetz.draw: *
  let O = (604, 1166)
  let P = (812, 1025)
  let M = (812, 1166)
  let P1 = (2 * O.at(0) - P.at(0), P.at(1))
  let M1 = (P1.at(0), O.at(1))
  c2a-axes(p, O, 340, 965, 1230, 895, ol: none, st: lb)
  lbl(p, O, $O$, dir: "se", d: 12)
  c2a-seg(p, O, P, st: lb)
  c2a-seg(p, O, P1, st: lb)
  c2a-seg(p, P, M, st: lb)
  c2a-seg(p, P1, M1, st: lb)
  let a = dirang(P.at(0) - O.at(0), P.at(1) - O.at(1)).deg()
  c2a-arc(p, O, 32, 0, a, arrow: true)
  c2a-arc(p, O, 22, 0, 180 - a, arrow: true)
  lbl(p, (656, 1151), $alpha$, dir: "c", d: 0)
  lbl(p, (598, 1125), $180° - alpha$, dir: "c", d: 0)
  lbl(p, P, $P$, dir: "n", d: 13)
  lbl(p, P1, $P_1$, dir: "n", d: 13)
  lbl(p, M, $M$, dir: "s", d: 13)
  lbl(p, M1, $M_1$, dir: "s", d: 13)
  lbl(p, c2a-mid(O, P), $r$, dir: "nw", d: 10)
  lbl(p, c2a-mid(O, P1), $r$, dir: "ne", d: 10)
  lbl(p, (812, 1096), $y$, dir: "e", d: 10)
  lbl(p, (396, 1096), $y$, dir: "w", d: 10)
  lbl(p, (713, 1166), $x$, dir: "s", d: 12)
  lbl(p, (490, 1166), $-x$, dir: "s", d: 12)
})

// 图 2·23 180° + α 与 α：OP1 与 OP 成一直线
#let fig-c2a-2-23(width: 620 * k) = px-canvas(620, 415, origin: (350, 240), width: width, (p, u) => {
  import cetz.draw: *
  let O = (622, 477)
  let P = (830, 340)
  let M = (830, 477)
  let P1 = (2 * O.at(0) - P.at(0), 2 * O.at(1) - P.at(1))
  let M1 = (P1.at(0), O.at(1))
  c2a-axes(p, O, 360, 960, 645, 245, ol: none, st: lb)
  lbl(p, O, $O$, dir: "se", d: 12)
  c2a-seg(p, P, P1, st: lb)
  c2a-seg(p, P, M, st: lb)
  c2a-seg(p, P1, M1, st: lb)
  let a = dirang(P.at(0) - O.at(0), P.at(1) - O.at(1)).deg()
  c2a-arc(p, O, 36, 0, a, arrow: true)
  c2a-arc(p, O, 30, 0, 180 + a, arrow: true)
  lbl(p, (678, 463), $alpha$, dir: "c", d: 0)
  lbl(p, (612, 430), $180° + alpha$, dir: "c", d: 0)
  lbl(p, P, $P$, dir: "n", d: 13)
  lbl(p, P1, $P_1$, dir: "s", d: 13)
  lbl(p, M, $M$, dir: "s", d: 13)
  lbl(p, M1, $M_1$, dir: "n", d: 13)
  lbl(p, c2a-mid(O, P), $r$, dir: "nw", d: 10)
  lbl(p, c2a-mid(O, P1), $r$, dir: "se", d: 10)
  lbl(p, (830, 408), $y$, dir: "e", d: 10)
  lbl(p, (P1.at(0), 547), $-y$, dir: "w", d: 14)
  lbl(p, (733, 477), $x$, dir: "s", d: 12)
  lbl(p, (505, 477), $-x$, dir: "n", d: 12)
})

// 图 2·24 360° − α 与 α：OP1 与 OP 对称于 x 轴，M 与 M1 重合
#let fig-c2a-2-24(width: 490 * k) = px-canvas(490, 440, origin: (360, 955), width: width, (p, u) => {
  import cetz.draw: *
  let O = (457, 1223)
  let P = (665, 1088)
  let M = (665, 1223)
  let P1 = (P.at(0), 2 * O.at(1) - P.at(1))
  c2a-axes(p, O, 370, 840, 1385, 960, ol: none, st: lb)
  lbl(p, O, $O$, dir: "sw", d: 13)
  c2a-seg(p, O, P, st: lb)
  c2a-seg(p, O, P1, st: lb)
  c2a-seg(p, P, P1, st: lb)
  let a = dirang(P.at(0) - O.at(0), P.at(1) - O.at(1)).deg()
  c2a-arc(p, O, 32, 0, a, arrow: true)
  c2a-arc(p, O, 22, 0, 360 - a, arrow: true)
  lbl(p, (507, 1210), $alpha$, dir: "c", d: 0)
  lbl(p, (447, 1186), $360° - alpha$, dir: "c", d: 0)
  lbl(p, P, $P$, dir: "n", d: 13)
  lbl(p, P1, $P_1$, dir: "s", d: 13)
  lbl(p, M, $M(M_1)$, dir: "ne", d: 26)
  lbl(p, c2a-mid(O, P), $r$, dir: "nw", d: 10)
  lbl(p, c2a-mid(O, P1), $r$, dir: "sw", d: 10)
  lbl(p, (665, 1150), $y$, dir: "e", d: 10)
  lbl(p, (665, 1290), $-y$, dir: "e", d: 14)
  lbl(p, (567, 1223), $x$, dir: "s", d: 12)
})
