#summary[
  #fig("1·23", fig-c1-1-23())[]

  *1. 锐角三角函数的定义*

  $ sin A = a / c dou quad cos A = b / c dou quad tan A = a / b dou \ cot A = b / a dou quad sec A = c / b dou quad csc A = c / a ju $

  *2. $90° - A$ 和锐角 $A$ 的三角函数间的关系*

  $ sin (90° - A) = cos A dou \ cos (90° - A) = sin A dou \ tan (90° - A) = cot A dou quad cot (90° - A) = tan A dou \ sec (90° - A) = csc A dou quad csc (90° - A) = sec A ju $

  *3. 几个特殊度数角的三角函数*

  #c1-tab(6,
    [$A$], [$0°$], [$30°$], [$45°$], [$60°$], [$90°$],
    [$sin A$], [0], [$1/2$], [$sqrt(2)/2$], [$sqrt(3)/2$], [1],
    [$cos A$], [1], [$sqrt(3)/2$], [$sqrt(2)/2$], [$1/2$], [0],
    [$tan A$], [0], [$sqrt(3)/3$], [1], [$sqrt(3)$], [不存在],
    [$cot A$], [不存在], [$sqrt(3)$], [1], [$sqrt(3)/3$], [0],
    [$sec A$], [1], [$(2 sqrt(3))/3$], [$sqrt(2)$], [2], [不存在],
    [$csc A$], [不存在], [2], [$sqrt(2)$], [$(2 sqrt(3))/3$], [1],
  )

  *4. 锐角的三角函数的变化*

  锐角逐渐增大时 #math.equation(block: false, $lr(\{ #v(1.6em))$) #box[正弦，正切，正割逐渐增大；#linebreak()余弦，余切，余割逐渐减小。]

  *5. 解直角三角形的四种情形*

  #align(center, block(breakable: false, above: 1em, below: 1em, table(
    columns: 4,
    align: center + horizon,
    inset: (x: 8pt, y: 7pt),
    stroke: (x, y) => (
      left: if x in (1, 2, 3) { 0.5pt } else { none },
      top: if y == 0 { 1.2pt } else if y == 1 { 0.5pt } else { none },
      bottom: if y == 4 { 1.2pt } else { none },
    ),
    [已　知], table.cell(colspan: 3)[所　求],
    [$c, A$], [$B = 90° - A$], [$a = c sin A$], [$b = c cos A$],
    [$a, A$], [$B = 90° - A$], [$b = a cot A$], [$c = a / (sin A)$],
    [$c, a$], [$sin A = a / c$], [$B = 90° - A$], [$b = sqrt(c^2 - a^2)$ 或 $b = c sin B$],
    [$a, b$], [$tan A = a / b$], [$B = 90° - A$], [$c = sqrt(a^2 + b^2)$ 或 $c = a / (sin A)$],
  )))
]

