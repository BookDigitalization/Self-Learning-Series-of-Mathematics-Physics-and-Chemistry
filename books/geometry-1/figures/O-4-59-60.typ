// 图 4·59（原书 p.263）、4·60（p.264）；页面 200 dpi 坐标。
// 4·58（p.262）是写实插画，用扫描裁剪的二值化 PNG：figures/O-4-58.png（crop-figure.py 125,805,870,1060）。
#import "O-base.typ": *

// 图 4·59 两圆的六种位置：(1) 外离 (2) 外切 (3) 相交 (4) 内切 (5) 内含 (6) 同心。
// 图中 R、r 为两半径，用带箭头的尺寸线标出。
#let fig-O-4-59(width: 770 * k) = px-canvas(770, 400, origin: (110, 190), width: width, (p, u) => {
  import cetz.draw: *
  // (1) 外离：A 的圆半径 r，B 的圆半径 R
  let (A, B) = ((171, 255), (310, 258))
  circ(p, A, 46.5)
  circ(p, B, 64)
  seg(p, A, B)
  O-ring(p, A)
  O-ring(p, B)
  lbl(p, A, $A$, dir: "w", d: 12)
  lbl(p, B, $B$, dir: "e", d: 12)
  O-dim(p, (171, 262), (217.5, 262), lab: $r$)
  O-dim(p, (246, 266), (310, 266), lab: $R$)
  O-cap(p, (244, 360), [(1) 外离])
  // (2) 外切：B 的圆半径 R（左），A 的圆半径 r（右），C 为切点
  let (B2, A2, C2) = ((457, 255), (569.5, 255), (521.5, 255))
  circ(p, B2, 64.5)
  circ(p, A2, 48)
  seg(p, B2, A2)
  O-ring(p, A2)
  O-ring(p, B2)
  lbl(p, A2, $A$, dir: "e", d: 12)
  lbl(p, B2, $B$, dir: "w", d: 12)
  lbl(p, C2, $C$, dir: "ne", d: 10)
  O-dim(p, (457, 262), (521.5, 262), lab: $R$)
  O-dim(p, (521.5, 266), (569.5, 266), lab: $r$)
  O-cap(p, (494, 360), [(2) 外切])
  // (3) 相交：D 为一个交点，虚线 AD = r、BD = R
  let (A3, B3) = ((697.5, 255), (779, 258))
  circ(p, A3, 47)
  circ(p, B3, 64.5)
  let D3 = O-cc(A3, 47, B3, 64.5).at(0)
  seg(p, A3, B3)
  seg(p, A3, D3, stroke: dsh)
  seg(p, B3, D3, stroke: dsh)
  O-ring(p, A3)
  O-ring(p, B3)
  lbl(p, A3, $A$, dir: "w", d: 12)
  lbl(p, B3, $B$, dir: "e", d: 12)
  lbl(p, D3, $D$, dir: "n", d: 10)
  lbl(p, ((A3.at(0) + D3.at(0)) / 2 - 9, (A3.at(1) + D3.at(1)) / 2), $r$, dir: "c", d: 0)
  lbl(p, ((B3.at(0) + D3.at(0)) / 2 + 8, (B3.at(1) + D3.at(1)) / 2 - 8), $R$, dir: "c", d: 0)
  O-cap(p, (724, 360), [(3) 相交])
  // (4) 内切：B 为大圆圆心（半径 R），A 为小圆圆心（半径 r），C 为切点
  let (B4, A4, C4) = ((221.5, 461), (238.5, 461), (286.5, 461))
  circ(p, B4, 65)
  circ(p, A4, 48)
  seg(p, B4, A4)
  O-ring(p, A4)
  O-ring(p, B4)
  lbl(p, A4, $A$, dir: "n", d: 11)
  lbl(p, B4, $B$, dir: "nw", d: 11)
  lbl(p, C4, $C$, dir: "e", d: 11)
  O-dim(p, (221.5, 478), (286.5, 478), lab: $R$, side: (0, 9))
  O-dim(p, (238.5, 470), (286.5, 470), lab: $r$, side: (3, -8))
  O-cap(p, (224, 572), [(4) 内切])
  // (5) 内含：A 为大圆圆心（半径 R），B 为小圆圆心（半径 r）；P、Q 在直线 AB 上
  let (A5, B5) = ((518.5, 471), (527, 477))
  circ(p, A5, 64)
  circ(p, B5, 48)
  let e5 = O-u(A5, B5)
  let P5 = (A5.at(0) + 64 * e5.at(0), A5.at(1) + 64 * e5.at(1))
  let Q5 = (B5.at(0) + 48 * e5.at(0), B5.at(1) + 48 * e5.at(1))
  seg(p, A5, P5)
  O-ring(p, A5)
  O-ring(p, B5)
  lbl(p, A5, $A$, dir: "nw", d: 11)
  lbl(p, B5, $B$, dir: "e", d: 11)
  lbl(p, Q5, $Q$, dir: "ne", d: 9)
  lbl(p, P5, $P$, dir: "se", d: 11)
  // R、r 标在半径线旁（R 在线的左下侧，r 在右上侧）
  lbl(p, (A5.at(0) + 32 * e5.at(0) - 6, A5.at(1) + 32 * e5.at(1) + 8), $R$, dir: "c", d: 0)
  lbl(p, (B5.at(0) + 24 * e5.at(0) + 5, B5.at(1) + 24 * e5.at(1) - 7), $r$, dir: "c", d: 0)
  O-cap(p, (516, 572), [(5) 内含])
  // (6) 同心：A(B) 为公共圆心
  let C6 = (742, 472)
  circ(p, C6, 65)
  circ(p, C6, 48)
  pdot(p, C6, r: 2)
  lbl(p, C6, $A (B)$, dir: "n", d: 14)
  O-cap(p, (754, 572), [(6) 同心])
})

// 图 4·60 例：外离两圆 M、N；连心线 MN 与两圆相交于 A、B；P、Q 分别在两圆上，虚线 MP、NQ
#let fig-O-4-60(width: 440 * k) = px-canvas(440, 235, origin: (445, 940), width: width, (p, u) => {
  import cetz.draw: *
  let (M, N) = ((555, 1051), (792, 1056))
  let (r1, r2) = (98, 58.5)
  circ(p, M, r1)
  circ(p, N, r2)
  let e = O-u(M, N)
  let A = (M.at(0) + r1 * e.at(0), M.at(1) + r1 * e.at(1))
  let B = (N.at(0) - r2 * e.at(0), N.at(1) - r2 * e.at(1))
  let P = O-pa(M, r1, -35)
  let Q = O-pa(N, r2, 230)
  seg(p, M, N)
  seg(p, P, Q)
  seg(p, M, P, stroke: dsh)
  seg(p, N, Q, stroke: dsh)
  O-ring(p, M)
  O-ring(p, N)
  lbl(p, M, $M$, dir: "w", d: 12)
  lbl(p, N, $N$, dir: "e", d: 12)
  lbl(p, A, $A$, dir: "ne", d: 11)
  lbl(p, B, $B$, dir: "nw", d: 11)
  lbl(p, P, $P$, dir: "se", d: 11)
  lbl(p, Q, $Q$, dir: "sw", d: 11)
})
