// 图 1·53（原书 p.36）、图 1·54（p.36）、图 1·55（p.37，写实：曲尺，扫描二值化）、图 1·56、1·57（p.37）、图 1·58（p.38）；页面 200 dpi 坐标。
#import "C-base.typ": *

// 图 1·53 互相垂直的两直线
#let fig-C-1-53(width: 380 * k) = px-canvas(380, 290, origin: (480, 375), width: width, (p, u) => {
  import cetz.draw: *
  seg(p, (668, 392), (668, 640))
  seg(p, (497, 600), (838, 600))
  anglearc(p, (668, 600), (668, 500), (560, 600), 12)
  anglearc(p, (668, 600), (668, 500), (780, 600), 12)
  lbl(p, (651, 585), $d$, dir: "c", d: 0)
  lbl(p, (686, 585), $d$, dir: "c", d: 0)
  lbl(p, (668, 392), $A$, dir: "n")
  lbl(p, (668, 640), $B$, dir: "s")
  lbl(p, (497, 600), $C$, dir: "w")
  lbl(p, (838, 600), $D$, dir: "e")
  lbl(p, (682, 614), $E$, dir: "c", d: 0)
})

// 图 1·54 用三角板画垂线（左：点 P 在 AB 外；右：点 R 在 CD 上，虚线为拿掉的三角板）
#let fig-C-1-54(width: 640 * k) = px-canvas(640, 330, origin: (190, 945), width: width, (p, u) => {
  import cetz.draw: *
  // 左图
  C-ruler(p, ((287, 968), (287, 1153), (385, 1153)), ((308, 1048), (308, 1130), (353, 1130)))
  seg(p, (212, 1153), (448, 1153))
  ring(p, (287, 1003), r: 3)
  lbl(p, (276, 975), $P$, dir: "c", d: 0)
  lbl(p, (203, 1153), $A$, dir: "c", d: 0)
  lbl(p, (460, 1157), $B$, dir: "c", d: 0)
  C-t(p, (325, 1257), [点 $P$ 在 $A B$ 外])
  // 右图
  seg(p, (515, 1157), (562, 1157))
  seg(p, (562, 1157), (648, 1157), stroke: dsh)
  seg(p, (648, 1157), (795, 1159))
  C-ruler(p, ((542, 1127), (648, 1020), (648, 1235)), ((575, 1128), (627, 1080), (627, 1180)))
  seg(p, (650, 957), (770, 1158), stroke: dsh)
  seg(p, (650, 957), (650, 1020), stroke: dsh)
  poly(p, ((675, 1050), (675, 1135), (723, 1135)), close: true, stroke: dsh)
  ring(p, (648, 1157), r: 3.5)
  lbl(p, (497, 1157), $C$, dir: "c", d: 0)
  lbl(p, (808, 1160), $D$, dir: "c", d: 0)
  lbl(p, (660, 1173), $R$, dir: "c", d: 0)
  C-t(p, (667, 1260), [点 $R$ 在 $C D$ 上])
})

// 图 1·55 曲尺（写实插画：原扫描二值化，原图里的“曲尺”二字涂去后用真文字补上；尺上的刻度数字保留在位图里）
#let fig-C-1-55(width: 390 * k) = px-canvas(390, 377, origin: (490, 235), width: width, (p, u) => {
  import cetz.draw: *
  C-img(p, u, "C-1-55.png", (490, 235, 880, 612))
  C-t(p, (637, 326), [曲尺])
})

