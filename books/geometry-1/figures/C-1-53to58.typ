  import cetz.draw: *
  seg(p, (185, 1062), (455, 1067))
  seg(p, (320, 1063), (320, 888))
  seg(p, (320, 1063), (348, 890), stroke: dsh)
  lbl(p, (178, 1063), $A$, dir: "c", d: 0)
  lbl(p, (463, 1067), $B$, dir: "c", d: 0)
  lbl(p, (322, 1080), $P$, dir: "c", d: 0)
  lbl(p, (320, 873), $C$, dir: "c", d: 0)
  lbl(p, (351, 873), $K$, dir: "c", d: 0)
})

