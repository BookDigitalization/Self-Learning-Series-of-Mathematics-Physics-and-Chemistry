  lbl(p, (683, 885), $P$, dir: "c", d: 0)
  lbl(p, (686, 1073), $P'$, dir: "c", d: 0)
  lbl(p, (671, 993), $O$, dir: "c", d: 0)
  lbl(p, (736, 968), $E$, dir: "c", d: 0)
  lbl(p, (527, 993), $A$, dir: "c", d: 0)
  lbl(p, (840, 993), $B$, dir: "c", d: 0)
  C-t(p, (537, 1062), [纸])
})

