// 图 1·66–图 1·71（原书 p.48–50）；页面 200 dpi 坐标。图 1·67、1·70 为写实插画，用原扫描二值化 PNG。
#import "C-base.typ": *

// 图 1·66 相交直线：左 AB、CD 相交于 E；右 PQ、RS 延长（虚线）后相交于 O
#let fig-C-1-66(width: 670 * k) = px-canvas(670, 195, origin: (180, 220), width: width, (p, u) => {
  import cetz.draw: *
  // 左
  seg(p, (190, 240), (500, 335))
  seg(p, (190, 375), (485, 258))
  lbl(p, (183, 239), $D$, dir: "c", d: 0)
  lbl(p, (494, 254), $B$, dir: "c", d: 0)
  lbl(p, (383, 313), $E$, dir: "c", d: 0)
  lbl(p, (513, 337), $C$, dir: "c", d: 0)
  lbl(p, (184, 379), $A$, dir: "c", d: 0)
  // 右
  seg(p, (803, 240), (665, 278))
  seg(p, (665, 278), (552, 317), stroke: dsh)
  seg(p, (820, 398), (655, 322))
  seg(p, (655, 322), (552, 272), stroke: dsh)
  lbl(p, (815, 236), $P$, dir: "c", d: 0)
  lbl(p, (662, 262), $Q$, dir: "c", d: 0)
  lbl(p, (607, 284), $O$, dir: "c", d: 0)
  lbl(p, (650, 343), $S$, dir: "c", d: 0)
  lbl(p, (829, 406), $R$, dir: "c", d: 0)
})

