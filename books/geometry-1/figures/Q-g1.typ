// 第 14 题：AP ⊥ BP，AQ ⊥ CQ，BP、CQ 分别平分 ∠B、∠C
#let fig-Q-14(width: 400 * k) = px-canvas(400, 300, origin: (470, 380), width: width, (p, u) => {
  import cetz.draw: *
  let a = (695, 410)
  let b = (498, 632)
  let c = (832, 632)
  let uv(x, y) = P-go(x, y, 1)
  let bis(v, x, y) = {
    let (ux, uy) = (uv(v, x), uv(v, y))
    (v.at(0) + ux.at(0) - v.at(0) + uy.at(0) - v.at(0), v.at(1) + ux.at(1) - v.at(1) + uy.at(1) - v.at(1))
  }
  let bb = bis(b, a, c)
  let cb = bis(c, a, b)
  let pp = Q-foot(a, b, bb)
  let q = Q-foot(a, c, cb)
  let k1 = P-meet(a, q, b, c)
  let s1 = P-meet(a, pp, b, c)
  poly(p, (a, b, c), close: true)
  seg(p, b, pp)
  seg(p, c, q)
  seg(p, a, pp)
  seg(p, a, q)
  seg(p, q, pp)
  dseg(p, pp, s1)
  dseg(p, q, k1)
  rtmark(p, pp, a, b, s: 8)
  rtmark(p, q, a, c, s: 8)
  lbl(p, a, $A$, dir: "n", d: 10)
  lbl(p, b, $B$, dir: "sw", d: 10)
  lbl(p, c, $C$, dir: "se", d: 10)
  lbl(p, k1, $K$, dir: "s", d: 10)
  lbl(p, s1, $S$, dir: "s", d: 10)
  lbl(p, q, $Q$, dir: "w", d: 10)
  lbl(p, pp, $P$, dir: "e", d: 10)
})

