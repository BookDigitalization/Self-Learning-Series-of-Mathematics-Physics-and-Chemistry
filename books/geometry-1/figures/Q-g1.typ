// 第 7 题：▱ABCD，AA′ ∥ DD′ ∥ BB′ ∥ CC′ 交直线 l 于 A′、D′、B′、C′；O 是对角线交点，OO′ ∥ AA′
#let fig-Q-7(width: 400 * k) = px-canvas(400, 270, origin: (270, 150), width: width, (p, u) => {
  import cetz.draw: *
  let a = (333, 288)
  let b = (547, 288)
  let d = (385, 178)
  let c = (599, 178)
  let o = (466, 233)
  let l1 = (285, 332)
  let l2 = (660, 386)
  let dir = (0.2, 1)
  poly(p, (a, b, c, d), close: true)
  dseg(p, a, c)
  dseg(p, b, d)
  seg(p, l1, l2)
  for (x, nm, dd) in ((a, $A'$, "s"), (d, $D'$, "s"), (o, $O'$, "s"), (b, $B'$, "s"), (c, $C'$, "s")) {
    let f = Q-hit(x, dir, l1, l2)
    seg(p, x, f)
    lbl(p, f, nm, dir: "s", d: 11)
