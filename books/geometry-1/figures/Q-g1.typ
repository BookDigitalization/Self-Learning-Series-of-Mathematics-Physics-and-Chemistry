// 总复习题的插图（一）：第 5–9 题（p.295–296）、第 10–15 题（p.297–298）。页面 200 dpi 坐标。
#import "Q-base.typ": *

// 线段 x→y 上的等边三角形顶点，取远离 ref 的一侧
#let Q-apexo(x, y, ref) = {
  let u = Q-apex(x, y, 1)
  let v = Q-apex(x, y, -1)
  let d(a) = (a.at(0) - ref.at(0)) * (a.at(0) - ref.at(0)) + (a.at(1) - ref.at(1)) * (a.at(1) - ref.at(1))
  if d(u) > d(v) { u } else { v }
}
// 一个点的垂线（方向 dir）与直线 a→b 的交点
#let Q-hit(x, dir, a, b) = P-meet(x, (x.at(0) + dir.at(0) * 100, x.at(1) + dir.at(1) * 100), a, b)

// 第 5 题：A、B、C、D 在一直线上，AB = BC = CD，AA′、BB′、CC′、DD′ 垂直于 l
#let fig-Q-5(width: 480 * k) = px-canvas(480, 250, origin: (130, 870), width: width, (p, u) => {
  import cetz.draw: *
  let ly = 1083
  let xs = (212, 330, 449, 565)
  let hs = (8, 7, 6, 5)
  let tops = xs.zip(hs).map(((x, h)) => (x, ly - h * 23.25))
  seg(p, (150, ly), (590, ly))
  seg(p, tops.first(), tops.last())
  for (i, t) in tops.enumerate() {
    seg(p, t, (xs.at(i), ly))
  }
  let names = ($A$, $B$, $C$, $D$)
  let names2 = ($A'$, $B'$, $C'$, $D'$)
  for (i, t) in tops.enumerate() {
    lbl(p, t, names.at(i), dir: "n", d: 10)
    lbl(p, (xs.at(i), ly), names2.at(i), dir: "s", d: 10)
  }
  lbl(p, (203, 985), $8$, dir: "c", d: 0)
  lbl(p, (576, 1025), $5$, dir: "c", d: 0)
  lbl(p, (146, ly - 4), $l$, dir: "c", d: 0)
})

