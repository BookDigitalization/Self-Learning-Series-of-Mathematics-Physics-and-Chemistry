// 图 3·48：定理，MN 是梯形 ABCD 的中位线；延长 DN 交 AB 的延长线于 S
#let fig-K-3-48(width: 410 * k) = px-canvas(410, 160, origin: (460, 940), width: width, (p, u) => {
  import cetz.draw: *
  let (D, C, A, B) = ((546, 954), (681, 956), (480, 1089), (712, 1090))
  let M = K-mid(D, A)
  let N = K-mid(C, B)
  let S = (848, 1090)
  K-hatch(p, (D, C, N), -25, 7)
  K-hatch(p, (N, B, S), -25, 7)
  K-b(p, A, B)
  K-b(p, B, C)
  K-b(p, C, D)
  K-b(p, D, A)
  K-b(p, M, N)
  // 原图：辅助线 DN、NS 和延长线 BS 都是虚线（阴影三角形的边）
  dseg(p, D, N)
  dseg(p, N, S)
  dseg(p, B, S)
  ticks(p, D, M, 1)
  ticks(p, M, A, 1)
  ticks(p, C, N, 1)
  ticks(p, N, B, 1)
  lbl(p, (540, 948), $D$, dir: "c", d: 0)
  lbl(p, (691, 949), $C$, dir: "c", d: 0)
  lbl(p, (499, 1018), $M$, dir: "c", d: 0)
  lbl(p, (708, 1021), $N$, dir: "c", d: 0)
  lbl(p, (468, 1097), $A$, dir: "c", d: 0)
  lbl(p, (712, 1104), $B$, dir: "c", d: 0)
  lbl(p, (862, 1092), $S$, dir: "c", d: 0)
})

