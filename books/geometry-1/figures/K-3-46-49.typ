// 图 3·46：例 3，已知四条线段 a、b、c、d（左），草图（右，阴影为 △C′E′B′）
#let fig-K-3-46(width: 565 * k) = px-canvas(565, 185, origin: (215, 935), width: width, (p, u) => {
  import cetz.draw: *
  pseg(p, (220, 960), (470, 960), s: 4)
  pseg(p, (220, 996), (362, 996), s: 4)
  pseg(p, (220, 1027), (356, 1027), s: 4)
  pseg(p, (220, 1062), (374, 1062), s: 4)
  lbl(p, (340, 951), $a$, dir: "c", d: 0)
  lbl(p, (290, 986), $b$, dir: "c", d: 0)
  lbl(p, (282, 1018), $c$, dir: "c", d: 0)
  lbl(p, (297, 1052), $d$, dir: "c", d: 0)
  let (D, C, A, B) = ((572, 957), (700, 955), (520, 1091), (755, 1089))
  let E = (652, 1089)
  K-hatch(p, (C, E, B), 35, 7)
  K-b(p, D, C)
  K-b(p, C, B)
  K-b(p, B, A)
  K-b(p, A, D)
  K-b(p, C, E)
  lbl(p, (565, 946), $D'$, dir: "c", d: 0)
  lbl(p, (710, 941), $C'$, dir: "c", d: 0)
  lbl(p, (510, 1097), $A'$, dir: "c", d: 0)
  lbl(p, (650, 1104), $E'$, dir: "c", d: 0)
  lbl(p, (765, 1095), $B'$, dir: "c", d: 0)
  lbl(p, (635, 946), $c$, dir: "c", d: 0)
  lbl(p, (536, 1012), $d$, dir: "c", d: 0)
  lbl(p, (665, 1026), $d$, dir: "c", d: 0)
  lbl(p, (738, 1012), $b$, dir: "c", d: 0)
  lbl(p, (700, 1106), $(a - c)$, dir: "c", d: 0)
})

