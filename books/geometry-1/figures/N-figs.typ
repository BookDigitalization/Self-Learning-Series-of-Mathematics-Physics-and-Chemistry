// 图 4·39（p.244）直线和圆的三种位置关系
#let fig-N-39(width: 780 * k) = px-canvas(780, 315, origin: (120, 140), width: width, (p, u) => {
  import cetz.draw: *
  // (1) 相离
  let O = (272, 292)
  circ(p, O, 99)
  seg(p, (140, 166), (372, 166))
  seg(p, O, (272, 166), stroke: lb)
  N-ctr(p, O, $O$, dir: "s", d: 11)
  lbl(p, (146, 166), $l$, dir: "n", d: 8)
  lbl(p, (272, 166), $P$, dir: "n", d: 11)
  lbl(p, (272, 193), $C$, dir: "se", d: 11)
  lbl(p, (287, 180), $d$, dir: "c", d: 0)
  lbl(p, (270, 430), tt[(1)相离], dir: "c", d: 0)
  // (2) 相交
  let O = (519, 286)
  circ(p, O, 99.5)
  let y = 219
  let h = calc.sqrt(99.5 * 99.5 - 67 * 67)
  seg(p, (405, y), (620, y))
  seg(p, O, (519, y), stroke: lb)
  N-ctr(p, O, $O$, dir: "s", d: 11)
  lbl(p, (409, y), $l$, dir: "n", d: 8)
  lbl(p, (519 - h, y), $R$, dir: "nw", d: 9)
  lbl(p, (519 + h, y), $S$, dir: "ne", d: 9)
  lbl(p, (519, y), $M$, dir: "ne", d: 10)
  lbl(p, (519, 186.5), $C$, dir: "n", d: 9)
  anglearc(p, (519, y), O, (620, y), 13)
  lbl(p, (541, 240), $d$, dir: "c", d: 0)
  lbl(p, (512, 430), tt[(2)相交], dir: "c", d: 0)
  circle(p(519 - h, y), radius: 2.5, fill: white, stroke: lw)
  circle(p(519 + h, y), radius: 2.5, fill: white, stroke: lw)
  // (3) 相切
  let O = (756, 289)
  circ(p, O, 99.5)
  seg(p, (640, 189), (862, 189))
  seg(p, O, (756, 189), stroke: lb)
  seg(p, O, (847, 189), stroke: dsh)
  N-ctr(p, O, $O$, dir: "s", d: 11)
  lbl(p, (645, 189), $l$, dir: "n", d: 8)
  lbl(p, (756, 189), $C$, dir: "nw", d: 11)
  lbl(p, (847, 189), $Q$, dir: "ne", d: 9)
  anglearc(p, (756, 189), O, (862, 189), 13)
  lbl(p, (776, 207), $d$, dir: "c", d: 0)
  lbl(p, (762, 430), tt[(3)相切], dir: "c", d: 0)
})

