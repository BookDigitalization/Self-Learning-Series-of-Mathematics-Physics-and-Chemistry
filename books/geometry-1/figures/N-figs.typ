// 图 4·34（p.237）(1) D 在圆外 (2) D 在圆内
#let fig-N-34(width: 670 * k) = px-canvas(670, 290, origin: (155, 875), width: width, (p, u) => {
  import cetz.draw: *
  // (1)
  let (A, B, C, D) = ((283, 897), (190, 1057), (368, 1073), (413, 935))
  let c = N-circum(A, B, C)
  let r = calc.sqrt(calc.pow(A.at(0) - c.at(0), 2) + calc.pow(A.at(1) - c.at(1), 2))
  let S = N-second(A, D, c)
  circ(p, c, r)
  poly(p, (A, B, C, D, S), close: false)
  seg(p, D, A)
  seg(p, S, C, stroke: dsh)
  N-ctr(p, (c.at(0) + 4, c.at(1) - 4), $O$, dir: "e", d: 11)
  lbl(p, A, $A$, dir: "n", d: 9)
  lbl(p, B, $B$, dir: "sw", d: 9)
  lbl(p, C, $C$, dir: "se", d: 9)
  lbl(p, D, $D$, dir: "e", d: 11)
  lbl(p, S, $S$, dir: "ne", d: 9)
  lbl(p, (290, 1150), tt[(1)], dir: "c", d: 0)
  // (2)
  let (A, B, C, D) = ((651, 897), (592, 1055), (770, 1077), (738, 942))
  let c = N-circum(A, B, C)
  let r = calc.sqrt(calc.pow(A.at(0) - c.at(0), 2) + calc.pow(A.at(1) - c.at(1), 2))
  let S = N-second(A, D, c)
  circ(p, c, r)
  poly(p, (A, B, C, D, A), close: false)
  seg(p, D, S, stroke: dsh)
  seg(p, S, C, stroke: dsh)
  N-ctr(p, (c.at(0) + 4, c.at(1) - 4), $O$, dir: "e", d: 11)
  lbl(p, A, $A$, dir: "n", d: 9)
  lbl(p, B, $B$, dir: "sw", d: 9)
  lbl(p, C, $C$, dir: "se", d: 9)
  lbl(p, D, $D$, dir: "ne", d: 9)
  lbl(p, S, $S$, dir: "ne", d: 9)
  lbl(p, (690, 1150), tt[(2)], dir: "c", d: 0)
})

