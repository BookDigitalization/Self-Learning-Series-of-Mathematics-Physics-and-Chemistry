// 图 4·36（p.239）例 1
#let fig-N-36(width: 280 * k) = px-canvas(280, 455, origin: (600, 380), width: width, (p, u) => {
  import cetz.draw: *
  let c = (732, 503)
  let r = 109
  let (A, B, C, D) = (N-cp(c, r, 164), N-cp(c, r, 216), N-cp(c, r, 291), N-cp(c, r, 16))
  let E = N-meet(A, B, D, C)
  let ub = N-unit(E, B)
  let uc = N-unit(E, C)
  let bis = (ub.at(0) + uc.at(0), ub.at(1) + uc.at(1))
  let E2 = (E.at(0) + bis.at(0), E.at(1) + bis.at(1))
  let G = N-meet(E, E2, A, D)
  let F = N-meet(E, E2, B, C)
  circ(p, c, r)
  seg(p, A, D)
  seg(p, A, E)
  seg(p, D, E)
  seg(p, B, C)
  seg(p, E, G)
  for rr in (13, 17) {
    anglearc(p, A, D, B, rr)
    anglearc(p, C, E, B, rr)
  }
  anglearc(p, E, B, C, 44)
  let un = N-unit((0, 0), bis)
  let l3 = N-mv(E, (un.at(0) - 0.16, un.at(1)), 58)
  let l4 = N-mv(E, (un.at(0) + 0.16, un.at(1)), 58)
  N-num(p, l3.at(0) - 6, l3.at(1), $3$)
  N-num(p, l4.at(0) + 6, l4.at(1), $4$)
  N-num(p, F.at(0) + 11, F.at(1) - 21, $1$)
  N-num(p, G.at(0) + 17, G.at(1) + 10, $2$)
  lbl(p, A, $A$, dir: "nw", d: 8)
  lbl(p, D, $D$, dir: "ne", d: 9)
  lbl(p, G, $G$, dir: "n", d: 10)
  lbl(p, B, $B$, dir: "sw", d: 9)
  lbl(p, C, $C$, dir: "se", d: 9)
  lbl(p, F, $F$, dir: "se", d: 9)
  lbl(p, E, $E$, dir: "s", d: 11)
})

