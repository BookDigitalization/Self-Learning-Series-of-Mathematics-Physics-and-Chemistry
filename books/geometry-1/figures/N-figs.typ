// 图 4·32（p.236）圆内接四边形 ABCD
#let fig-N-32(width: 290 * k) = px-canvas(290, 255, origin: (150, 895), width: width, (p, u) => {
  import cetz.draw: *
  let c = (295, 1030)
  let r = 117
  let (A, B, C, D) = (N-cp(c, r, 206), N-cp(c, r, 334), N-cp(c, r, 73), N-cp(c, r, 145))
  circ(p, c, r)
  poly(p, (A, B, C, D), close: true)
  N-ctr(p, c, $O$)
  lbl(p, A, $A$, dir: "sw")
  lbl(p, B, $B$, dir: "se")
  lbl(p, C, $C$, dir: "n")
  lbl(p, D, $D$, dir: "nw")
})

