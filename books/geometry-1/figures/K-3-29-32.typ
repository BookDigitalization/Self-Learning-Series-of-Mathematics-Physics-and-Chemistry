  lbl(p, (738, 663), $C$, dir: "c", d: 0)
  lbl(p, (660, 740), $h$, dir: "c", d: 0)
  lbl(p, (427, 817), $A$, dir: "c", d: 0)
  lbl(p, (567, 822), $a$, dir: "c", d: 0)
  lbl(p, (648, 822), $S$, dir: "c", d: 0)
  lbl(p, (676, 822), $B$, dir: "c", d: 0)
