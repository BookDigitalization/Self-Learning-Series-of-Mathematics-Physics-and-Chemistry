// 图 3·29（原书 p.188）、3·30、3·31（p.189）、3·32（p.190）；页面 200 dpi 坐标。
#import "K-base.typ": *

// 图 3·29：AB 的上方与 AB 距离等于 l 的点在直线 PQ 上；下方为虚线 P′Q′
#let fig-K-3-29(width: 420 * k) = px-canvas(420, 300, origin: (290, 250), width: width, (p, u) => {
  import cetz.draw: *
  let (P, Q) = ((382, 316), (608, 316))
  let (M, N, K, H) = ((382, 421), (608, 421), (450, 421), (499, 421))
  let (S, R) = ((450, 277), (499, 347))
  let (P2, Q2) = ((382, 522), (608, 522))
  K-b(p, (315, 316), (672, 316))
  K-b(p, (312, 421), (672, 421))
  K-b(p, P, M)
  K-b(p, Q, N)
  K-b(p, S, K)
  K-b(p, R, H)
  seg(p, M, P2, stroke: dsh)
  seg(p, N, Q2, stroke: dsh)
  seg(p, (320, 522), (680, 522), stroke: dsh)
  for c in (P, Q, S, R) { K-ring(p, c) }
  lbl(p, P, $P$, dir: "n", d: 13)
  lbl(p, Q, $Q$, dir: "n", d: 13)
  lbl(p, S, $S$, dir: "n", d: 13)
  lbl(p, R, $R$, dir: "n", d: 13)
  lbl(p, (304, 424), $A$, dir: "c", d: 0)
  lbl(p, (687, 418), $B$, dir: "c", d: 0)
  lbl(p, M, $M$, dir: "sw", d: 13)
  lbl(p, K, $K$, dir: "s", d: 14)
  lbl(p, H, $H$, dir: "s", d: 14)
  lbl(p, N, $N$, dir: "sw", d: 13)
  lbl(p, P2, $P'$, dir: "se", d: 12)
  lbl(p, Q2, $Q'$, dir: "se", d: 12)
  for x in (382, 608) {
    lbl(p, (x + 20, 366), $l$, dir: "c", d: 0)
    lbl(p, (x + 20, 470), $l$, dir: "c", d: 0)
  }
})

