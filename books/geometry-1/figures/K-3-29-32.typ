// 图 3·31：例 1，圆 O 上求一点 P 使它到直线 l 的距离为 d
#let fig-K-3-31(width: 410 * k) = px-canvas(410, 260, origin: (440, 910), width: width, (p, u) => {
  import cetz.draw: *
  let O = (675, 988)
  let slope = -0.178
  let onAB(x) = (x, 1056 + slope * (x - 510))
  let onl(x) = (x, 1156 + slope * (x - 530) - 0.0)
  circ(p, O, 71, stroke: lb)
  K-ring(p, O, r: 2.5)
  // d 线段
  pseg(p, (448, 948), (545, 948))
  lbl(p, (518, 936), $d$, dir: "c", d: 0)
  K-b(p, onAB(510), onAB(817))
  K-b(p, onl(530), onl(835))
  let (E, F) = (onAB(576), onl(595))
  let (P, P2) = ((625, 1036), (738, 1016))
  let (S, S2) = (onl(645), onl(755))
  K-b(p, E, F)
  seg(p, P, S, stroke: dsh)
  seg(p, P2, S2, stroke: dsh)
  K-ring(p, P, r: 2.5)
  K-ring(p, P2, r: 2.5)
  lbl(p, O, $O$, dir: "n", d: 12)
  lbl(p, (502, 1058), $A$, dir: "c", d: 0)
  lbl(p, (825, 1000), $B$, dir: "c", d: 0)
  lbl(p, (524, 1156), $l$, dir: "c", d: 0)
  lbl(p, (573, 1034), $E$, dir: "c", d: 0)
  lbl(p, (598, 1154), $F$, dir: "c", d: 0)
  lbl(p, (614, 1052), $P$, dir: "c", d: 0)
  lbl(p, (751, 1027), $P'$, dir: "c", d: 0)
  lbl(p, (647, 1088), $d$, dir: "c", d: 0)
  lbl(p, (648, 1147), $S$, dir: "c", d: 0)
  lbl(p, (758, 1130), $S'$, dir: "c", d: 0)
})

