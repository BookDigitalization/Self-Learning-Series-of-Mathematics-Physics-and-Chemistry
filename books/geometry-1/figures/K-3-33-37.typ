// 图 3·33（原书 p.192）、3·34（p.193）、3·35、3·36（p.194）、3·37（p.195）；页面 200 dpi 坐标。
#import "K-base.typ": *

// 图 3·33：AN = BN，NP ∥ AC，BS ∥ AC（点划线）
#let fig-K-3-33(width: 320 * k) = px-canvas(320, 235, origin: (545, 752), width: width, (p, u) => {
  import cetz.draw: *
  let (A, B, C) = ((560, 964), (732, 774), (795, 965))
  let N = K-mid(A, B)
  let M = (763, 869)
  K-b(p, A, B)
  K-b(p, B, C)
  K-b(p, A, C)
  seg(p, (578, 774), (835, 774), stroke: (paint: black, thickness: 0.6pt, dash: "dash-dotted"))
  seg(p, N, (840, 869), stroke: lb)
  ticks(p, A, N, 1)
  ticks(p, N, B, 1)
  lbl(p, (733, 761), $B$, dir: "c", d: 0)
  lbl(p, (845, 776), $S$, dir: "c", d: 0)
  lbl(p, (639, 861), $N$, dir: "c", d: 0)
  lbl(p, (776, 860), $M$, dir: "c", d: 0)
  lbl(p, (849, 872), $P$, dir: "c", d: 0)
  lbl(p, (550, 969), $A$, dir: "c", d: 0)
  lbl(p, (806, 972), $C$, dir: "c", d: 0)
})

// 图 3·34：MN 是 △ABC 的中位线；CS ∥ AB（阴影为 △ANM 和 △CNS）
#let fig-K-3-34(width: 370 * k) = px-canvas(370, 235, origin: (480, 205), width: width, (p, u) => {
  import cetz.draw: *
  let (A, B, C) = ((672, 219), (509, 424), (742, 422))
  let M = K-mid(A, B)
  let N = K-mid(A, C)
  let S = (2 * N.at(0) - M.at(0), 2 * N.at(1) - M.at(1))
  K-hatch(p, (A, M, N), 28, 8.5)
  K-hatch(p, (N, C, S), 28, 8.5)
  K-b(p, A, B)
  K-b(p, B, C)
  K-b(p, A, C)
  K-b(p, M, N)
  seg(p, N, S, stroke: dsh)
  seg(p, C, S, stroke: dsh)
  ticks(p, A, M, 1)
  ticks(p, M, B, 1)
  ticks(p, A, N, 1)
  ticks(p, N, C, 1)
  ticks(p, M, N, 3, gap: 2.5)
  ticks(p, N, S, 1)
  ticks(p, C, S, 1)
  lbl(p, (672, 206), $A$, dir: "c", d: 0)
  lbl(p, (581, 322), $M$, dir: "c", d: 0)
  lbl(p, (719, 305), $N$, dir: "c", d: 0)
  lbl(p, (835, 316), $S$, dir: "c", d: 0)
  lbl(p, (499, 428), $B$, dir: "c", d: 0)
  lbl(p, (751, 434), $C$, dir: "c", d: 0)
})

// 图 3·35：Rt△ABC 中 M 是斜边中点，MN ∥ AC
#let fig-K-3-35(width: 310 * k) = px-canvas(310, 205, origin: (560, 205), width: width, (p, u) => {
  import cetz.draw: *
  let (A, C, B) = ((577, 214), (577, 386), (850, 386))
  let M = K-mid(A, B)
  let N = (M.at(0), 386)
  K-b(p, A, C)
  K-b(p, C, B)
  K-b(p, A, B)
  K-b(p, C, M)
  seg(p, M, N, stroke: dsh)
  rtmark(p, N, C, M, s: 8)
  ticks(p, A, M, 1)
  ticks(p, M, B, 1)
  ticks(p, C, N, 1)
  ticks(p, N, B, 1)
  lbl(p, (573, 207), $A$, dir: "c", d: 0)
  lbl(p, (567, 395), $C$, dir: "c", d: 0)
  lbl(p, (861, 394), $B$, dir: "c", d: 0)
  lbl(p, (723, 292), $M$, dir: "c", d: 0)
  lbl(p, (705, 399), $N$, dir: "c", d: 0)
})

// 图 3·36：四边形 ABCD，E、F、G、H 是各边中点；AC 为虚线
