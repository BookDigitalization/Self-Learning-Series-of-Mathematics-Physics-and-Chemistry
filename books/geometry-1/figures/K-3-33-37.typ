  import cetz.draw: *
  let (D, C, B, A) = ((566, 1100), (715, 1051), (835, 1230), (584, 1224))
  let (E, F, G, H) = (K-mid(A, B), K-mid(B, C), K-mid(C, D), K-mid(D, A))
  K-b(p, A, B)
  K-b(p, B, C)
  K-b(p, C, D)
  K-b(p, D, A)
  K-b(p, E, F)
  K-b(p, F, G)
  K-b(p, G, H)
  K-b(p, H, E)
  seg(p, A, C, stroke: dsh)
  lbl(p, (556, 1100), $D$, dir: "c", d: 0)
  lbl(p, (712, 1040), $C$, dir: "c", d: 0)
  lbl(p, (844, 1232), $B$, dir: "c", d: 0)
  lbl(p, (577, 1236), $A$, dir: "c", d: 0)
  lbl(p, (712, 1241), $E$, dir: "c", d: 0)
  lbl(p, (784, 1132), $F$, dir: "c", d: 0)
  lbl(p, (626, 1068), $G$, dir: "c", d: 0)
  lbl(p, (556, 1160), $H$, dir: "c", d: 0)
})

// 图 3·37：三角形的三条中线；延长 AD 至 K，使 GK = AG
#let fig-K-3-37(width: 305 * k) = px-canvas(305, 285, origin: (540, 950), width: width, (p, u) => {
  import cetz.draw: *
  let (A, B, C) = ((747, 970), (557, 1147), (822, 1155))
  let (D, E, F) = (K-mid(B, C), K-mid(A, C), K-mid(A, B))
  let G = ((A.at(0) + B.at(0) + C.at(0)) / 3, (A.at(1) + B.at(1) + C.at(1)) / 3)
  let K = (2 * G.at(0) - A.at(0), 2 * G.at(1) - A.at(1))
  K-b(p, A, B)
  K-b(p, B, C)
  K-b(p, A, C)
  K-b(p, A, D)
  K-b(p, B, E)
  K-b(p, C, F)
  seg(p, D, K, stroke: dsh)
  seg(p, B, K, stroke: dsh)
  seg(p, C, K, stroke: dsh)
  lbl(p, (743, 956), $A$, dir: "c", d: 0)
  lbl(p, (545, 1148), $B$, dir: "c", d: 0)
  lbl(p, (834, 1160), $C$, dir: "c", d: 0)
  lbl(p, (641, 1050), $F$, dir: "c", d: 0)
  lbl(p, (794, 1053), $E$, dir: "c", d: 0)
  lbl(p, (699, 1077), $G$, dir: "c", d: 0)
  lbl(p, (698, 1166), $D$, dir: "c", d: 0)
  lbl(p, (672, 1225), $K$, dir: "c", d: 0)
})
