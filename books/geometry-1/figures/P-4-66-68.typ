// 图 4·66（原书 p.273）、图 4·67（p.273）、图 4·68（p.274）；页面 200 dpi 坐标。
#import "P-base.typ": *

// 图 4·66 履带/传动带与轮子相切：(1) 外公切线，(2) 内公切线
#let fig-P-4-66(width: 760 * k) = px-canvas(760, 215, origin: (100, 375), width: width, (p, u) => {
  import cetz.draw: *
  // (1)
  let c1 = (182, 462)
  let c2 = (390, 467)
  circ(p, c1, 60)
  circ(p, c1, 24)
  circ(p, c2, 50)
  circ(p, c2, 24)
  let (a1, a2) = P-tan(c1, 60, c2, 50, "out", -1)
  seg(p, a1, a2)
  let (b1, b2) = P-tan(c1, 60, c2, 50, "out", 1)
  seg(p, b1, b2)
  P-arrow(p, (268, 421), (302, 422))
  P-arrow(p, (302, 507), (268, 507))
  ctext(p, (300, 567), $(1)$)
  // (2)
  let d1 = (578, 460)
  let d2 = (787, 456)
  circ(p, d1, 75)
  circ(p, d1, 24)
  circ(p, d2, 48)
  circ(p, d2, 24)
  let (e1, e2) = P-tan(d1, 75, d2, 48, "in", -1)
  seg(p, e1, e2)
  let (f1, f2) = P-tan(d1, 75, d2, 48, "in", 1)
  seg(p, f1, f2)
  let x = P-meet(e1, e2, f1, f2)
  P-arrow(p, P-go(x, f1, 55), P-go(x, f1, 78))
  P-arrow(p, P-go(x, e2, 28), P-go(x, e2, 52))
  ctext(p, (660, 567), $(2)$)
})

// 图 4·67 两圆的外公切线草图（M 圆内的小圆半径为 MA − NB）
#let fig-P-4-67(width: 530 * k) = px-canvas(530, 235, origin: (230, 1030), width: width, (p, u) => {
  import cetz.draw: *
  let m = (342, 1147)
  let n = (655, 1124)
  circ(p, m, 86)
  circ(p, m, 30)
  circ(p, n, 56)
  let (a, b) = P-tan(m, 86, n, 56, "out", -1)
  let (a2, b2) = P-tan(m, 86, n, 56, "out", 1)
  P-line(p, a, b, e1: 98, e2: 80)
  P-line(p, a2, b2, e1: 95, e2: 80)
  let pp = P-go(m, a, 30)
  dseg(p, m, a)
  dseg(p, n, b)
  dseg(p, pp, n)
  dseg(p, m, n)
  P-cen(p, m, r: 2.5)
  P-cen(p, n, r: 2.5)
  lbl(p, a, $A$, dir: "n", d: 10)
  lbl(p, b, $B$, dir: "n", d: 10)
  lbl(p, a2, $A'$, dir: "se", d: 10)
  lbl(p, b2, $B'$, dir: "s", d: 10)
  lbl(p, pp, $P$, dir: "nw", d: 12)
  lbl(p, m, $M$, dir: "sw", d: 9)
  lbl(p, n, $N$, dir: "e", d: 10)
})

// 图 4·68 两圆的内公切线（辅助圆以 M 为圆心，半径为两圆半径之和）
// 原图在 B' 处的字母印成 R'，按正文（内公切线 A'B'）读作 B'。
#let fig-P-4-68(width: 480 * k) = px-canvas(480, 330, origin: (270, 880), width: width, (p, u) => {
  import cetz.draw: *
  let m = (430, 1040)
  let n = (667, 1040)
  circ(p, m, 80)
  circ(p, n, 55)
  circle(p(..m), radius: 135, stroke: dsh)
  let (a, b) = P-tan(m, 80, n, 55, "in", -1)
  let (a2, b2) = P-tan(m, 80, n, 55, "in", 1)
  P-line(p, a, b, e1: 45, e2: 65)
  P-line(p, a2, b2, e1: 125, e2: 60)
  let pp = P-pt(m, 135, P-ang(m, a))
  dseg(p, m, pp)
  dseg(p, P-go(n, pp, 250), n)
  dseg(p, n, b)
  P-cen(p, m, r: 2.5)
  P-cen(p, n, r: 2.5)
  lbl(p, a, $A$, dir: "nw", d: 10)
  lbl(p, pp, $P$, dir: "ne", d: 10)
  lbl(p, a2, $A'$, dir: "se", d: 10)
  lbl(p, b, $B$, dir: "sw", d: 10)
  lbl(p, b2, $B'$, dir: "nw", d: 10)
  lbl(p, m, $M$, dir: "w", d: 14)
  lbl(p, n, $N$, dir: "e", d: 12)
})
