  circ(p, N, r2)
  let B = O-pa(M, r1, 78)
  let A = O-pa(M, r1, 258)
  let D = O-pa(N, r2, 78)
  let C = O-pa(N, r2, 258)
  seg(p, A, B)
  seg(p, C, D)
  seg(p, B, C)
  seg(p, A, D)
  seg(p, M, N, stroke: dsh)
  O-ring(p, M)
  O-ring(p, N)
  lbl(p, M, $M$, dir: "w", d: 12)
  lbl(p, N, $N$, dir: "e", d: 12)
  lbl(p, A, $A$, dir: "s", d: 10)
  lbl(p, B, $B$, dir: "n", d: 10)
  lbl(p, C, $C$, dir: "s", d: 10)
  lbl(p, D, $D$, dir: "n", d: 10)
  lbl(p, P, $P$, dir: "ne", d: 11)
  lbl(p, (650, 289), tsm[1], dir: "c", d: 0)
  lbl(p, (788, 316), tsm[2], dir: "c", d: 0)
})

// 习题 4·13 第 6 题：画出下列的图形（两个）
#let fig-O-e6(width: 630 * k) = px-canvas(630, 170, origin: (188, 546), width: width, (p, u) => {
  import cetz.draw: *
  // 左：大圆内四个过圆心、与大圆内切的小圆
  let c0 = (275, 630)
  circ(p, c0, 77.5)
  for (dx, dy) in ((-1, 0), (1, 0), (0, -1), (0, 1)) {
    circ(p, (c0.at(0) + dx * 38.75, c0.at(1) + dy * 38.75), 38.75)
  }
  // 右：两个外切等圆、过两圆心的中间圆、以及两个半径一半的小圆
  let (L, R2) = ((575, 630), (730, 630))
  circ(p, L, 77.5)
  circ(p, R2, 77.5)
  circ(p, (652.5, 630), 77.5)
  circ(p, (613.75, 630), 38.75)
  circ(p, (691.25, 630), 38.75)
})

// 习题 4·13 第 8 题：A、B 是两圆的交点；PAQ、RBS 分别在两直线上，P、R、Q、S 在两圆上；∠1、∠2
#let fig-O-e8(width: 445 * k) = px-canvas(445, 270, origin: (283, 988), width: width, (p, u) => {
  import cetz.draw: *
  let (C1, r1) = ((392, 1117), 93)
  let (C2, r2) = ((559, 1121), 124)
  circ(p, C1, r1)
  circ(p, C2, r2)
  let (A, B) = O-cc(C1, r1, C2, r2)
  let P = O-pa(C1, r1, 157)
  let R = O-pa(C1, r1, 212)
  let Q = O-lc(P, A, C2, r2).at(1)
  let S = O-lc(R, B, C2, r2).at(1)
  let ext = (Q.at(0) + 0.5 * (Q.at(0) - A.at(0)), Q.at(1) + 0.5 * (Q.at(1) - A.at(1)))
  seg(p, P, ext)
  seg(p, R, S)
  seg(p, P, R)
  seg(p, Q, S)
  seg(p, A, B, stroke: dsh)
  anglearc(p, P, R, Q, 18)
  anglearc(p, Q, A, S, 15)
  anglearc(p, B, A, S, 15)
  lbl(p, P, $P$, dir: "w", d: 11)
  lbl(p, Q, $Q$, dir: "n", d: 12)
  lbl(p, A, $A$, dir: "n", d: 13)
  lbl(p, B, $B$, dir: "s", d: 13)
  lbl(p, R, $R$, dir: "sw", d: 10)
  lbl(p, S, $S$, dir: "se", d: 10)
  lbl(p, (Q.at(0) + 17, Q.at(1) + 14), tsm[1], dir: "c", d: 0)
  lbl(p, (B.at(0) + 12, B.at(1) - 12), tsm[2], dir: "c", d: 0)
})
