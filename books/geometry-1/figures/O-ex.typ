// 习题插图：习题 4·11 第 3 题（原书 p.266）；习题 4·13 第 2 题（p.271）、第 4、5、6、8 题（p.272）。页面 200 dpi 坐标。
#import "O-base.typ": *

// 习题 4·11 第 3 题：一直线与两同心圆各交于 A、D；B、C。MK ⊥ 直线（虚线，向上延伸）
#let fig-O-q3(width: 285 * k) = px-canvas(285, 250, origin: (585, 170), width: width, (p, u) => {
  import cetz.draw: *
  let M = (721, 312)
  circ(p, M, 97.5)
  circ(p, M, 61.5)
  let P0 = (591, 270)
  let P1 = (859, 262.5)
  line(p(..P0), p(..P1), stroke: lw, mark: (end: "stealth", fill: black, scale: 0.45))
  let (A, D) = O-lc(P0, P1, M, 97.5)
  let (B, C) = O-lc(P0, P1, M, 61.5)
  let K = O-foot(M, P0, P1)
  let top = O-go(M, K, 138)
  seg(p, M, top, stroke: dsh)
  O-ring(p, M)
  lbl(p, M, $M$, dir: "s", d: 13)
  lbl(p, A, $A$, dir: "nw", d: 11)
  lbl(p, B, $B$, dir: "nw", d: 11)
  lbl(p, C, $C$, dir: "ne", d: 11)
  lbl(p, D, $D$, dir: "ne", d: 11)
  lbl(p, K, $K$, dir: "se", d: 11)
})

// 习题 4·13 第 2 题：两图，圆 M 和 N 相切于 P；过 P 的直线交两圆于 A、B
#let fig-O-e2(width: 645 * k) = px-canvas(645, 250, origin: (185, 555), width: width, (p, u) => {
  import cetz.draw: *
  // 左：外切
  let (M, N) = ((262, 669), (425, 679))
  let (r1, r2) = (75, 88.3)
  circ(p, M, r1)
  circ(p, N, r2)
  let e = O-u(M, N)
  let P = (M.at(0) + r1 * e.at(0), M.at(1) + r1 * e.at(1))
  let A = O-pa(M, r1, 107)
  let B = (P.at(0) + (r2 / r1) * (P.at(0) - A.at(0)), P.at(1) + (r2 / r1) * (P.at(1) - A.at(1)))
  seg(p, M, A)
  seg(p, N, B)
  seg(p, A, B)
  seg(p, M, P, stroke: dsh)
  seg(p, P, N, stroke: dsh)
  O-ring(p, M)
  O-ring(p, N)
  lbl(p, M, $M$, dir: "w", d: 12)
  lbl(p, N, $N$, dir: "e", d: 12)
  lbl(p, A, $A$, dir: "nw", d: 10)
  lbl(p, B, $B$, dir: "se", d: 10)
  lbl(p, P, $P$, dir: "ne", d: 11)
  // 右：内切（M 为大圆圆心）
  let (M2, N2) = ((687, 684), (741, 702))
  let (R2, r3) = (113.5, 57.2)
  circ(p, M2, R2)
  circ(p, N2, r3)
  let e2 = O-u(M2, N2)
  let P2 = (M2.at(0) + R2 * e2.at(0), M2.at(1) + R2 * e2.at(1))
  let A2 = O-pa(M2, R2, 94.8)
  let B2 = (P2.at(0) + (r3 / R2) * (A2.at(0) - P2.at(0)), P2.at(1) + (r3 / R2) * (A2.at(1) - P2.at(1)))
  seg(p, M2, A2)
  seg(p, N2, B2)
  seg(p, A2, P2)
  seg(p, M2, P2, stroke: dsh)
  O-ring(p, M2)
  O-ring(p, N2)
  lbl(p, M2, $M$, dir: "sw", d: 12)
  lbl(p, N2, $N$, dir: "s", d: 12)
  lbl(p, A2, $A$, dir: "n", d: 10)
  lbl(p, B2, $B$, dir: "ne", d: 10)
  lbl(p, P2, $P$, dir: "se", d: 11)
})

// 习题 4·13 第 4 题：外切两圆 M、N 切于 C；过 C 的直线交两圆于 A、B；AP、BQ 是切线
#let fig-O-e4(width: 405 * k) = px-canvas(405, 250, origin: (125, 166), width: width, (p, u) => {
  import cetz.draw: *
  let (M, N) = ((272, 305), (433, 306))
  let (r1, r2) = (98, 63)
  circ(p, M, r1)
  circ(p, N, r2)
  let e = O-u(M, N)
  let C = (M.at(0) + r1 * e.at(0), M.at(1) + r1 * e.at(1))
  let A = O-pa(M, r1, 116.7)
  let B = (C.at(0) + (r2 / r1) * (C.at(0) - A.at(0)), C.at(1) + (r2 / r1) * (C.at(1) - A.at(1)))
  // A 处切线（垂直于 MA）
  let ta = O-u(M, A)
  let da = (-ta.at(1), ta.at(0))
  let da = if da.at(0) < 0 { (-da.at(0), -da.at(1)) } else { da }   // 指向右上
  let P = (A.at(0) - 105 * da.at(0), A.at(1) - 105 * da.at(1))
  let T1 = (A.at(0) + 100 * da.at(0), A.at(1) + 100 * da.at(1))
  seg(p, P, T1)
  // B 处切线（垂直于 NB）
  let tb = O-u(N, B)
  let db = (-tb.at(1), tb.at(0))
  let db = if db.at(0) < 0 { (-db.at(0), -db.at(1)) } else { db }
  let Q = (B.at(0) - 75 * db.at(0), B.at(1) - 75 * db.at(1))
  let T2 = (B.at(0) + 70 * db.at(0), B.at(1) + 70 * db.at(1))
  seg(p, Q, T2)
  seg(p, A, B)
  seg(p, M, A, stroke: dsh)
  seg(p, M, N, stroke: dsh)
  seg(p, N, B, stroke: dsh)
  O-ring(p, M)
  O-ring(p, N)
  lbl(p, M, $M$, dir: "sw", d: 11)
  lbl(p, N, $N$, dir: "e", d: 12)
  lbl(p, A, $A$, dir: "nw", d: 11)
  lbl(p, B, $B$, dir: "se", d: 10)
  lbl(p, C, $C$, dir: "ne", d: 10)
  lbl(p, P, $P$, dir: "w", d: 11)
  lbl(p, Q, $Q$, dir: "sw", d: 10)
})

// 习题 4·13 第 5 题：M、N 两圆外切于 P；AB、CD 是平行的直径；∠1 = ∠BPM 处标 1，∠2 处标 2
