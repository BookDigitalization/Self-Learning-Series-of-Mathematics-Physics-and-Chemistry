// ───────────── 插图（局部） ─────────────
#let AB-k = 0.0145cm
#let AB-t(p, pt, body) = { import cetz.draw: *; content(p(..pt), tt(body)) }
#let AB-curve(p, f, t0, t1, n: 80, st: lw) = {
  import cetz.draw: *
  line(..range(n + 1).map(i => p(..f(t0 + (t1 - t0) * i / n))), stroke: st)
}
// 极轴：极点 o 左边虚线（从 xl 起），右边实线到 xr 加箭头，xr 外标 x
#let AB-polar-axis(p, o, xl, xr) = {
  import cetz.draw: *
  line(p(xl, o.at(1)), p(..o), stroke: dsh)
  line(p(..o), p(xr, o.at(1)), stroke: lt, mark: arw)
  AB-t(p, (xr + 12, o.at(1)), $x$)
}

// 习题 6·1～6·4 第 4 题图（p.496）：x = 2a tan θ，y = 2a cos²θ，即 y = 8a³/(x² + 4a²)。
// 原点 (325, 1372)，a ≈ 32 像素；x 轴上每隔 a 一个刻度，y 轴上 a 处一个刻度。
#let AB-fig-6-4(width: 345 * AB-k) = px-canvas(345, 185, origin: (165, 1232), width: width, (p, u) => {
  import cetz.draw: *
  let o = (325, 1372)
  let s = 32
  let m(x, y) = (o.at(0) + s * x, o.at(1) - s * y)
  line(p(170, 1372), p(500, 1372), stroke: lt, mark: arw)
  line(p(325, 1410), p(325, 1245), stroke: lt, mark: arw)
  AB-t(p, (512, 1372), $x$)
  AB-t(p, (325, 1236), $y$)
  AB-t(p, (314, 1386), $O$)
  for i in (-4, -3, -2, -1, 1, 2, 3, 4) { line(p(..m(i, 0)), p(m(i, 0).at(0), 1368), stroke: lt) }
  line(p(..m(0, 1)), p(329, m(0, 1).at(1)), stroke: lt)
  AB-curve(p, x => m(x, 8 / (x * x + 4)), -4.4, 4.4)
})

// 习题 6·1～6·4 第 5 题图（p.496）：x = a cos⁴θ，y = a sin⁴θ，即抛物线 √x + √y = √a 所在的整条抛物线
// (x − y)² − 2a(x + y) + a² = 0，参数式 x = a(1+s)²/4，y = a(1−s)²/4，切两轴于 (a, 0)、(0, a)。
// 原点 (640, 1366)，a ≈ 30 像素。
#let AB-fig-6-5(width: 265 * AB-k) = px-canvas(265, 245, origin: (580, 1172), width: width, (p, u) => {
  import cetz.draw: *
  let o = (640, 1366)
  let s = 30
  let m(x, y) = (o.at(0) + s * x, o.at(1) - s * y)
  line(p(588, 1366), p(830, 1366), stroke: lt, mark: arw)
  line(p(640, 1412), p(640, 1182), stroke: lt, mark: arw)
  AB-t(p, (842, 1366), $x$)
  AB-t(p, (640, 1174), $y$)
  AB-t(p, (628, 1380), $O$)
  AB-t(p, (m(1, 0).at(0), 1380), $a$)
  AB-t(p, (627, m(0, 1).at(1)), $a$)
  AB-curve(p, t => m((1 + t) * (1 + t) / 4, (1 - t) * (1 - t) / 4), -3, 3.05)
})

// 习题 7·1～7·2 第 1(6) 题图（p.498）：ρ = −3 csc(θ − 60°)，即直线 √3 x − y − 6 = 0，
// 与极轴交于 2√3，与 90° 线交于 −6，倾角 π/3。极点 (305, 647)，1 单位 ≈ 14 像素。
#let AB-fig-7-1-6(width: 240 * AB-k) = px-canvas(240, 240, origin: (240, 545), width: width, (p, u) => {
  import cetz.draw: *
  let o = (305, 647)
  let s = 14
  let r3 = calc.sqrt(3)
  let m(x, y) = (o.at(0) + s * x, o.at(1) - s * y)
  AB-polar-axis(p, o, 250, 453)
  line(p(305, 553), p(305, 777), stroke: dsh)
  let f(y) = m(2 * r3 + y / r3, y)
  line(p(..f(-8.7)), p(..f(4.9)), stroke: lw)
  let c = m(2 * r3, 0)
  AB-curve(p, t => (c.at(0) + 20 * calc.cos(t), c.at(1) - 20 * calc.sin(t)), 0, calc.pi / 3, n: 20, st: lt)
  AB-t(p, (c.at(0) + 32, c.at(1) - 22), $π/3$)
  AB-t(p, (c.at(0) + 18, c.at(1) + 12), $2sqrt(3)$)
  AB-t(p, (289, m(0, -6).at(1)), $-6$)
  AB-t(p, (295, 658), $O$)
})

// 习题 7·1～7·2 第 1(9) 题图（p.498）：ρ = 2/(1 − cos θ)，即抛物线 y² = 4(x + 1)，顶点 −1，焦点在极点。
