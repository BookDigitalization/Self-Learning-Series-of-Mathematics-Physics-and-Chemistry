  line(p(..o), p(800, 640), stroke: lt, mark: arw)
  AB-t(p, (812, 640), $x$)
  line(p(635, 485), p(635, 773), stroke: dsh)
  AB-t(p, (600, 640), $-1$)
  AB-t(p, (624, 650), $O$)
  AB-curve(p, y => m(y * y / 4 - 1, y), -4.8, 4.6)
