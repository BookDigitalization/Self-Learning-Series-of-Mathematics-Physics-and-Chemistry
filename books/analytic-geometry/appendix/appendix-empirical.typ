    cells += side(lg, i) + ([], []) + side(rg, i)
  }
  cells += (lg.total.at(0), [#h(0.28em)#lg.total.at(1)], lg.at("tag", default: [])) + ([], []) + (rg.total.at(0), [#h(0.28em)#rg.total.at(1)], rg.at("tag", default: []))
