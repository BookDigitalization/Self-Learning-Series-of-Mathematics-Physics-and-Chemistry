//   每组：(rows: ((左, 右), …), total: (左, 右), tag: [(1)])；行数少的一组向下对齐。
#let Z-sum(lg, rg) = {
  let n = calc.max(lg.rows.len(), rg.rows.len())
  let side(g, i) = {
