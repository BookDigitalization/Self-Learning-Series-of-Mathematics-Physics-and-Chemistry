// AA 段：习题答案（前半，原书 p.478–490）：第一章到第三章的习题 3·11~3·12 为止（该组从 p.489 末跨到 p.490，录完）；
// p.490 的“复习题三”起见 answers-b.typ。
// 编译测试：solo-compile 不带正文，answers() 查不到习题标签会报错，故用 build/solo-AA/main.typ（include 第 1–7 章全部章文件，再 back-matter + 本文件）。
// 插图（不编号）：习题 1·6 第 8 题、习题 2·4 第 1–3 题、复习题二第 14 题，见 figures/AA-figs.typ。
#import "/common/series.typ": *
#import "/books/analytic-geometry/figures/AA-figs.typ": *

// 原书按章分组：“习题 x·y”后列出有答案的题号；复习题的答案单列（无习题标签，用小标题）。
// 原书只列有答案的题，题号不连续，照录。题号后的“.”不是句末标点，不改；各条末尾的“．”改作“。”。
// 答案区的组标题与正文习题标签一致（1·1~1·5、1·7~1·8、2·1~2·2、3·1~3·2 等原书都印作“习题 x·y～x·z”）。
// 习题 2·4 第 1 题的答案只有图（原书不印“1.”），照录。
// 用词按 TERMINOLOGY：tg→tan、arc tg/arc cos/arc sin→arctan/arccos/arcsin、“不适合方程”→“不满足方程”。

#set footnote(numbering: "①")
#let q(n) = h(0.8em) + [#n.] + sym.wj + h(0.2em) + sym.wj
// 答案里有不少分式，行距放宽，免得上下行的分式互相压住
#set par(leading: 0.9em, justify: false, hanging-indent: 1.2em)
// 章、复习题的小标题（不叫 sec，免得遮住公式里的 sec）
#let AA-head(title) = {
  set par(first-line-indent: 0em)
  block(above: 1.4em, below: 0.6em, sticky: true,
    width: 100%, align(center, text(font: fonts.hei, weight: "bold", size: 1.05em)[#title]))
}
// 不编号的图，可多幅并排，整组居中
#let AA-pfig(..items) = block(width: 100%, breakable: false, above: 1em, below: 1em, align(center, {
  set par(hanging-indent: 0em)
  grid(
  columns: items.pos().len(), column-gutter: 1.6em, align: center + bottom,
  ..items.pos().map(((img, cap)) => stack(spacing: 0.6em, img, text(font: fonts.kai, size: 9pt, cap))),
)}))
// 图旁的说明文字（第 1(10)、1(11)、1(12) 题）
#let AA-side(body) = align(left, text(size: 9pt, par(leading: 0.6em, hanging-indent: 0em, body)))
// 方程组：分式按 display 大小排
#let AAcases(..rows) = math.cases(..rows.pos().map(r => math.display(r)))
// 复习题答案（不在 answers() 里）：段首不缩进
#let AA-review(body) = { set par(first-line-indent: 0em); body }
// 图题里的圈码：楷体的圈码会压住前面的括号，改用宋体并在前面留一点空
#let AA-cap(n) = {
  show regex("[①②③]"): it => h(0.15em) + box(text(font: fonts.song, it))
  [（习题 2·4 第 #n 题）]
}

// p.478
// 原书标题带脚注①。脚注不能直接写进标题（会进目录和书签），用只作用于本文件标题排版的 show 规则加上
#show heading.where(level: 1): it => {
  show "习题答案": s => s + footnote[习题答案虽经编者再次校核，但仍恐有错误，欢迎指正。]
  it
}
= 习题答案

