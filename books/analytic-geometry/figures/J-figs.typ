// 解析几何 段 J：图 3·24–3·34 及习题 3·7~3·8 第 10 题图、习题 3·9~3·10 第 2 题图（原书 p.154–176）。
// 读坐标时的页面渲染 200 dpi（页宽约 1031 像素）；k = 0.0152 cm/像素。
// 线、点位置依原图坐标描，原图手绘的小偏差不照描；图中字母、方程均为真文字。
#import "/common/geo.typ": *
#let k = 0.0152cm

// 带箭头的坐标轴
#let J-ax(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: lw, mark: arw)
}
// 细线（垂线、角平分线、距离线）
#let J-th(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: lt)
}
// 虚线（细）
#let J-dh(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: (paint: black, thickness: 0.5pt, dash: "dashed"))
}
// 粗线（直线、三角形的边）
#let J-ln(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: 1.1pt)
}
// 文字标注（居中）
#let J-t(p, pt, body) = {
  import cetz.draw: *
  content(p(..pt), tt(body))
}
// 旋转的文字（沿直线），ang 为数学角（逆时针为正）
#let J-rt(p, pt, body, ang) = {
  import cetz.draw: *
  content(p(..pt), tsm(body), angle: ang)
}
// 点
#let J-d(p, c, r: 2.6) = pdot(p, c, r: r)
// 轴上刻度（沿 x 轴、y 轴等距放小短线）
#let J-xt(p, oy, xs) = {
  import cetz.draw: *
  for x in xs { line(p(x, oy), p(x, oy - 4), stroke: lt) }
}
#let J-yt(p, ox, ys) = {
  import cetz.draw: *
  for y in ys { line(p(ox, y), p(ox + 4, y), stroke: lt) }
}

