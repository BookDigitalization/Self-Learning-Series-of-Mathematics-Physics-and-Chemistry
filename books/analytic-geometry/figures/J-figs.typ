// ───────── 交叉乘法表（p.168 公式 (2) 的记忆表，及例题、习题提示里的小表）─────────
// 左上 tl、右上 tr、左下 bl、右下 br；左右各一条向下箭头，两条对角线（主对角线、副对角线的箭头指向 br、tr）。
#let J-cross(tl, tr, bl, br, width: 5.4em, big: false) = box(baseline: 40%, px-canvas(120, 80, origin: (0, 0), width: width, (p, u) => {
  import cetz.draw: *
  let tx(pt, body) = content(p(..pt), if big { text(size: 10.5pt, body) } else { tt(body) })
  tx((12, 10), tl)
  tx((108, 10), tr)
  tx((12, 70), bl)
  tx((108, 70), br)
