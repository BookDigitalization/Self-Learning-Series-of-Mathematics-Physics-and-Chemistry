// 图 1·46（p.50）：单位长约 28 像素，原点 (509, 1205)
#let fig-D-1-46(width: 400 * k) = px-canvas(400, 480, origin: (310, 950), width: width, (p, u) => {
  import cetz.draw: *
  let u1 = 28
  let q = (x, y) => (509 + u1 * x, 1205 - u1 * y)
  seg(p, (325, 1205), (680, 1205), mark: arw)
  seg(p, (509, 1417), (509, 990), mark: arw)
  for i in range(-4, 4) {
    if i != 0 { seg(p, (509 + u1 * i, 1201), (509 + u1 * i, 1209), stroke: lt) }
  }
  for j in range(-7, 7) {
    if j != 0 { seg(p, (505, 1205 - u1 * j), (513, 1205 - u1 * j), stroke: lt) }
  }
  seg(p, q(-4, -6), q(2, 6))
  pdot(p, q(-4, -6))
  pdot(p, q(-2, -2))
  pdot(p, q(-1, 0))
  pdot(p, q(2, 6))
  lbl(p, (598, 1020), $P_2(2, 6)$, dir: "c", d: 0)
  lbl(p, (443, 1180), $P(-1, 0)$, dir: "c", d: 0)
  lbl(p, (405, 1252), $P_1(-2, -2)$, dir: "c", d: 0)
  lbl(p, (445, 1390), $Q(-4, -6)$, dir: "c", d: 0)
  lbl(p, (497, 1218), $O$, dir: "c", d: 0)
  lbl(p, (684, 1198), $x$, dir: "c", d: 0)
  lbl(p, (511, 975), $y$, dir: "c", d: 0)
})

