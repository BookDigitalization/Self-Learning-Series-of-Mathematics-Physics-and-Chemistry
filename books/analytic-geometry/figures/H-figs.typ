// 解析几何 段 H：图 3·1–图 3·12（原书 p.116–132，§3·1–§3·4）及 p.121 表里的六幅小图。
// 读坐标时的页面渲染 200 dpi（页宽约 1031 像素）；k = 0.0152 cm/像素。
// 原图手绘，位置、刻度、标注依扫描量取；直线按扫描端点描，不另作校正。
#import "/common/geo.typ": *
#let k = 0.0152cm

// 带箭头的轴线：从 a 到 b，箭头在 b 端
#let H-ax(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: lw, mark: arw)
}
// 文字标注（页面坐标，居中）
#let H-t(p, pt, body) = lbl(p, pt, body, dir: "c", d: 0)
// 点
#let H-d(p, c, r: 3) = pdot(p, c, r: r)
// 转了角度的文字（角度为数学角）
#let H-rot(p, pt, body, ang) = {
  import cetz.draw: *
  content(p(..pt), angle: ang, tt(body))
}
// 水平刻度 / 竖直刻度短线
#let H-tkx(p, x, y, h: 4) = {
  import cetz.draw: *
  line(p(x, y - h), p(x, y + h), stroke: lt)
}
#let H-tky(p, x, y, h: 4) = {
  import cetz.draw: *
  line(p(x - h, y), p(x + h, y), stroke: lt)
}
// 花括号：a、b 为两端，n 为指向尖端的单位向量（页面坐标），r 为圆角
#let H-brace(p, a, b, n, r: 4) = {
  import cetz.draw: *
  let dx = b.at(0) - a.at(0)
  let dy = b.at(1) - a.at(1)
  let l = calc.sqrt(dx * dx + dy * dy)
  let (ux, uy) = (dx / l, dy / l)
  let q(s, t) = p(a.at(0) + ux * s + n.at(0) * t, a.at(1) + uy * s + n.at(1) * t)
  let m = l / 2
  bezier(q(0, 0), q(r, r), q(0, r), stroke: lt)
  line(q(r, r), q(m - r, r), stroke: lt)
  bezier(q(m - r, r), q(m, 2 * r), q(m, r), stroke: lt)
  bezier(q(m, 2 * r), q(m + r, r), q(m, r), stroke: lt)
  line(q(m + r, r), q(l - r, r), stroke: lt)
  bezier(q(l - r, r), q(l, 0), q(l, r), stroke: lt)
}

