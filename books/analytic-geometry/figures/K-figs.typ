// 解析几何 段 K：图 3·35–图 3·42（原书 p.177–188，§3·11 直线系、§3·12 经过两直线交点的直线系）。
// 读坐标时的页面渲染 200 dpi（页宽约 1024 像素）；k = 0.0152 cm/像素。
// 原图为手绘，直线按原图端点和已知方程核对后描绘；轴上不影响内容的小刻度略去或只取几处。
#import "/common/geo.typ": *
#let k = 0.0152cm

// 带箭头的轴线
#let K-ax(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: lw, mark: arw)
}
// 小号文字（页面坐标，居中），可旋转
#let K-t(p, pt, body, ang: 0deg) = {
  import cetz.draw: *
  content(p(..pt), tsm(body), angle: ang)
}
// 线段（页面坐标）
#let K-ln(p, a, b, w: lw) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: w)
}
// 刻度短线
#let K-tk(p, a, b) = {
  import cetz.draw: *
  line(p(..a), p(..b), stroke: lt)
}

// ───────── 图 3·35（p.177）：到原点距离等于 3 的直线 l₁、l₂、l₃（辐角 30°、45°、60°） ─────────
#let fig-K-3-35(width: 320 * k) = px-canvas(320, 330, origin: (600, 970), width: width, (p, u) => {
  import cetz.draw: *
  let (ox, oy, r) = (686.4, 1179.5, 85)
  circ(p, (ox, oy), r)
  // 三条切线：辐角 θ 的切点 T，切线方向与半径垂直
  for (th, a, b) in ((30, 115, 80), (45, 100, 105), (60, 110, 110)) {
    let c = calc.cos(th * 1deg)
    let s = calc.sin(th * 1deg)
    let t = (ox + r * c, oy - r * s)
    K-ln(p, (t.at(0) - s * a, t.at(1) - c * a), (t.at(0) + s * b, t.at(1) + c * b))
    K-ln(p, (ox, oy), t, w: 0.45pt)
  }
  // 坐标轴
  K-ax(p, (600, oy), (891, oy))
  K-ax(p, (ox, 1295), (ox, 997))
  K-t(p, (907, 1178), $x$)
  K-t(p, (688, 983), $y$)
  K-t(p, (676, 1193), $O$)
  // 角弧
  for (th, rr) in ((30, 22), (45, 38), (60, 56)) {
    anglearc(p, (ox, oy), (ox + 10, oy), (ox + 10 * calc.cos(th * 1deg), oy - 10 * calc.sin(th * 1deg)), rr)
  }
  K-t(p, (725, 1191), $30°$)
  K-t(p, (730, 1168), $45°$)
  K-t(p, (746, 1150), $60°$)
  K-t(p, (693, 1034), $l_1$)
  K-t(p, (668, 1047), $l_2$)
  K-t(p, (644, 1060), $l_3$)
})

// ───────── 图 3·36（p.178）：y = kx + 3 的直线系（共点 (0,3)） ─────────
#let fig-K-3-36(width: 440 * k) = px-canvas(440, 410, origin: (320, 925), width: width, (p, u) => {
  import cetz.draw: *
  let (ox, oy, s) = (503, 1233.5, 31.7)
  let c = (ox, oy - 3 * s)
  // 各直线的外端点（页面坐标，取自原图）
  let ends = (
    (552.7, 999.3), (566.7, 1007.3), (606, 1036), (626.7, 1058.3), (634, 1074),
    (459.4, 998), (437.5, 1007.5), (402, 1033), (383, 1064), (373, 1073),
    (378, 1203), (383, 1217), (398, 1252), (439, 1270), (455, 1278),
    (631, 1201), (623, 1223), (594, 1245), (566, 1269), (546.7, 1278),
  )
  for e in ends { K-ln(p, c, e) }
  K-ln(p, (357, c.at(1)), (631, c.at(1)))
  K-ax(p, (341, oy), (722, oy))
  K-ax(p, (ox, 1330), (ox, 957))
  for t in (-3, -2, -1, 1, 2, 3, 4) { K-tk(p, (ox, oy - t * s), (ox + 3, oy - t * s)) }
  for t in (-5, -4, -3, -2, -1, 1, 2, 3, 4, 5, 6) { K-tk(p, (ox + t * s, oy), (ox + t * s, oy - 3)) }
  K-t(p, (744, 1238), $x$)
  K-t(p, (507, 931), $y$)
  K-t(p, (491, 1247), $O$)
  K-t(p, (587, 986), $y = 3 x + 3$)
  K-t(p, (614, 1011), $y = 2 x + 3$)
  K-t(p, (648, 1033), $y = x + 3$)
  K-t(p, (678, 1073), $y = x / 2 + 3$)
  K-t(p, (660, 1139), $y = 3 .$)
  K-t(p, (684, 1206), $y = - x / 2 + 3$)
  K-t(p, (653, 1250), $y = - x + 3$)
  K-t(p, (594, 1291), $y = -3 x + 3$)
  K-t(p, (384, 1005), $y = -2 x + 3$)
  K-t(p, (322, 1055), $y = - 2 / 3 x + 3$)
  K-t(p, (331, 1222), $y = 2 / 3 x + 3$)
})

// ───────── 图 3·37（p.179）：y = x/2 + b 的平行直线系 ─────────
// 取自原图（页面 200 dpi）：先在放大 2.4 倍、原点 (400, 680) 的截图上读端点，再换算。
#let fig-K-3-37(width: 430 * k) = px-canvas(430, 500, origin: (355, 640), width: width, (p, u) => {
  import cetz.draw: *
  let g = (x, y) => (400 + x / 2.4, 680 + y / 2.4)
  // (左端 y, 右端 x)，左端 x 统一取 20，斜率约 0.5（截图坐标）
  let ls = ((218, 285), (270, 365), (352, 413), (415, 473), (487, 525), (548, 550), (615, 590),
    (685, 612), (755, 625), (825, 612), (888, 560), (955, 630), (1015, 590))
  for (ly, rx) in ls {
    K-ln(p, g(20, ly), g(rx, ly - 0.5 * (rx - 20)))
  }
  // 轴
  K-ax(p, (410, 908), (746, 906))
  K-ax(p, (468.5, 1130), (468.5, 682))
  K-t(p, (760, 906), $x$)
  K-t(p, (466, 651), $y$)
  K-t(p, (478, 919), $O$)
  // 右侧标注
  K-t(p, (562, 701), $y = x / 2 + 6$)
  K-t(p, (622, 730), $y = x / 2 + 4$)
  K-t(p, (660, 768), $y = x / 2 + 2$)
  K-t(p, (673, 812), $y = x / 2$)
  K-t(p, (707, 857), $y = x / 2 - 2$)
  K-t(p, (678, 926), $y = x / 2 - 4$)
  K-t(p, (686, 977), $y = x / 2 - 6$)
  // 左侧标注
  K-t(p, (367, 798), $y = x / 2 + 5$)
  K-t(p, (365, 854), $y = x / 2 + 3$)
  K-t(p, (362, 914), $y = x / 2 + 1$)
  K-t(p, (367, 965), $y = x / 2 - 1$)
  K-t(p, (365, 1021), $y = x / 2 - 3$)
  K-t(p, (365, 1077), $y = x / 2 - 5$)
})

