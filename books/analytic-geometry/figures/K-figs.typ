// ───────── 图 3·39（p.181）：3x+4y−7=0、3x+4y−24=0 与两轴围成的三角形（阴影） ─────────
#let fig-K-3-39(width: 420 * k) = px-canvas(420, 360, origin: (495, 965), width: width, (p, u) => {
  import cetz.draw: *
  let (ox, oy, s) = (581, 1217, 27.6)
  let hyp = x => 1051.4 + 0.75 * (x - ox)
  // 阴影线（斜线 2x + y = c，在三角形 O、(8,0)、(0,6) 内）
  for i in range(0, 62) {
    let cv = 2215 + 10 * i
    let xlo = calc.max(ox, (cv - oy) / 2)
    let xhi = (cv - 1051.4 + 0.75 * ox) / 2.75
    if xlo < xhi - 0.5 {
      K-ln(p, (xlo, cv - 2 * xlo), (xhi, cv - 2 * xhi), w: 0.4pt)
    }
  }
  K-ln(p, (538, hyp(538)), (851, hyp(851)))
  K-ln(p, (534, 1168.7 + 0.75 * (534 - ox)), (712, 1168.7 + 0.75 * (712 - ox)))
  K-ax(p, (500, oy), (900, 1224))
  K-ax(p, (ox, 1262), (ox, 982))
  K-t(p, (906, 1228), $x$)
  K-t(p, (586, 971), $y$)
  K-t(p, (565, 1229), $O$)
  K-t(p, (571, 1188), $1$)
  K-t(p, (607, 1229), $1$)
  K-t(p, (709, 1127), $3 x + 4 y - 24 = 0$, ang: -37deg)
  K-t(p, (687, 1270), $3 x + 4 y - 7 = 0$, ang: -37deg)
})

